# Live Commerce API — environment
PORT=5000
SITE_NAME=Store
CURRENCY=PKR
DELIVERY_FEE=150
FREE_DELIVERY_ABOVE=2000
WHATSAPP_NUMBER=
ADMIN_TOKEN=change-me-before-going-live
COD_ENABLED=true

# Public base URL of the storefront (used for Stripe/PayPal redirects)
APP_BASE_URL=http://localhost:5173

# Stripe (card payments for US/EU/global) — enable by setting the secret key.
# Publishable key is returned to the frontend for display only.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# PayPal (REST v2, captures without SDK) — enable by setting both keys.
# PAYPAL_MODE=sandbox uses the sandbox endpoint (live is the default).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=live