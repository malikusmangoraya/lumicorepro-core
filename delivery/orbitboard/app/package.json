{
  "name": "orbitboard",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.js",
    "build": "vite build --config vite.config.js && node scripts/copy-404.mjs",
    "preview": "vite preview --config vite.config.js",
    "test": "vitest run --config vitest.config.js",
    "test:e2e": "playwright test --config playwright.config.js",
    "test:e2e:auth": "playwright test --config playwright.config.js e2e/auth.spec.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
