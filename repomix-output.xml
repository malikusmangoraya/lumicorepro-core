      <a href={href} className="inline-flex">
        <Button
          variant={variant}
          size={size}
          rightIcon={variant === 'primary' ? ArrowRight : undefined}
          {...rest}
        >
          {label}
        </Button>
      </a>
    );
  }

  return (
    <Button
      variant={variant}
      size={size}
      onClick={onClick}
      rightIcon={variant === 'primary' ? ArrowRight : undefined}
      {...rest}
    >
      {label}
