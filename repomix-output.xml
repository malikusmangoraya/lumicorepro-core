    def _build_lhrc(self, targets, spec):
        lh = targets["lighthouse"]
        return {
            "ci": {
                "collect": {
                    "numberOfRuns": 3,
                    "startServerCommand": "npm run preview",
                    "url": ["http://localhost:4173"],
