import React from 'react';
import { useCurrency } from '../hooks/useCurrency';

/**
 * PriceDisplay - Component to display prices in user's selected currency
 * 
 * @param {number} amount - Price in USD (base currency)
 * @param {string} currency - Override currency (default: user's selected currency)
 * @param {boolean} showCode - Show currency code (default: false)
 * @param {string} className - CSS class for styling
 * @param {boolean} showOriginal - Show original USD price (default: false)
 * 
 * @example
 * <PriceDisplay amount={99.99} />
 * <PriceDisplay amount={99.99} currency="PKR" showCode />
 * <PriceDisplay amount={99.99} showOriginal className="text-2xl font-bold" />
 */
export const PriceDisplay = ({
  amount,
  currency,
  showCode = false,
  className = '',
  showOriginal = false,
}) => {
  const { formatPrice } = useCurrency();

  if (amount === undefined || amount === null) {
    return <span className={className}>—</span>;
  }

  const formatted = formatPrice(amount, currency, showCode);

  return (
    <span className={className} title={`${amount} USD`}>
      {formatted}
      {showOriginal && amount !== undefined && (
        <span className="text-sm text-gray-500 ml-2">(${amount.toFixed(2)} USD)</span>
      )}
    </span>
  );
};
</file>

