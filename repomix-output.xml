│   └── notification.controller.js
├── services/         # Business logic
│   ├── email.service.js
│   ├── payment.service.js
│   ├── upload.service.js
│   ├── search.service.js
│   └── analytics.service.js
├── middleware/       # Custom middleware
│   ├── errorHandler.js
