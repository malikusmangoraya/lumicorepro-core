import React from 'react';
import * as LucideIcons from 'lucide-react';

const VARIANTS = {
  cyan: 'text-cyan-400',
  indigo: 'text-indigo-400',
  emerald: 'text-emerald-400',
  amber: 'text-amber-400',
  rose: 'text-rose-400',
  slate: 'text-slate-400',
  white: 'text-white',
};

/**
 * Production-grade Icon component with Lucide integration, variants, labels, and accessibility.
 * Enterprise standard: icons always paired with visible labels when used in navigation.
 */
export default function Icon({
  name = 'Sparkles',
  size = 20,
  variant = 'cyan',
  label = null,
  showLabel = false,
  glow = false,
  badge = null,
  className = '',
  onClick,
  ariaHidden = false,
}) {
  const IconComponent = LucideIcons[name] || LucideIcons.Sparkles;
  const colorClass = VARIANTS[variant] || VARIANTS.cyan;
  const glowClass = glow ? 'drop-shadow-[0_0_8px_rgba(6,182,212,0.6)]' : '';
  const interactive = typeof onClick === 'function';

  const iconEl = (
    <IconComponent
      size={size}
      className={`${colorClass} ${glowClass} transform-gpu shrink-0`}
      aria-hidden={ariaHidden || !!label}
    />
  );

  const wrapped = (
    <span
      role={interactive ? 'button' : undefined}
      tabIndex={interactive ? 0 : undefined}
      onClick={onClick}
      onKeyDown={interactive ? (e) => e.key === 'Enter' && onClick?.(e) : undefined}
      className={`relative inline-flex items-center gap-2 transition-transform duration-200 ${interactive ? 'cursor-pointer hover:scale-105' : ''} ${className}`}
      aria-label={label || name}
    >
      {iconEl}
      {(showLabel && label) && (
        <span className="text-sm font-medium text-slate-200">{label}</span>
      )}
      {badge != null && (
        <span className="absolute -top-1.5 -right-2 bg-rose-500 text-white text-[9px] font-extrabold px-1.5 py-0.5 rounded-full shadow-md">
          {badge}
        </span>
      )}
    </span>
  );

  return wrapped;
}

export { VARIANTS as ICON_VARIANTS };
