            <div className={`absolute top-1/2 -translate-y-1/2 w-2 h-2 bg-white dark:bg-gray-800 transform rotate-45 ${
              position.includes('right') ? '-right-1' : '-left-1'
            }`} />
          </motion.div>
        )}
      </AnimatePresence>

      {/* WhatsApp Button */}
      <motion.button
        initial={{ scale: 0, opacity: 0 }}
        animate={{ scale: 1, opacity: 1 }}
        transition={{ 
          type: 'spring', 
          stiffness: 260, 
          damping: 20,
          delay: 0.5 
        }}
        whileHover={{ 
          scale: 1.1,
          transition: { duration: 0.2 }
