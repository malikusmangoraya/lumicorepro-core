<file path="src/components/ecommerce/AddToCart.jsx">
import React, { useState } from 'react';
import { ShoppingCart, Check } from 'lucide-react';
import Button from '../ui/Button';

const AddToCart = ({
  onAdd,
  product,
  quantity = 1,
  disabled = false,
  variant = 'primary',
  size = 'md',
  className = '',
  ...props
}) => {
  const [added, setAdded] = useState(false);

  const handleClick = () => {
    onAdd?.(product, quantity);
    setAdded(true);
    setTimeout(() => setAdded(false), 2000);
  };

  return (
    <Button
      variant={added ? 'success' : variant}
      size={size}
      disabled={disabled}
      onClick={handleClick}
      leftIcon={added ? Check : ShoppingCart}
      className={className}
      {...props}
    >
      {added ? 'Added!' : 'Add to Cart'}
    </Button>
  );
};

export default AddToCart;
</file>

<file path="src/components/ecommerce/AddToWishlist.jsx">
import React, { useState } from 'react';
import { Heart } from 'lucide-react';
import Button from '../ui/Button';

const AddToWishlist = ({
  onToggle,
  product,
  active = false,
  disabled = false,
  size = 'md',
  showLabel = false,
  className = '',
  ...props
}) => {
  const [isActive, setIsActive] = useState(active);

  const handleClick = () => {
    const newState = !isActive;
    setIsActive(newState);
    onToggle?.(product, newState);
  };

  return (
    <Button
      variant={isActive ? 'danger' : 'outline'}
      size={size}
      disabled={disabled}
      onClick={handleClick}
      leftIcon={Heart}
      className={className}
      aria-pressed={isActive}
      {...props}
    >
      {showLabel && (isActive ? 'In Wishlist' : 'Add to Wishlist')}
    </Button>
  );
};

export default AddToWishlist;
