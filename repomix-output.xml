import { useState } from 'react';
import { Palette, Layout, Code2, Film, Users, Award, ArrowRight } from 'lucide-react';
import TemplateShell from '../../_shared/TemplateShell';
import { Card, Badge, Button } from '@/components/ui';
import { cn } from '@/utils';
import { img } from '@/utils/images';
import { projects, categories, services, team, stats } from './data/mockData';

const serviceIcons = { palette: Palette, layout: Layout, 'code-2': Code2, film: Film };
const catColor = {
  'UI/UX':      'bg-violet-500/15 text-violet-400',
  'Branding':   'bg-pink-500/15 text-pink-400',
  '3D / Motion':'bg-cyan-500/15 text-cyan-400',
  'Web Dev':    'bg-emerald-500/15 text-emerald-400',
};
const PROJ_IMGS = [
  img.creative.project1, img.creative.project2, img.creative.project3,
  img.creative.project4, img.creative.project5, img.creative.project6,
];
const TEAM_IMGS = [img.creative.team1, img.creative.team2, img.creative.team3, img.creative.team4];

export default function CreativeStudio() {
  const [activeCategory, setActiveCategory] = useState('All');
  const filtered = activeCategory === 'All' ? projects : projects.filter(p => p.category === activeCategory);

  return (
    <TemplateShell title="Creative Studio" description="Portfolio, services, team, and brand showcase." category="Creative"
      actions={<Button size="sm"><ArrowRight className="h-4 w-4 mr-1" />Start a Project</Button>}
    >
      {/* Hero with real image */}
      <div className="relative overflow-hidden rounded-2xl border border-border h-64 mb-6">
        <img src={img.creative.hero} alt="Creative Studio" className="absolute inset-0 w-full h-full object-cover" />
        <div className="absolute inset-0 bg-gradient-to-t from-black/85 via-black/40 to-transparent" />
        <div className="absolute inset-0 flex flex-col items-center justify-end pb-8 text-center">
          <Badge variant="secondary" className="mb-2">🎨 Award-Winning Studio · Since 2018</Badge>
          <h2 className="font-display text-4xl font-bold text-white">We Create <span className="bg-gradient-to-r from-pink-400 via-violet-400 to-cyan-400 bg-clip-text text-transparent">Digital Magic</span></h2>
          <p className="mt-2 text-white/75 text-sm max-w-xl">Brand identities, UI/UX, web development & motion design that makes your brand unforgettable.</p>
          <div className="mt-5 flex gap-3">
            <Button size="sm" className="bg-white text-foreground hover:bg-white/90">View Our Work</Button>
            <Button size="sm" variant="outline" className="border-white/40 text-white hover:bg-white/10">Get a Quote</Button>
          </div>
        </div>
      </div>

      {/* Stats */}
