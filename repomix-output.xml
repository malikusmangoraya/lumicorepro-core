<file path="src/components/business/TestimonialSlider.jsx">
import React, { useState, useEffect, useCallback } from 'react';
import { ChevronLeft, ChevronRight } from 'lucide-react';
import { cn } from '../../utils';
import Testimonial from './Testimonial';
import IconButton from '../ui/IconButton';

const TestimonialSlider = ({
  items = [],
  autoPlay = false,
  interval = 5000,
  onChange,
  className = '',
  ...props
}) => {
  const [index, setIndex] = useState(0);

  const goTo = useCallback(
    (next) => {
      const safe = ((next % items.length) + items.length) % items.length;
      setIndex(safe);
      onChange?.(safe, items[safe]);
    },
    [items, onChange]
  );

  useEffect(() => {
    if (!autoPlay || items.length < 2) return undefined;
    const id = setInterval(() => goTo(index + 1), interval);
    return () => clearInterval(id);
  }, [autoPlay, interval, index, goTo, items.length]);

  if (!items.length) return null;

  const current = items[index];

  return (
    <div className={cn('relative', className)} {...props}>
      <Testimonial key={index} animate="fade" {...current} />
      {items.length > 1 && (
        <div className="mt-6 flex items-center justify-between">
          <div className="flex gap-1.5">
            {items.map((_, i) => (
              <button
                key={i}
                type="button"
                aria-label={`Go to testimonial ${i + 1}`}
                onClick={() => goTo(i)}
                className={cn(
                  'h-1.5 rounded-full transition-all duration-200',
                  i === index ? 'w-6 bg-primary' : 'w-1.5 bg-muted-foreground/30'
                )}
              />
            ))}
          </div>
          <div className="flex gap-2">
            <IconButton
              icon={ChevronLeft}
              label="Previous testimonial"
              onClick={() => goTo(index - 1)}
              variant="outline"
              size="sm"
            />
            <IconButton
              icon={ChevronRight}
              label="Next testimonial"
              onClick={() => goTo(index + 1)}
              variant="outline"
              size="sm"
            />
          </div>
        </div>
      )}
    </div>
  );
};

export default TestimonialSlider;
</file>

