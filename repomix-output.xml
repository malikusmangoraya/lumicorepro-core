import React, { useState } from 'react';
import { ChevronDown, X } from 'lucide-react';

const Sidebar = ({
  items = [],
  activeItem,
  onItemClick,
  logo,
  header,
  footer,
  collapsed = false,
  collapsible = true,
  mobile = false,
  onClose,
  className = '',
  ...props
}) => {
  const [openGroups, setOpenGroups] = useState({});

  const toggleGroup = (label) => {
    setOpenGroups((prev) => ({ ...prev, [label]: !prev[label] }));
  };

  const renderItem = (item, depth = 0) => {
    if (item.children) {
      const isOpen = openGroups[item.label] || item.defaultOpen;
      return (
        <div key={item.label} className="mb-1">
          <button
            type="button"
            onClick={() => toggleGroup(item.label)}
            className={`flex w-full items-center justify-between rounded-lg px-3 py-2 text-sm font-medium transition-colors ${
              activeItem === item.label
                ? 'bg-primary/10 text-primary'
                : 'text-muted-foreground hover:text-foreground hover:bg-muted'
            }`}
            style={{ paddingLeft: `${depth * 16 + 12}px` }}
            aria-expanded={isOpen}
          >
            <span className="flex items-center gap-2">
              {item.icon && <item.icon className="h-4 w-4 shrink-0" aria-hidden="true" />}
              {!collapsed && <span>{item.label}</span>}
            </span>
            {!collapsed && (
              <ChevronDown
                className={`h-4 w-4 transition-transform ${isOpen ? 'rotate-180' : ''}`}
                aria-hidden="true"
              />
            )}
          </button>
          {isOpen && !collapsed && (
            <div className="mt-1 space-y-1">
              {item.children.map((child) => renderItem(child, depth + 1))}
            </div>
          )}
        </div>
      );
    }

    return (
      <button
        key={item.label}
        type="button"
        onClick={() => onItemClick?.(item)}
        className={`flex w-full items-center gap-2 rounded-lg px-3 py-2 text-sm font-medium transition-colors ${
          activeItem === item.label || activeItem === item.href
            ? 'bg-primary/10 text-primary'
            : 'text-muted-foreground hover:text-foreground hover:bg-muted'
        }`}
        style={{ paddingLeft: `${depth * 16 + 12}px` }}
        aria-current={activeItem === item.label ? 'page' : undefined}
      >
        {item.icon && <item.icon className="h-4 w-4 shrink-0" aria-hidden="true" />}
        {!collapsed && <span className="truncate">{item.label}</span>}
        {item.badge && !collapsed && (
          <span className="ml-auto rounded-full bg-primary/10 px-2 py-0.5 text-xs font-medium text-primary">
            {item.badge}
          </span>
        )}
      </button>
    );
  };

  const sidebarContent = (
    <div className="flex h-full flex-col">
      {(logo || header) && (
        <div className="flex items-center justify-between p-4 border-b border-border">
          <div className="flex items-center gap-2">
            {logo}
            {header && !collapsed && <span className="font-semibold">{header}</span>}
          </div>
          {mobile && onClose && (
            <button
              type="button"
              onClick={onClose}
              className="rounded-lg p-1.5 hover:bg-muted transition-colors"
              aria-label="Close sidebar"
            >
              <X className="h-4 w-4" />
            </button>
          )}
        </div>
      )}
      <nav className="flex-1 overflow-y-auto p-3 space-y-1" aria-label="Sidebar navigation">
        {items.map((item) => renderItem(item))}
      </nav>
      {footer && <div className="p-4 border-t border-border">{footer}</div>}
    </div>
  );

  if (mobile) {
    return (
      <div className="fixed inset-0 z-50 lg:hidden" {...props}>
        <div className="absolute inset-0 bg-black/50" onClick={onClose} aria-hidden="true" />
        <aside className={`absolute left-0 top-0 h-full w-72 bg-card border-r border-border shadow-lg ${className}`}>
          {sidebarContent}
        </aside>
      </div>
    );
  }

  return (
    <aside
      className={`h-full bg-card border-r border-border transition-all duration-300 ${
        collapsed ? 'w-16' : 'w-64'
      } ${className}`}
      {...props}
    >
      {sidebarContent}
    </aside>
  );
};

export default Sidebar;
</file>

<file path="src/components/navigation/Stepper.jsx">
import React from 'react';
import { Check } from 'lucide-react';

const Stepper = ({
  steps = [],
  currentStep = 0,
  onStepClick,
  orientation = 'horizontal',
  variant = 'default',
  className = '',
  ...props
}) => {
  const isHorizontal = orientation === 'horizontal';

  const variants = {
    default: {
      circle: 'border-2',
      active: 'border-primary text-primary',
      completed: 'bg-primary border-primary text-primary-foreground',
      upcoming: 'border-border text-muted-foreground',
    },
    numbered: {
      circle: 'border-2',
      active: 'border-primary bg-primary/10 text-primary',
      completed: 'bg-primary border-primary text-primary-foreground',
      upcoming: 'border-border text-muted-foreground',
    },
    dot: {
      circle: 'border-2',
      active: 'border-primary bg-primary/10 text-primary',
      completed: 'bg-primary border-primary text-primary-foreground',
      upcoming: 'border-border text-muted-foreground',
    },
  };

  const config = variants[variant];

  return (
    <div
      className={`${isHorizontal ? 'flex items-center' : 'flex flex-col gap-4'} ${className}`}
      role="list"
      aria-label="Progress steps"
      {...props}
    >
      {steps.map((step, index) => {
        const isCompleted = index < currentStep;
        const isActive = index === currentStep;
        const isClickable = onStepClick && index <= currentStep;

        return (
          <React.Fragment key={step.label || index}>
            <div className={`flex items-center ${isHorizontal ? 'flex-col flex-1' : 'gap-3'}`}>
              <button
                type="button"
                role="listitem"
                disabled={!isClickable}
                onClick={() => isClickable && onStepClick(index)}
                className={`flex items-center gap-3 ${
                  isClickable ? 'cursor-pointer' : 'cursor-default'
                } focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded-lg`}
                aria-current={isActive ? 'step' : undefined}
              >
                <span
                  className={`flex h-9 w-9 items-center justify-center rounded-full text-sm font-medium transition-colors ${
                    config.circle
                  } ${
                    isCompleted
                      ? config.completed
                      : isActive
                      ? config.active
                      : config.upcoming
                  }`}
                >
                  {isCompleted ? (
                    <Check className="h-4 w-4" aria-hidden="true" />
                  ) : (
                    index + 1
                  )}
                </span>
                <span className="text-sm">
                  <span className={`font-medium ${isActive ? 'text-foreground' : 'text-muted-foreground'}`}>
                    {step.label}
                  </span>
                  {step.description && (
                    <span className="block text-xs text-muted-foreground">{step.description}</span>
                  )}
                </span>
              </button>
            </div>
            {isHorizontal && index < steps.length - 1 && (
              <div
                className={`flex-1 h-0.5 mx-2 rounded-full transition-colors ${
                  index < currentStep ? 'bg-primary' : 'bg-muted'
                }`}
                aria-hidden="true"
              />
            )}
          </React.Fragment>
        );
      })}
    </div>
  );
};

export default Stepper;
</file>

<file path="src/components/navigation/TabNavigation.jsx">
import React, { useState } from 'react';

const TabNavigation = ({
  tabs = [],
  activeTab,
  onChange,
  variant = 'underline',
  className = '',
  ...props
}) => {
  const [internalTab, setInternalTab] = useState(0);
  const currentTab = activeTab ?? internalTab;

  const handleChange = (index) => {
    if (onChange) {
      onChange(index);
    } else {
      setInternalTab(index);
    }
  };

  const variants = {
    underline: 'border-b border-border',
    pill: 'bg-muted rounded-lg p-1',
    boxed: 'gap-1',
  };

  const tabVariants = {
    underline: `pb-3 border-b-2 border-transparent ${
      'data-active:border-primary data-active:text-primary'
    }`,
    pill: `px-4 py-2 rounded-md ${
      'data-active:bg-background data-active:shadow-sm data-active:text-primary'
    }`,
    boxed: `px-4 py-2.5 rounded-lg border ${
      'data-active:bg-primary data-active:text-primary-foreground data-active:border-primary'
    } border-transparent`,
  };

  return (
    <div className={className} {...props}>
      <div role="tablist" className={`flex items-center ${variants[variant]}`} aria-label="Tab navigation">
        {tabs.map((tab, index) => (
          <button
            key={tab.id || index}
            type="button"
            role="tab"
            aria-selected={currentTab === index}
            data-active={currentTab === index}
            onClick={() => handleChange(index)}
            className={`text-sm font-medium text-muted-foreground transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded-md ${
              tabVariants[variant]
            }`}
          >
            {tab.icon && <tab.icon className="h-4 w-4 mr-2 inline-block" aria-hidden="true" />}
            {tab.label}
          </button>
        ))}
      </div>
      <div role="tabpanel" className="pt-4">
        {tabs[currentTab]?.content}
      </div>
    </div>
  );
};

export default TabNavigation;
</file>

<file path="src/components/navigation/TopMenu.jsx">
import React, { useState } from 'react';
import { ChevronDown } from 'lucide-react';

const TopMenu = ({
  items = [],
  activeItem,
  onItemClick,
  className = '',
  ...props
}) => {
  const [openMenu, setOpenMenu] = useState(null);

  const handleClick = (item) => {
    if (item.children) {
      setOpenMenu(openMenu === item.label ? null : item.label);
    } else {
      onItemClick?.(item);
      setOpenMenu(null);
    }
  };

  return (
    <nav className={`flex items-center gap-1 ${className}`} aria-label="Top menu" {...props}>
      {items.map((item) => {
        const isActive = activeItem === item.label || activeItem === item.href;
        const isOpen = openMenu === item.label;

        return (
          <div key={item.label} className="relative">
            <button
              type="button"
              onClick={() => handleClick(item)}
              className={`flex items-center gap-1.5 rounded-lg px-3 py-2 text-sm font-medium transition-colors ${
                isActive
                  ? 'bg-primary/10 text-primary'
                  : 'text-muted-foreground hover:text-foreground hover:bg-muted'
              }`}
              aria-expanded={isOpen}
              aria-haspopup={item.children ? 'menu' : undefined}
            >
              {item.icon && <item.icon className="h-4 w-4" aria-hidden="true" />}
              {item.label}
              {item.children && (
                <ChevronDown className={`h-3.5 w-3.5 transition-transform ${isOpen ? 'rotate-180' : ''}`} aria-hidden="true" />
              )}
            </button>

            {item.children && isOpen && (
              <div
                role="menu"
                className="absolute left-0 top-full z-50 mt-1 min-w-[12rem] rounded-xl border border-border bg-card shadow-lg p-1.5 animate-in fade-in zoom-in-95"
              >
                {item.children.map((child) => (
                  <button
                    key={child.label}
                    type="button"
                    role="menuitem"
                    onClick={() => {
                      onItemClick?.(child);
                      setOpenMenu(null);
                    }}
                    className="flex w-full items-center gap-2 rounded-lg px-3 py-2 text-sm text-foreground hover:bg-muted transition-colors"
                  >
                    {child.icon && <child.icon className="h-4 w-4" aria-hidden="true" />}
                    {child.label}
                  </button>
                ))}
              </div>
            )}
          </div>
        );
      })}
    </nav>
  );
};

export default TopMenu;
</file>

<file path="src/components/navigation/VerticalMenu.jsx">
import React, { useState } from 'react';
import { ChevronRight } from 'lucide-react';

const VerticalMenu = ({
  items = [],
  activeItem,
  onItemClick,
  className = '',
  ...props
}) => {
  const [openItems, setOpenItems] = useState({});

  const toggleItem = (label) => {
    setOpenItems((prev) => ({ ...prev, [label]: !prev[label] }));
  };

  const renderItems = (menuItems, depth = 0) => {
    return menuItems.map((item) => {
      const hasChildren = item.children && item.children.length > 0;
      const isOpen = openItems[item.label] || item.defaultOpen;
      const isActive = activeItem === item.label || activeItem === item.href;

      return (
        <div key={item.label} className="mb-0.5">
          <button
            type="button"
            onClick={() => {
              if (hasChildren) {
                toggleItem(item.label);
              } else {
                onItemClick?.(item);
              }
            }}
            className={`flex w-full items-center gap-2 rounded-lg px-3 py-2 text-sm font-medium transition-colors ${
              isActive
                ? 'bg-primary/10 text-primary'
                : 'text-muted-foreground hover:text-foreground hover:bg-muted'
            }`}
            style={{ paddingLeft: `${depth * 16 + 12}px` }}
            aria-expanded={hasChildren ? isOpen : undefined}
            aria-current={isActive ? 'page' : undefined}
          >
            {item.icon && <item.icon className="h-4 w-4 shrink-0" aria-hidden="true" />}
            <span className="flex-1 text-left truncate">{item.label}</span>
            {item.badge && (
              <span className="rounded-full bg-primary/10 px-2 py-0.5 text-xs font-medium text-primary">
                {item.badge}
              </span>
            )}
            {hasChildren && (
              <ChevronRight
                className={`h-4 w-4 shrink-0 transition-transform ${isOpen ? 'rotate-90' : ''}`}
                aria-hidden="true"
              />
            )}
          </button>
          {hasChildren && isOpen && (
            <div className="mt-0.5 space-y-0.5">
              {renderItems(item.children, depth + 1)}
            </div>
          )}
        </div>
      );
    });
  };

  return (
    <nav className={`space-y-0.5 ${className}`} aria-label="Vertical menu" {...props}>
      {renderItems(items)}
    </nav>
  );
};

export default VerticalMenu;
</file>

<file path="src/components/ui/Accordion.jsx">
import React, { useState } from 'react';
import { ChevronDown } from 'lucide-react';
import { cn, getAnimationClass } from '../../utils';

const Accordion = ({
  items = [],
  allowMultiple = false,
  defaultOpen = [],
  openItems: controlledOpen,
  onChange,
  onToggle,
  animate = 'none',
  className = '',
  itemClassName = '',
}) => {
  const [internalOpen, setInternalOpen] = useState(defaultOpen);
  const openItems = controlledOpen ?? internalOpen;
  const notify = onChange || onToggle;

  const toggleItem = (index) => {
    const next = (() => {
      if (allowMultiple) {
        return openItems.includes(index)
          ? openItems.filter((i) => i !== index)
          : [...openItems, index];
      }
      return openItems.includes(index) ? [] : [index];
    })();

    if (controlledOpen === undefined) setInternalOpen(next);
    notify?.(next, index);
  };

  return (
    <div className={cn('space-y-2', getAnimationClass(animate), className)}>
      {items.map((item, index) => {
        const isOpen = openItems.includes(index);
        return (
          <div
            key={item.id ?? index}
            className={cn(
              'rounded-xl border border-border bg-card overflow-hidden transition-shadow',
              isOpen && 'shadow-sm',
              itemClassName
            )}
          >
            <button
              type="button"
              className="flex w-full items-center justify-between px-4 py-3.5 text-left transition-colors hover:bg-muted/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
              onClick={() => toggleItem(index)}
              aria-expanded={isOpen}
              aria-controls={`accordion-content-${index}`}
              id={`accordion-trigger-${index}`}
            >
              <span className="text-sm font-medium">{item.title}</span>
              <ChevronDown
                className={cn(
                  'h-4 w-4 shrink-0 text-muted-foreground transition-transform duration-200',
                  isOpen && 'rotate-180'
                )}
                aria-hidden="true"
              />
            </button>
            <div
              id={`accordion-content-${index}`}
              role="region"
              aria-labelledby={`accordion-trigger-${index}`}
              className={cn(
                'grid transition-all duration-300 ease-out',
                isOpen ? 'grid-rows-[1fr] opacity-100' : 'grid-rows-[0fr] opacity-0'
              )}
            >
              <div className="overflow-hidden">
                <div className="px-4 pb-4 text-sm text-muted-foreground">{item.content}</div>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  );
};

export default Accordion;
</file>

