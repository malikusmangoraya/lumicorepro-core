  from { transform: perspective(600px) rotateY(0deg); }
  to { transform: perspective(600px) rotateY(360deg); }
}

@keyframes explode3d {
  0% { transform: perspective(800px) scale(1); opacity: 1; }
  50% { transform: perspective(800px) scale(1.15); opacity: 0.7; }
  100% { transform: perspective(800px) scale(1); opacity: 1; }
}

@keyframes parallaxLayer {
  0% { transform: translate3d(0, 0, 0) scale(1); }
  50% { transform: translate3d(-12px, 8px, 30px) scale(1.02); }
  100% { transform: translate3d(0, 0, 0) scale(1); }
}

@keyframes morphBlob3d {
  0%, 100% { border-radius: 60% 40% 30% 70%/60% 30% 70% 40%; transform: perspective(600px) rotate(0deg); }
  50% { border-radius: 30% 60% 70% 40%/50% 60% 30% 60%; transform: perspective(600px) rotate(180deg); }
}

/* 3D Fly-in from bottom-up */
@keyframes flyIn3d {
  0% { transform: perspective(800px) rotateX(30deg) translate3d(0,120px,-200px); opacity: 0; }
  100% { transform: perspective(800px) rotateX(0) translate3d(0,0,0); opacity: 1; }
}

.animate-spin-3d {
  will-change: transform;
  transform-style: preserve-3d;
  animation: spin3d 6s infinite linear;
}

.animate-explode-3d {
  will-change: transform, opacity;
  transform-style: preserve-3d;
  animation: explode3d 2s ease-in-out;
}

.animate-parallax-layer {
  will-change: transform;
  transform-style: preserve-3d;
  animation: parallaxLayer 7s infinite ease-in-out;
}

.animate-morph-blob-3d {
  will-change: border-radius, transform;
  transform-style: preserve-3d;
  animation: morphBlob3d 10s infinite ease-in-out;
}

.animate-fly-in-3d {
  will-change: transform, opacity;
  transform-style: preserve-3d;
  animation: flyIn3d 0.8s cubic-bezier(.22,1,.36,1) forwards;
}
</file>

