              <div className="mt-2 mb-4"><span className="font-display text-3xl font-bold">{plan.price}</span><span className="text-sm text-muted-foreground">{plan.period}</span></div>
              <ul className="space-y-2 mb-4">
                {plan.features.map((feat, j) => (
                  <li key={j} className="flex items-center gap-2 text-sm text-muted-foreground"><Check className="h-4 w-4 text-primary shrink-0" />{feat}</li>
                ))}
              </ul>
              <Button size="sm" variant={plan.highlighted ? 'default' : 'outline'} className="w-full">Choose {plan.name}</Button>
            </Card>
          ))}
        </div>
      </div>

      {/* Trainers with real photos */}
      <div>
        <h3 className="font-display text-lg font-bold mb-4">Expert Trainers</h3>
        <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
          {trainers.map((t, i) => (
            <Card key={i} animate="fade-up" animationDelay={i * 70} className="hover-lift text-center" padding="sm">
              <img src={TRAINER_IMGS[i % TRAINER_IMGS.length]} alt={t.name}
                className="mx-auto mb-3 h-16 w-16 rounded-2xl object-cover ring-2 ring-border" />
              <h4 className="font-semibold text-sm">{t.name}</h4>
              <p className="text-xs text-primary mt-0.5">{t.specialty}</p>
              <div className="flex justify-center gap-3 mt-2 text-xs text-muted-foreground">
                <span><Dumbbell className="h-3 w-3 inline mr-0.5" />{t.exp}</span>
                <span><Users className="h-3 w-3 inline mr-0.5" />{t.clients}</span>
              </div>
            </Card>
          ))}
        </div>
      </div>
    </TemplateShell>
  );
}
