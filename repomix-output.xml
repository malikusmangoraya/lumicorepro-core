<file path="src/templates/education/lms-template-01/src/components/Stats.jsx">
import React, { useState, useEffect, useRef } from 'react';
import { Users, Award, BookOpen, Globe } from 'lucide-react';

const stats = [
  { icon: Users, value: 50000, suffix: '+', label: 'Active Students' },
  { icon: BookOpen, value: 500, suffix: '+', label: 'Courses Available' },
  { icon: Award, value: 200, suffix: '+', label: 'Expert Instructors' },
  { icon: Globe, value: 150, suffix: '+', label: 'Countries Reached' },
];

const Stats = () => {
  const [counts, setCounts] = useState(stats.map(() => 0));
  const [visible, setVisible] = useState(false);
  const ref = useRef(null);

  useEffect(() => {
    const observer = new IntersectionObserver(
      ([entry]) => { if (entry.isIntersecting) setVisible(true); },
      { threshold: 0.3 }
    );
    if (ref.current) observer.observe(ref.current);
    return () => observer.disconnect();
  }, []);

  useEffect(() => {
    if (!visible) return;
    stats.forEach((s, i) => {
      let count = 0;
      const step = Math.ceil(s.value / 60);
      const timer = setInterval(() => {
        count += step;
        if (count >= s.value) { setCounts(prev => { const n = [...prev]; n[i] = s.value; return n; }); clearInterval(timer); }
        else { setCounts(prev => { const n = [...prev]; n[i] = count; return n; }); }
      }, 25);
    });
  }, [visible]);

  return (
    <section ref={ref} className="py-20 bg-gradient-to-r from-cyan-600 to-blue-600">
      <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid sm:grid-cols-2 lg:grid-cols-4 gap-8">
        {stats.map((s, i) => (
          <div key={i} className="text-center text-white">
            <div className="w-14 h-14 mx-auto mb-4 bg-white/20 rounded-2xl flex items-center justify-center">
              <s.icon size={28} />
            </div>
            <div className="text-4xl font-extrabold mb-1">{counts[i].toLocaleString()}{s.suffix}</div>
            <div className="text-sm text-blue-100">{s.label}</div>
          </div>
        ))}
      </div>
    </section>
  );
};

export default Stats;
</file>

