                            if ai_calls_count >= 3:
                                break
            phase_log["phase_6_code_generation"] = {"project_dir": project_dir, "ai_calls": ai_calls_count}
        except Exception:
            phase_failures.append("phase_6_code_generation")

        # ── Phase 7: Quality Verification ────────────────────────────────────
        try:
