<file path="src/components/editor/VisualPageEditor.jsx">
import React, { useState } from 'react';
import { Layout, Type, Palette, Monitor, Smartphone, Tablet, Eye, Download, Code, Layers, Plus, Trash2, Settings, Sparkles } from 'lucide-react';

export default function VisualPageEditor({ initialSections = [], onExportCode }) {
  const [viewport, setViewport] = useState('desktop'); // desktop, tablet, mobile
  const [activeTab, setActiveTab] = useState('sections'); // sections, styles, inspector
  const [sections, setSections] = useState(
    initialSections.length > 0 ? initialSections : [
      { id: 'hero-1', type: 'Hero', title: 'Next-Gen Electronics Store', subtitle: 'Experience peak performance and modern tech innovation.', ctaText: 'Shop Electronics', bgGradient: 'from-cyan-900/40 to-slate-900' },
      { id: 'products-1', type: 'ProductGrid', title: 'Trending Gadgets & Devices', columns: 4 },
      { id: 'features-1', type: 'ShippingInfo', title: 'Why Shop With Us', freeShipping: true, warrantyYears: 2 }
    ]
  );
  const [selectedSectionId, setSelectedSectionId] = useState('hero-1');

  const selectedSection = sections.find(s => s.id === selectedSectionId) || sections[0];

  const handleUpdateSelected = (key, value) => {
    setSections(sections.map(s => s.id === selectedSectionId ? { ...s, [key]: value } : s));
  };

  const handleAddSection = (type) => {
    const newId = `${type.toLowerCase()}-${Date.now().toString().slice(-4)}`;
    const newSection = { id: newId, type, title: `New ${type} Section`, subtitle: 'Customizable section subtitle text.' };
    setSections([...sections, newSection]);
    setSelectedSectionId(newId);
  };

  const handleRemoveSection = (id) => {
    if (sections.length <= 1) return;
    const updated = sections.filter(s => s.id !== id);
    setSections(updated);
    setSelectedSectionId(updated[0].id);
  };

  return (
    <div className="flex flex-col h-screen bg-slate-950 text-slate-100 font-sans overflow-hidden">
