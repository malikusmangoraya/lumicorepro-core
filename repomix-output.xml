import React, { useRef } from 'react';
import { motion, useScroll, useTransform } from 'framer-motion';
import { cn } from '@/utils';

export default function ParallaxHero({ src, alt = '', children, className = '', overlayClassName = '' }) {
  const ref = useRef(null);
  const { scrollYProgress } = useScroll({ target: ref, offset: ['start start', 'end start'] });
  const y   = useTransform(scrollYProgress, [0, 1], ['0%', '28%']);
  const opacity = useTransform(scrollYProgress, [0, 0.7], [1, 0]);

  return (
    <div ref={ref} className={cn('relative overflow-hidden', className)}>
      {/* Parallax image */}
      <motion.img
        src={src}
        alt={alt}
        style={{ y }}
        className="absolute inset-0 w-full h-full object-cover scale-110"
      />
      {/* Overlay */}
      <div className={cn('absolute inset-0 bg-gradient-to-t from-black/85 via-black/40 to-black/10', overlayClassName)} />
      {/* Content fades on scroll */}
      <motion.div className="relative z-10" style={{ opacity }}>
        {children}
      </motion.div>
    </div>
  );
}
