import React from 'react';
import { cn, getAnimationClass } from '../../utils';
import useReveal from '../../hooks/useReveal';
import Container from './Container';

const Section = React.forwardRef(
  (
    {
      children,
      title,
      description,
      eyebrow,
      containerSize = 'lg',
      muted = false,
      reveal = true,
      animate = 'fade-up',
      animationDelay = 0,
      className = '',
      headerClassName = '',
      ...props
    },
    forwardedRef
  ) => {
    const { ref: revealRef, visible } = useReveal({ once: true });
    const setRefs = (node) => {
      revealRef.current = node;
      if (typeof forwardedRef === 'function') forwardedRef(node);
      else if (forwardedRef) forwardedRef.current = node;
    };

    return (
      <section
        ref={reveal ? setRefs : forwardedRef}
        className={cn(
          'py-16 sm:py-20',
          muted && 'bg-muted/40',
          reveal && (visible ? getAnimationClass(animate, animationDelay) : 'opacity-0'),
          !reveal && getAnimationClass(animate, animationDelay),
