<file path="src/components/ecommerce/PriceFilter.jsx">
import React, { useState } from 'react';
import Button from '../ui/Button';

const PriceFilter = ({
  min = 0,
  max = 1000,
  value = { min: 0, max: 1000 },
  onChange,
  className = '',
  ...props
}) => {
  const [localValue, setLocalValue] = useState(value);

  const handleChange = (key, val) => {
    const newValue = { ...localValue, [key]: Number(val) };
    setLocalValue(newValue);
    onChange?.(newValue);
  };

  return (
    <div className={`space-y-4 ${className}`} {...props}>
      <h3 className="text-sm font-semibold text-foreground">Price Range</h3>

      <div className="flex items-center gap-2">
        <div className="flex-1">
          <label className="mb-1 block text-xs text-muted-foreground">Min</label>
          <input
            type="number"
            value={localValue.min}
            min={min}
            max={localValue.max}
            onChange={(e) => handleChange('min', e.target.value)}
            className="w-full rounded-lg border border-border bg-background px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary"
          />
        </div>
        <span className="mt-5 text-muted-foreground">-</span>
        <div className="flex-1">
          <label className="mb-1 block text-xs text-muted-foreground">Max</label>
          <input
            type="number"
            value={localValue.max}
            min={localValue.min}
            max={max}
            onChange={(e) => handleChange('max', e.target.value)}
            className="w-full rounded-lg border border-border bg-background px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary"
          />
        </div>
      </div>

      <div className="relative pt-4">
        <div className="h-2 rounded-full bg-muted">
          <div
            className="absolute h-2 rounded-full bg-primary"
            style={{
              left: `${((localValue.min - min) / (max - min)) * 100}%`,
              right: `${100 - ((localValue.max - min) / (max - min)) * 100}%`,
            }}
          />
        </div>
        <input
          type="range"
          min={min}
          max={max}
          value={localValue.min}
          onChange={(e) => handleChange('min', e.target.value)}
          className="absolute top-0 h-2 w-full appearance-none bg-transparent pointer-events-none"
          style={{ zIndex: 2 }}
        />
        <input
          type="range"
          min={min}
          max={max}
          value={localValue.max}
          onChange={(e) => handleChange('max', e.target.value)}
          className="absolute top-0 h-2 w-full appearance-none bg-transparent pointer-events-none"
          style={{ zIndex: 3 }}
        />
      </div>

      <Button
        variant="outline"
        size="sm"
        fullWidth
        onClick={() => onChange?.(localValue)}
      >
        Apply Price
      </Button>
    </div>
  );
};

export default PriceFilter;
</file>

