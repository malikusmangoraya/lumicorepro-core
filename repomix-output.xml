    REGION_SIGNALS: Dict[str, List[str]] = {
        "SA":    ["pakistan", "karachi", "lahore", "islamabad", "pkr", "jazzcash",
                  "easypaisa", "urdu", "pk", "sindh", "punjab", "india", "inr", "mumbai",
