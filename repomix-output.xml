import React, { useState } from 'react';
import { useCurrency } from '../hooks/useCurrency';
import { ChevronDown } from 'lucide-react';

/**
 * CurrencySelector - Dropdown component for selecting currency
 * Displays flag + currency code, organized by region
 * 
 * Usage: Add to Header/Navigation component
 * <CurrencySelector />
 */
export const CurrencySelector = () => {
  const { currency, setCurrency, CURRENCIES, AVAILABLE_CURRENCIES, loading } = useCurrency();
  const [isOpen, setIsOpen] = useState(false);

  // Group currencies by region
  const REGIONS = {
    'Americas': ['USD', 'CAD', 'MXN', 'BRL'],
    'Europe': ['EUR', 'GBP'],
    'Middle East': ['AED', 'SAR', 'KWD', 'QAR'],
    'Asia-Pacific': ['PKR', 'INR', 'JPY', 'CNY', 'SGD', 'HKD', 'AUD'],
  };

  const currentInfo = CURRENCIES[currency];

  return (
    <div className="relative inline-block">
      {/* Toggle Button */}
      <button
        onClick={() => setIsOpen(!isOpen)}
        className="flex items-center gap-2 px-3 py-2 rounded-lg border border-gray-200 hover:border-gray-300 hover:bg-gray-50 transition-all duration-200 text-sm font-medium text-gray-700"
        aria-label="Select currency"
        aria-expanded={isOpen}
        title={`Current currency: ${currentInfo?.name}`}
      >
        <span className="text-lg">{currentInfo?.flag}</span>
        <span>{currency}</span>
        <ChevronDown size={16} className={`transition-transform ${isOpen ? 'rotate-180' : ''}`} />
      </button>

      {/* Dropdown Panel */}
      {isOpen && (
        <div className="absolute right-0 mt-2 w-64 bg-white border border-gray-200 rounded-lg shadow-lg z-50">
          {/* Search/Filter */}
          <input
            type="text"
            placeholder="Search currency..."
            className="w-full px-3 py-2 border-b border-gray-100 text-sm rounded-t-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
            onChange={(e) => {
              const filtered = AVAILABLE_CURRENCIES.filter(
                (c) =>
                  c.toLowerCase().includes(e.target.value.toLowerCase()) ||
                  CURRENCIES[c].name.toLowerCase().includes(e.target.value.toLowerCase())
              );
              // Update available currencies display (implement if needed)
            }}
          />

          {/* Currency Groups */}
          <div className="max-h-96 overflow-y-auto">
            {Object.entries(REGIONS).map(([region, codes]) => {
              const validCodes = codes.filter((c) => AVAILABLE_CURRENCIES.includes(c));
              if (validCodes.length === 0) return null;

              return (
                <div key={region} className="border-b border-gray-100 last:border-b-0">
                  {/* Region Header */}
                  <div className="px-3 py-2 text-xs font-semibold text-gray-500 uppercase tracking-wider bg-gray-50">
                    {region}
                  </div>

                  {/* Currency Options */}
                  {validCodes.map((code) => {
                    const info = CURRENCIES[code];
                    const isSelected = currency === code;

                    return (
                      <button
                        key={code}
                        onClick={() => {
                          setCurrency(code);
                          setIsOpen(false);
                        }}
                        className={`w-full px-3 py-2.5 text-left text-sm hover:bg-blue-50 transition-colors flex items-center gap-3 ${
                          isSelected ? 'bg-blue-50 text-blue-700 font-medium' : 'text-gray-700'
                        }`}
                        aria-current={isSelected ? 'true' : 'false'}
                      >
                        <span className="text-lg">{info.flag}</span>
                        <div className="flex-1">
                          <div className="font-medium">{code}</div>
                          <div className="text-xs text-gray-500">{info.name}</div>
                        </div>
                        <span className="text-lg">{info.symbol}</span>
                        {isSelected && (
                          <span className="ml-auto text-blue-700">✓</span>
                        )}
                      </button>
                    );
                  })}
                </div>
              );
            })}
          </div>

          {/* Loading Indicator */}
          {loading && (
            <div className="px-3 py-2 text-xs text-gray-500 text-center border-t border-gray-100">
              Updating rates...
            </div>
          )}
        </div>
      )}

      {/* Close on outside click */}
      {isOpen && (
        <div
          className="fixed inset-0 z-40"
          onClick={() => setIsOpen(false)}
          aria-hidden="true"
        />
      )}
    </div>
  );
};
