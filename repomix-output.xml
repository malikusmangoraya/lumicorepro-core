/**
 * SocialShare - Social media sharing buttons with Open Graph / Twitter Card support
 * 
 * Features:
 * - Share to WhatsApp, Facebook, Twitter, LinkedIn, Email
 * - Copy link to clipboard functionality
 * - Auto-generates OG and Twitter meta tags
 * - Responsive grid layout
 * - Animated hover effects
 * - Dark mode support
 * 
 * @param {Object} props
 * @param {string} props.url - URL to share (defaults to current page)
 * @param {string} props.title - Title/headline to share
 * @param {string} props.description - Description text for email/email sharing
 * @param {string[]} props.platforms - Array of platform keys to display (default: all)
 * @param {string} props.variant - Display variant: 'horizontal', 'vertical', 'compact'
 * @param {string} props.showCopyButton - Show copy link button (default: true)
 * @param {function} props.onCopy - Callback when link is copied
 * @param {string} props.copyText - Copy button text (default: "Copy Link")
 * @param {string} props.copySuccessText - Success text after copy (default: "Copied!")
 */
export default function SocialShare({
  url = typeof window !== 'undefined' ? window.location.href : '',
  title = '',
  description = '',
  platforms =Object.keys(socialPlatforms),
  variant = 'horizontal',
  showCopyButton = true,
  onCopy,
  copyText = "Copy Link",
  copySuccessText = "Copied!",
}) {
  const [copied, setCopied] = useState(false);
  const [showDropdown, setShowDropdown] = useState(false);

  const handleShare = useCallback((platform) => {
    const platformConfig = socialPlatforms[platform];
    if (platformConfig) {
      const shareUrl = platformConfig.shareUrl(url, title, description);
      window.open(shareUrl, '_blank', 'noopener,noreferrer,width=600,height=400');
    }
  }, [url, title, description]);

  const copyToClipboard = useCallback(async () => {
    try {
      await navigator.clipboard.writeText(url);
      setCopied(true);
      if (onCopy) onCopy(url);
      setTimeout(() => setCopied(false), 2000);
    } catch (err) {
      console.error('Failed to copy:', err);
    }
  }, [url, onCopy]);

  const layoutClass = variant === 'horizontal' 
    ? 'flex flex-wrap gap-2' 
    : variant === 'vertical'
    ? 'flex flex-col gap-2'
    : 'flex flex-wrap gap-1';

  return (
    <div className="social-share-container">
      <div className={layoutClass}>
        {platforms.map((platform) => {
          const config = socialPlatforms[platform];
          if (!config) return null;

          const IconComponent = config.icon;

          return (
            <motion.button
              key={platform}
              onClick={() => handleShare(platform)}
              whileHover={{ scale: 1.1 }}
              whileTap={{ scale: 0.95 }}
              className={`
                inline-flex items-center gap-2 px-4 py-2 rounded-lg
                transition-colors duration-200 font-medium text-sm
                ${config.color}
                border border-gray-200 dark:border-gray-700
                focus:outline-none focus:ring-2 focus:ring-offset-2
                focus:ring-blue-500 dark:focus:ring-offset-gray-900
              `}
              aria-label={`Share on ${config.name}`}
            >
              <IconComponent className="w-4 h-4" />
              {variant !== 'compact' && <span>{config.name}</span>}
            </motion.button>
          );
        })}

        {showCopyButton && (
          <motion.button
            onClick={copyToClipboard}
            whileHover={{ scale: 1.1 }}
            whileTap={{ scale: 0.95 }}
            className={`
              inline-flex items-center gap-2 px-4 py-2 rounded-lg
              transition-colors duration-200 font-medium text-sm
              ${copied 
                ? 'bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400'
                : 'bg-gray-100 text-gray-700 hover:bg-gray-200 dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-gray-700'
              }
              border border-gray-200 dark:border-gray-700
              focus:outline-none focus:ring-2 focus:ring-offset-2
              focus:ring-blue-500 dark:focus:ring-offset-gray-900
            `}
            aria-label={copied ? "Link copied" : "Copy link to clipboard"}
          >
            {copied ? (
              <Check className="w-4 h-4" />
            ) : (
              <Copy className="w-4 h-4" />
            )}
            {variant !== 'compact' && <span>{copied ? copySuccessText : copyText}</span>}
          </motion.button>
        )}
      </div>

      {/* Mobile share dropdown for compact layout */}
      {variant === 'compact' && (
        <div className="relative">
          <motion.button
            onClick={() => setShowDropdown(!showDropdown)}
            whileTap={{ scale: 0.95 }}
            className="
              p-2 rounded-lg bg-gray-100 dark:bg-gray-800
              hover:bg-gray-200 dark:hover:bg-gray-700
              transition-colors duration-200
            "
            aria-label="Share options"
            aria-expanded={showDropdown}
          >
            <Share2 className="w-5 h-5 text-gray-700 dark:text-gray-300" />
          </motion.button>

          <AnimatePresence>
            {showDropdown && (
              <>
                <motion.div
                  initial={{ opacity: 0 }}
                  animate={{ opacity: 1 }}
                  exit={{ opacity: 0 }}
                  onClick={() => setShowDropdown(false)}
                  className="fixed inset-0 z-40"
                  aria-hidden="true"
                />
                <motion.div
                  initial={{ opacity: 0, y: 10, scale: 0.95 }}
                  animate={{ opacity: 1, y: 0, scale: 1 }}
                  exit={{ opacity: 0, y: 10, scale: 0.95 }}
                  className="absolute right-0 bottom-full mb-2 z-50
                    bg-white dark:bg-gray-800 rounded-lg shadow-lg
                    border border-gray-200 dark:border-gray-700 p-2
                    min-w-[160px]"
                >
                  <div className="flex flex-col gap-1">
                    {platforms.map((platform) => {
                      const config = socialPlatforms[platform];
                      if (!config) return null;
                      const IconComponent = config.icon;

                      return (
                        <button
                          key={platform}
                          onClick={() => {
                            handleShare(platform);
                            setShowDropdown(false);
                          }}
                          className={`
                            flex items-center gap-2 px-3 py-2 rounded-md
                            text-left text-sm transition-colors duration-200
                            ${config.color}
                          `}
                        >
                          <IconComponent className="w-4 h-4" />
                          <span>{config.name}</span>
                        </button>
                      );
                    })}
                    {showCopyButton && (
                      <button
                        onClick={() => {
                          copyToClipboard();
                          setShowDropdown(false);
                        }}
                        className="flex items-center gap-2 px-3 py-2 rounded-md
                          text-left text-sm text-gray-700 dark:text-gray-300
                          hover:bg-gray-100 dark:hover:bg-gray-700
                          transition-colors duration-200"
                      >
                        <Copy className="w-4 h-4" />
                        <span>{copyText}</span>
                      </button>
                    )}
                  </div>
                </motion.div>
              </>
            )}
          </AnimatePresence>
        </div>
      )}
    </div>
  );
}

/**
 * generateOpenGraphTags - Generate Open Graph and Twitter Card meta tags
 * 
 * These should be rendered in the <head> of your HTML document, typically
 * using React Helmet, Next.js Head, or direct meta tag injection.
 * 
 * @param {string} url - Canonical URL of the page
 * @param {string} title - Page title (max 60 chars recommended)
 * @param {string} description - Page description (max 160 chars recommended)
 * @param {string} image - OG image URL (1200x630px recommended)
 * @param {string} type - OG type (e.g., 'website', 'article', 'product')
 * @param {string} siteName - Website name
 * @returns {Array<string>} Array of meta tag strings
 * 
 * @example
 * // In your layout component:
 * import { generateOpenGraphTags } from './SocialShare';
 * 
 * <Helmet>
 *   {generateOpenGraphTags({
 *     url: 'https://example.com/page',
 *     title: 'Page Title',
 *     description: 'Page description',
 *     image: 'https://example.com/og-image.jpg',
 *     type: 'website',
 *     siteName: 'My Website',
 *   }).map((tag, i) => <meta key={i} {...tag} />)}
 * </Helmet>
 */
export function generateOpenGraphTags({
  url,
  title,
  description,
  image,
  type = 'website',
  siteName,
}) {
  const tags = [
    { property: 'og:type', content: type },
    { property: 'og:url', content: url },
    { property: 'og:title', content: title || '' },
    { property: 'og:description', content: description || '' },
  ];

  if (image) {
    tags.push({ property: 'og:image', content: image });
    tags.push({ property: 'og:image:width', content: '1200' });
    tags.push({ property: 'og:image:height', content: '630' });
  }

  if (siteName) {
    tags.push({ property: 'og:site_name', content: siteName });
  }

  // Twitter Card tags
  if (title) tags.push({ name: 'twitter:title', content: title });
  if (description) tags.push({ name: 'twitter:description', content: description });
  if (image) {
    tags.push({ name: 'twitter:card', content: 'summary_large_image' });
    tags.push({ name: 'twitter:image', content: image });
  }

  return tags;
}
