import { useState } from 'react';
import { Link, useNavigate } from 'react-router-dom';
import { Eye, EyeOff, Mail, Lock, User, ArrowRight, Sparkles, Check, AlertCircle } from 'lucide-react';
import { useAuth } from '@/context/AuthContext';
import { useAppContext } from '@/context/AppContext';
import { cn } from '@/utils';

const STRENGTH_LEVELS = [
  { label: 'Weak',   color: 'bg-red-500',    min: 1 },
  { label: 'Fair',   color: 'bg-amber-500',  min: 2 },
  { label: 'Good',   color: 'bg-blue-500',   min: 3 },
  { label: 'Strong', color: 'bg-emerald-500',min: 4 },
];

function getPasswordStrength(pwd) {
  let score = 0;
  if (pwd.length >= 8) score++;
  if (/[A-Z]/.test(pwd)) score++;
  if (/[0-9]/.test(pwd)) score++;
  if (/[^A-Za-z0-9]/.test(pwd)) score++;
  return score;
}

export default function RegisterPage() {
  const { register } = useAuth();
  const { addNotification } = useAppContext();
  const navigate = useNavigate();

  const [form, setForm] = useState({ name: '', email: '', password: '', confirm: '' });
  const [showPass, setShowPass] = useState(false);
  const [loading, setLoading] = useState(false);
  const [errors, setErrors] = useState({});
  const [agreed, setAgreed] = useState(false);

  const strength = getPasswordStrength(form.password);
  const strengthLevel = STRENGTH_LEVELS[Math.min(strength - 1, 3)];

  const validate = () => {
    const e = {};
    if (!form.name.trim()) e.name = 'Full name is required';
    if (!form.email) e.email = 'Email is required';
    else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(form.email)) e.email = 'Enter a valid email';
    if (!form.password) e.password = 'Password is required';
    else if (form.password.length < 6) e.password = 'Must be at least 6 characters';
    if (!form.confirm) e.confirm = 'Please confirm your password';
    else if (form.confirm !== form.password) e.confirm = 'Passwords do not match';
    if (!agreed) e.agreed = 'You must accept the terms';
    return e;
  };

  const handleSubmit = async (e) => {
    e.preventDefault();
    const errs = validate();
    if (Object.keys(errs).length) { setErrors(errs); return; }
    setErrors({});
    setLoading(true);

    try {
      await register({
        name: form.name.trim(),
        email: form.email.trim(),
        password: form.password,
      });
      addNotification('Account created successfully! Welcome to LumiCorePro.', 'success');
      navigate('/');
    } catch (err) {
      const msg = err.response?.data?.error || err.message || 'Registration failed. Please try again.';
      setErrors({ general: msg });
    } finally {
      setLoading(false);
    }
  };

  const change = (field) => (e) => {
    setForm(f => ({ ...f, [field]: e.target.value }));
    if (errors[field] || errors.general) setErrors(er => ({ ...er, [field]: '', general: '' }));
  };

  const Field = ({ id, label, type = 'text', value, onChange, error, placeholder, icon: Icon, autoComplete, children }) => (
    <div>
      <label className="block text-sm font-medium mb-1.5" htmlFor={id}>{label}</label>
      <div className="relative">
        <Icon className="absolute left-3.5 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground pointer-events-none" />
        <input
          id={id}
          type={type}
          value={value}
          onChange={onChange}
          placeholder={placeholder}
          autoComplete={autoComplete}
          className={cn(
            'w-full rounded-xl border bg-background/80 pl-10 py-2.5 text-sm focus:outline-none focus:ring-2 transition-all',
            children ? 'pr-10' : 'pr-4',
            error
              ? 'border-destructive focus:ring-destructive/40'
              : 'border-border focus:ring-primary/40 focus:border-primary/50'
          )}
        />
        {children}
      </div>
      {error && <p className="text-xs text-destructive mt-1">{error}</p>}
    </div>
  );

  return (
    <div className="min-h-[80vh] flex items-center justify-center -mx-4 -my-8 px-4 py-12">
      <div className="pointer-events-none fixed inset-0 bg-[radial-gradient(ellipse_at_top,hsl(var(--primary)/0.08),transparent_60%)]" />

      <div className="relative w-full max-w-sm animate-fade-in-up">
        {/* Logo */}
        <div className="text-center mb-6">
          <div className="inline-flex items-center justify-center h-14 w-14 rounded-2xl bg-primary/15 border border-primary/30 mb-3 animate-glow-pulse">
            <Sparkles className="h-7 w-7 text-primary" />
          </div>
          <h1 className="font-display text-2xl font-bold">Create an account</h1>
          <p className="text-sm text-muted-foreground mt-1">Start building AI websites with LumiCorePro</p>
        </div>

        {/* Card */}
        <div className="rounded-2xl border border-border bg-card/80 backdrop-blur p-8 shadow-glass">
          {errors.general && (
            <div className="mb-4 p-3 rounded-xl border border-destructive/30 bg-destructive/10 text-destructive text-xs flex items-center gap-2">
              <AlertCircle className="h-4 w-4 shrink-0" />
              <span>{errors.general}</span>
            </div>
          )}

          <form onSubmit={handleSubmit} noValidate className="space-y-4">
            {/* Full Name */}
            <Field id="name" label="Full Name" value={form.name} onChange={change('name')} error={errors.name} placeholder="Sarah Connor" icon={User} autoComplete="name" />

            {/* Email */}
            <Field id="email" label="Email Address" type="email" value={form.email} onChange={change('email')} error={errors.email} placeholder="sarah@example.com" icon={Mail} autoComplete="email" />

            {/* Password */}
            <Field id="password" label="Password" type={showPass ? 'text' : 'password'} value={form.password} onChange={change('password')} error={errors.password} placeholder="At least 6 characters" icon={Lock} autoComplete="new-password">
              <button
                type="button"
                onClick={() => setShowPass(s => !s)}
                className="absolute right-3 top-1/2 -translate-y-1/2 text-muted-foreground hover:text-foreground transition-colors"
                aria-label={showPass ? 'Hide password' : 'Show password'}
              >
                {showPass ? <EyeOff className="h-4 w-4" /> : <Eye className="h-4 w-4" />}
              </button>
            </Field>

            {/* Password strength bar */}
            {form.password && (
              <div className="space-y-1.5">
                <div className="flex justify-between text-[11px] text-muted-foreground">
                  <span>Strength</span>
                  <span className="font-medium">{strengthLevel?.label || 'Weak'}</span>
                </div>
                <div className="h-1.5 rounded-full bg-muted overflow-hidden flex gap-1">
                  {[1, 2, 3, 4].map(step => (
                    <div
                      key={step}
                      className={cn(
                        'flex-1 rounded-full transition-all duration-300',
                        step <= strength ? (strengthLevel?.color || 'bg-primary') : 'bg-transparent'
                      )}
                    />
                  ))}
                </div>
              </div>
            )}

            {/* Confirm */}
            <Field id="confirm" label="Confirm Password" type={showPass ? 'text' : 'password'} value={form.confirm} onChange={change('confirm')} error={errors.confirm} placeholder="Repeat password" icon={Lock} autoComplete="new-password">
              {form.confirm && form.confirm === form.password && (
                <Check className="absolute right-3 top-1/2 -translate-y-1/2 h-4 w-4 text-emerald-400" />
              )}
            </Field>

            {/* Terms */}
            <div>
              <label className="flex items-start gap-2.5 cursor-pointer group">
                <input
                  type="checkbox"
                  checked={agreed}
                  onChange={e => { setAgreed(e.target.checked); if (errors.agreed) setErrors(er => ({ ...er, agreed: '' })); }}
                  className="mt-0.5 h-4 w-4 rounded border-border accent-primary shrink-0"
                />
                <span className="text-xs text-muted-foreground leading-relaxed">
                  I agree to the{' '}
                  <Link to="/terms" className="text-primary hover:underline">Terms of Service</Link>
                  {' '}and{' '}
                  <Link to="/privacy" className="text-primary hover:underline">Privacy Policy</Link>
                </span>
              </label>
              {errors.agreed && <p className="text-xs text-destructive mt-1">{errors.agreed}</p>}
            </div>

            {/* Submit */}
            <button
              type="submit"
              disabled={loading}
              className="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-primary py-2.5 text-sm font-semibold text-primary-foreground shadow-glow-sm hover:bg-primary/90 hover:shadow-glow transition-all active:scale-[0.98] disabled:opacity-60 disabled:cursor-not-allowed"
            >
              {loading ? (
                <span className="h-4 w-4 rounded-full border-2 border-white/30 border-t-white animate-spin" />
              ) : (
                <>Create Account <ArrowRight className="h-4 w-4" /></>
              )}
            </button>
          </form>
        </div>

        <p className="text-center text-sm text-muted-foreground mt-5">
          Already have an account?{' '}
          <Link to="/login" className="font-semibold text-primary hover:underline">Sign in</Link>
        </p>
      </div>
    </div>
  );
}
</file>

<file path="src/pages/Templates.jsx">
import { useState, useMemo } from 'react';
import { Link } from 'react-router-dom';
import {
  LayoutDashboard, ShoppingBag, Sparkles, Briefcase,
  Utensils, Home, HeartPulse, Dumbbell, GraduationCap,
  Plane, User, Palette, Search, ArrowRight, X, Filter,
} from 'lucide-react';
import { TEMPLATE_CATALOG } from '@/templates/catalog';
import { Card, Badge } from '@/components/ui';
import { cn } from '@/utils';

/* ── category meta ──────────────────────────────────────────────── */
const CATEGORIES = [
  { label: 'All',          icon: Filter,         tone: 'text-muted-foreground', count: null },
  { label: 'Dashboard',   icon: LayoutDashboard, tone: 'text-blue-400' },
  { label: 'E-Commerce',  icon: ShoppingBag,     tone: 'text-emerald-400' },
  { label: 'AI',          icon: Sparkles,        tone: 'text-violet-400' },
  { label: 'Business',    icon: Briefcase,       tone: 'text-amber-400' },
  { label: 'Restaurant',  icon: Utensils,        tone: 'text-orange-400' },
  { label: 'Real Estate', icon: Home,            tone: 'text-indigo-400' },
  { label: 'Healthcare',  icon: HeartPulse,      tone: 'text-rose-400' },
  { label: 'Fitness',     icon: Dumbbell,        tone: 'text-red-400' },
  { label: 'Education',   icon: GraduationCap,   tone: 'text-purple-400' },
  { label: 'Travel',      icon: Plane,           tone: 'text-sky-400' },
  { label: 'Portfolio',   icon: User,            tone: 'text-teal-400' },
  { label: 'Creative',    icon: Palette,         tone: 'text-pink-400' },
];

const catMeta = Object.fromEntries(CATEGORIES.map(c => [c.label, c]));

/* ── gradient per category ──────────────────────────────────────── */
const CAT_GRADIENT = {
  Dashboard:   'from-blue-500/15 to-blue-900/10',
  'E-Commerce':'from-emerald-500/15 to-emerald-900/10',
  AI:          'from-violet-500/15 to-violet-900/10',
  Business:    'from-amber-500/15 to-amber-900/10',
  Restaurant:  'from-orange-500/15 to-orange-900/10',
  'Real Estate':'from-indigo-500/15 to-indigo-900/10',
  Healthcare:  'from-rose-500/15 to-rose-900/10',
  Fitness:     'from-red-500/15 to-red-900/10',
  Education:   'from-purple-500/15 to-purple-900/10',
  Travel:      'from-sky-500/15 to-sky-900/10',
  Portfolio:   'from-teal-500/15 to-teal-900/10',
  Creative:    'from-pink-500/15 to-pink-900/10',
};

export default function TemplatesHub() {
  const [activeCategory, setActiveCategory] = useState('All');
  const [search, setSearch] = useState('');

  const filtered = useMemo(() => {
    return TEMPLATE_CATALOG.filter(t => {
      const matchCat = activeCategory === 'All' || t.category === activeCategory;
      const q = search.toLowerCase();
      const matchSearch = !q || t.title.toLowerCase().includes(q) || t.description.toLowerCase().includes(q) || (t.tags || []).some(tag => tag.includes(q));
      return matchCat && matchSearch;
    });
  }, [activeCategory, search]);

  /* grouped for the "All" view */
  const groups = useMemo(() => {
    if (activeCategory !== 'All') return null;
    const map = {};
    TEMPLATE_CATALOG.forEach(t => {
      if (!map[t.category]) map[t.category] = [];
      map[t.category].push(t);
    });
    return map;
  }, [activeCategory]);

  const catCounts = useMemo(() => {
    const m = {};
    TEMPLATE_CATALOG.forEach(t => { m[t.category] = (m[t.category] || 0) + 1; });
    return m;
  }, []);

  return (
    <div className="space-y-8 animate-page-enter">
      {/* ── Header ─────────────────────────────────────────────── */}
      <header className="animate-fade-in-up">
        <div className="flex items-center gap-3 mb-2">
          <Badge variant="info">28 Templates</Badge>
          <Badge variant="secondary">10 Categories</Badge>
          <Badge variant="success">Market-Ready</Badge>
        </div>
        <h1 className="font-display text-3xl sm:text-4xl font-bold tracking-tight">
          Template Gallery
        </h1>
        <p className="mt-2 max-w-2xl text-muted-foreground">
          28 production-ready templates across 10 industries — each with real mock data, dark mode, and responsive layout. Browse, preview, and copy into your next project.
        </p>
      </header>

      {/* ── Search Bar ─────────────────────────────────────────── */}
      <div className="relative max-w-md animate-fade-in-up" style={{ animationDelay: '60ms' }}>
        <Search className="absolute left-3.5 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground pointer-events-none" />
        <input
          value={search}
          onChange={e => setSearch(e.target.value)}
          placeholder="Search templates, categories, or tags..."
          className="w-full rounded-xl border border-border bg-card pl-10 pr-10 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/50 transition-all"
        />
        {search && (
          <button
            onClick={() => setSearch('')}
            className="absolute right-3 top-1/2 -translate-y-1/2 text-muted-foreground hover:text-foreground"
            aria-label="Clear search"
          >
            <X className="h-4 w-4" />
          </button>
        )}
      </div>

      {/* ── Category Filter Tabs ────────────────────────────────── */}
      <div className="flex flex-wrap gap-2 animate-fade-in-up" style={{ animationDelay: '100ms' }}>
        {CATEGORIES.map(cat => {
          const Icon = cat.icon;
          const count = cat.label === 'All' ? TEMPLATE_CATALOG.length : (catCounts[cat.label] || 0);
          const active = activeCategory === cat.label;
          return (
            <button
              key={cat.label}
              onClick={() => setActiveCategory(cat.label)}
              className={cn(
                'inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-sm font-medium transition-all duration-200 border',
                active
                  ? 'bg-primary text-primary-foreground border-primary shadow-glow-sm'
                  : 'bg-card border-border text-muted-foreground hover:text-foreground hover:border-primary/40'
              )}
            >
              <Icon className={cn('h-3.5 w-3.5', active ? 'text-primary-foreground' : cat.tone)} aria-hidden="true" />
              <span>{cat.label}</span>
              <span className={cn(
                'px-1.5 py-0.5 rounded-full text-xs font-bold',
                active ? 'bg-white/20 text-primary-foreground' : 'bg-muted text-muted-foreground'
              )}>
                {count}
              </span>
            </button>
          );
        })}
      </div>

      {/* ── Results summary ─────────────────────────────────────── */}
      {search && (
        <p className="text-sm text-muted-foreground animate-fade-in">
          Found <span className="font-semibold text-foreground">{filtered.length}</span> template{filtered.length !== 1 ? 's' : ''} for "<span className="text-primary">{search}</span>"
        </p>
      )}

      {/* ── Grouped All View ────────────────────────────────────── */}
      {activeCategory === 'All' && !search && groups && (
        <div className="space-y-10">
          {CATEGORIES.filter(c => c.label !== 'All').map((cat, gi) => {
            const items = groups[cat.label];
            if (!items) return null;
            const Icon = cat.icon;
            return (
              <section key={cat.label} className="animate-fade-in-up" style={{ animationDelay: `${gi * 40}ms` }}>
                <div className="flex items-center gap-3 mb-4">
                  <div className={cn('h-8 w-8 rounded-lg flex items-center justify-center bg-gradient-to-br', CAT_GRADIENT[cat.label] || 'from-primary/15 to-primary/5')}>
                    <Icon className={cn('h-4 w-4', cat.tone)} />
                  </div>
                  <h2 className="font-display text-xl font-bold">{cat.label}</h2>
                  <span className="px-2 py-0.5 rounded-full bg-muted text-xs font-bold text-muted-foreground">
                    {items.length}
                  </span>
                </div>
                <TemplateGrid items={items} catGradient={CAT_GRADIENT[cat.label]} />
              </section>
            );
          })}
        </div>
      )}

      {/* ── Filtered / Search View ──────────────────────────────── */}
      {(activeCategory !== 'All' || search) && (
        <>
          {activeCategory !== 'All' && !search && (
            <div className="flex items-center gap-3 mb-2 animate-fade-in">
              {(() => {
                const meta = catMeta[activeCategory];
                const Icon = meta?.icon || Filter;
                return (
                  <>
                    <div className={cn('h-8 w-8 rounded-lg flex items-center justify-center bg-gradient-to-br', CAT_GRADIENT[activeCategory] || 'from-primary/15 to-primary/5')}>
                      <Icon className={cn('h-4 w-4', meta?.tone || 'text-primary')} />
                    </div>
                    <h2 className="font-display text-xl font-bold">{activeCategory}</h2>
                    <span className="px-2 py-0.5 rounded-full bg-muted text-xs font-bold text-muted-foreground">
                      {filtered.length}
                    </span>
                  </>
                );
              })()}
            </div>
          )}
          <TemplateGrid items={filtered} catGradient={CAT_GRADIENT[activeCategory]} />
        </>
      )}

      {/* ── No results ──────────────────────────────────────────── */}
      {filtered.length === 0 && (
        <div className="text-center py-16 animate-fade-in-up">
          <div className="text-5xl mb-4">🔍</div>
          <h3 className="font-display text-lg font-bold mb-2">No templates found</h3>
          <p className="text-muted-foreground text-sm mb-4">Try a different search term or category.</p>
          <button
            onClick={() => { setSearch(''); setActiveCategory('All'); }}
            className="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-primary text-primary-foreground text-sm font-medium hover:bg-primary/90 transition-colors"
          >
            <X className="h-4 w-4" />Clear filters
          </button>
        </div>
      )}
    </div>
  );
}

/* ── Template Card Grid ─────────────────────────────────────────── */
function TemplateGrid({ items, catGradient }) {
  return (
    <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
      {items.map((t, i) => (
        <TemplateCard key={t.id} template={t} index={i} gradient={catGradient || CAT_GRADIENT[t.category]} />
      ))}
    </div>
  );
}

function TemplateCard({ template: t, index, gradient }) {
  const meta = catMeta[t.category];
  const Icon = meta?.icon || Filter;

  return (
    <Link to={t.route} className="group block">
      <Card
        className="h-full flex flex-col transition-all duration-200 hover-lift group-hover:border-primary/40 group-hover:shadow-card-hover overflow-hidden"
        padding="none"
        animate="fade-up"
        animationDelay={(index * 50) % 400}
      >
        {/* Preview thumbnail */}
        <div className={cn('h-28 bg-gradient-to-br flex items-center justify-center relative overflow-hidden', gradient || 'from-primary/15 to-primary/5')}>
          <div className="absolute inset-0 bg-gradient-mesh opacity-50" />
          <span className="text-4xl relative z-10 group-hover:scale-110 transition-transform duration-300">
            {t.icon || '📄'}
          </span>
          <div className="absolute top-2 right-2">
            <span className={cn('text-xs font-medium px-2 py-0.5 rounded-full bg-background/70 backdrop-blur border border-border/50', meta?.tone)}>
              {t.category}
            </span>
          </div>
        </div>

        {/* Info */}
        <div className="flex flex-col flex-1 p-4">
          <h3 className="font-display font-semibold text-sm group-hover:text-primary transition-colors leading-snug">
            {t.title}
          </h3>
          <p className="mt-1.5 text-xs text-muted-foreground flex-1 leading-relaxed">
            {t.description}
          </p>
          {/* Tags */}
          {t.tags && (
            <div className="flex flex-wrap gap-1 mt-3">
              {t.tags.slice(0, 3).map(tag => (
                <span key={tag} className="px-1.5 py-0.5 rounded bg-muted text-muted-foreground text-[10px] font-medium">
                  {tag}
                </span>
              ))}
            </div>
          )}
          <div className="flex items-center justify-between mt-3 pt-3 border-t border-border/60">
            <div className={cn('h-5 w-5 rounded flex items-center justify-center', gradient?.split(' ')[0].replace('from-', 'bg-') || 'bg-primary/10')}>
              <Icon className={cn('h-3 w-3', meta?.tone || 'text-primary')} />
            </div>
            <span className="inline-flex items-center gap-1 text-xs font-semibold text-primary">
              Preview <ArrowRight className="h-3 w-3 transition-transform group-hover:translate-x-0.5" />
            </span>
          </div>
        </div>
      </Card>
    </Link>
  );
}
</file>

