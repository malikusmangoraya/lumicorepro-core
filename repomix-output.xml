                  <span className="text-primary font-bold">{skill.level}%</span>
                </div>
                <Progress value={skill.level} className="h-1.5" />
              </div>
            ))}
          </div>
        </Card>

        {/* Experience */}
        <Card animate="fade-up" animationDelay={100} className="lg:col-span-2">
          <h3 className="font-display font-bold mb-4 flex items-center gap-2"><Briefcase className="h-4 w-4 text-primary" />Experience</h3>
          <div className="space-y-4">
            {experience.map((exp, i) => (
              <div key={i} className="flex gap-4 pb-4 border-b border-border last:border-0 last:pb-0">
                <div className="mt-1 h-3 w-3 rounded-full bg-primary shrink-0" />
                <div>
                  <div className="flex items-center justify-between flex-wrap gap-1">
                    <h4 className="font-semibold text-sm">{exp.role}</h4>
                    <span className="text-xs text-muted-foreground">{exp.period}</span>
