import { useState, useEffect } from 'react';
import { Outlet, Link, useLocation } from 'react-router-dom';
import { useAppContext } from '../context/AppContext';
import {
  Sun,
  Moon,
  Home,
  Store,
  BarChart3,
  Brain,
  Briefcase,
  LogIn,
  LogOut,
  Menu,
  X,
  ChevronDown,
  Settings,
  Bell,
  User,
  LayoutTemplate,
  Sparkles,
  Zap,
  Key,
} from 'lucide-react';
import { BrandLogo, Language } from '../components/common';
import { cn } from '../utils';

function navActive(pathname, item) {
  if (item.match === 'exact') return pathname === item.path;
  if (item.match === 'prefix') return pathname === item.path || pathname.startsWith(`${item.path}/`);
  return pathname === item.path;
}

export default function MainLayout() {
  const { isAuthenticated, logout, toggleTheme, theme, language, setLanguage } = useAppContext();
  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);
  const [dropdownOpen, setDropdownOpen] = useState(false);
  const location = useLocation();
  const isDark = theme === 'dark';

  useEffect(() => {
    setDropdownOpen(false);
    setMobileMenuOpen(false);
  }, [location.pathname]);

  useEffect(() => {
    const handleClick = (e) => {
      if (!e.target.closest('[data-dropdown]') && dropdownOpen) {
        setDropdownOpen(false);
      }
    };
    if (dropdownOpen) {
      document.addEventListener('click', handleClick);
      return () => document.removeEventListener('click', handleClick);
    }
    return undefined;
  }, [dropdownOpen]);

  const navItems = [
    { path: '/', label: 'Home', icon: Home, match: 'exact' },
    { path: '/templates', label: 'Templates', icon: LayoutTemplate, match: 'prefix' },
    {
      path: '/templates/dashboard/DashboardOverview',
      label: 'Dashboard',
      icon: BarChart3,
      match: 'exact',
      group: '/templates/dashboard',
    },
    {
      path: '/templates/ecommerce/ProductListing',
      label: 'Shop',
      icon: Store,
      match: 'exact',
      group: '/templates/ecommerce',
    },
    {
      path: '/templates/ai/ChatInterface',
      label: 'AI',
      icon: Brain,
      match: 'exact',
      group: '/templates/ai',
    },
    {
      path: '/templates/business/LandingPage',
      label: 'Business',
      icon: Briefcase,
      match: 'exact',
      group: '/templates/business',
    },
    {
      path: '/generate',
      label: 'Generate',
      icon: Sparkles,
      match: 'exact',
      highlight: true,
    },
    {
      path: '/api-settings',
      label: 'API Settings',
      icon: Key,
      match: 'exact',
    },
  ];

  const isItemActive = (item) => {
    if (item.group && location.pathname.startsWith(item.group)) return true;
    return navActive(location.pathname, item);
  };

  const NavItem = ({ item, onNavigate }) => {
    const Icon = item.icon;
    const active = isItemActive(item);
    if (item.highlight) {
      return (
        <Link
          to={item.path}
          onClick={onNavigate}
          className={cn(
            'inline-flex items-center gap-2 rounded-lg px-3 py-2 text-sm font-semibold transition-all duration-200',
            active
              ? 'bg-primary text-primary-foreground shadow-glow-sm'
              : 'bg-primary/10 text-primary hover:bg-primary hover:text-primary-foreground hover:shadow-glow-sm border border-primary/30'
          )}
          aria-current={active ? 'page' : undefined}
        >
          <Icon className="h-4 w-4 shrink-0 animate-soft-pulse" strokeWidth={2} aria-hidden="true" />
          <span>{item.label}</span>
        </Link>
      );
    }
    return (
      <Link
        to={item.path}
        onClick={onNavigate}
        className={cn(
          'inline-flex items-center gap-2 rounded-lg px-3 py-2 text-sm font-medium transition-all duration-200',
          active
            ? 'bg-primary/10 text-primary'
            : 'text-muted-foreground hover:text-foreground hover:bg-muted/70'
        )}
        aria-current={active ? 'page' : undefined}
      >
        <Icon className="h-4 w-4 shrink-0" strokeWidth={2} aria-hidden="true" />
        <span>{item.label}</span>
      </Link>
    );
  };

  return (
    <div className="min-h-screen flex flex-col bg-background">
      <header className="sticky top-0 z-50 w-full border-b border-border bg-background/90 backdrop-blur-md supports-[backdrop-filter]:bg-background/75 animate-fade-in-down">
        <div className="container mx-auto px-4">
          <div className="flex h-16 items-center justify-between gap-4">
            <div className="flex items-center gap-6 min-w-0">
              <BrandLogo variant="full" size="md" />
              <nav className="hidden lg:flex items-center gap-0.5" aria-label="Main">
                {navItems.map((item) => (
                  <NavItem key={item.path} item={item} />
                ))}
              </nav>
            </div>

            <div className="flex items-center gap-2 sm:gap-3">
              {/* Template count badge */}
              <span className="hidden md:inline-flex items-center gap-1.5 px-2 py-1 rounded-full bg-primary/10 border border-primary/20 text-xs font-medium text-primary">
                <Zap className="h-3 w-3" />
                28 Templates
              </span>

              <Language currentLang={language || 'en'} onLanguageChange={setLanguage} />

              <button
                type="button"
                onClick={() => toggleTheme()}
                className="rounded-lg p-2 text-muted-foreground hover:text-foreground hover:bg-muted transition-all active:scale-95"
                aria-label={isDark ? 'Switch to light mode' : 'Switch to dark mode'}
              >
                {isDark ? (
                  <Sun className="h-5 w-5" aria-hidden="true" />
                ) : (
                  <Moon className="h-5 w-5" aria-hidden="true" />
                )}
              </button>

              {isAuthenticated ? (
                <div className="hidden md:block relative" data-dropdown>
                  <button
                    type="button"
                    onClick={(e) => {
                      e.stopPropagation();
                      setDropdownOpen(!dropdownOpen);
                    }}
                    className="inline-flex items-center gap-2 rounded-lg px-2.5 py-1.5 text-sm transition-colors hover:bg-accent"
                    aria-expanded={dropdownOpen}
                    aria-label="Account menu"
                  >
                    <User className="h-4 w-4 text-muted-foreground" aria-hidden="true" />
                    <span className="font-medium">Account</span>
                    <ChevronDown
                      className={cn(
                        'h-4 w-4 transition-transform duration-200',
                        dropdownOpen && 'rotate-180'
                      )}
                      aria-hidden="true"
                    />
                  </button>
                  {dropdownOpen && (
                    <div className="absolute right-0 z-50 mt-2 w-52 rounded-xl border border-border bg-card shadow-lg animate-scale-in p-1.5">
                      <Link
                        to="/profile"
                        onClick={() => setDropdownOpen(false)}
                        className="w-full inline-flex items-center gap-2.5 rounded-lg px-3 py-2 text-sm text-muted-foreground hover:bg-accent hover:text-foreground transition-colors"
                      >
                        <User className="h-4 w-4" aria-hidden="true" />
                        <span>Profile</span>
                      </Link>
                      <Link
                        to="/settings"
                        onClick={() => setDropdownOpen(false)}
                        className="w-full inline-flex items-center gap-2.5 rounded-lg px-3 py-2 text-sm text-muted-foreground hover:bg-accent hover:text-foreground transition-colors"
                      >
                        <Settings className="h-4 w-4" aria-hidden="true" />
                        <span>Settings</span>
                      </Link>
                      <button
                        type="button"
                        onClick={() => setDropdownOpen(false)}
                        className="w-full inline-flex items-center gap-2.5 rounded-lg px-3 py-2 text-sm text-muted-foreground hover:bg-accent hover:text-foreground transition-colors"
                      >
                        <Bell className="h-4 w-4" aria-hidden="true" />
                        <span>Notifications</span>
                      </button>
                      <div className="my-1 border-t border-border" />
                      <button
                        type="button"
                        onClick={() => {
                          logout();
                          setDropdownOpen(false);
                        }}
                        className="w-full inline-flex items-center gap-2.5 rounded-lg px-3 py-2 text-sm text-destructive hover:bg-destructive/10 transition-colors"
                      >
                        <LogOut className="h-4 w-4" aria-hidden="true" />
                        <span>Logout</span>
                      </button>
                    </div>
                  )}
                </div>
              ) : (
                <div className="hidden md:flex items-center gap-2">
                  <Link
                    to="/login"
                    className="inline-flex items-center gap-2 rounded-lg px-3 py-1.5 text-sm font-medium text-muted-foreground hover:text-foreground hover:bg-muted transition-all"
                  >
                    <LogIn className="h-4 w-4" aria-hidden="true" />
                    <span>Login</span>
                  </Link>
                  <Link
                    to="/register"
                    className="inline-flex items-center gap-2 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow-sm hover:bg-primary/90 transition-all active:scale-[0.98]"
                  >
                    <span>Sign Up</span>
                  </Link>
                </div>
              )}

              <button
                type="button"
                onClick={() => setMobileMenuOpen(!mobileMenuOpen)}
                className="lg:hidden rounded-lg p-2 text-muted-foreground hover:text-foreground hover:bg-muted transition-colors"
                aria-label={mobileMenuOpen ? 'Close menu' : 'Open menu'}
              >
                {mobileMenuOpen ? (
                  <X className="h-5 w-5" aria-hidden="true" />
                ) : (
                  <Menu className="h-5 w-5" aria-hidden="true" />
                )}
              </button>
            </div>
          </div>
        </div>
      </header>

      {mobileMenuOpen && (
        <div className="lg:hidden">
          <div
            className="fixed inset-0 z-40 bg-background/80 backdrop-blur-sm animate-fade-in"
            onClick={() => setMobileMenuOpen(false)}
          />
          <div className="fixed inset-y-0 left-0 z-50 w-72 bg-background border-r border-border shadow-xl animate-slide-in-left flex flex-col">
            <div className="flex items-center justify-between p-4 border-b border-border">
              <BrandLogo variant="full" size="sm" onClick={() => setMobileMenuOpen(false)} />
              <button
                type="button"
                onClick={() => setMobileMenuOpen(false)}
                className="rounded-lg p-2 text-muted-foreground"
                aria-label="Close menu"
              >
                <X className="h-5 w-5" aria-hidden="true" />
              </button>
            </div>
            <nav className="flex-1 p-3 space-y-1 overflow-y-auto" aria-label="Mobile">
              {navItems.map((item) => (
                <NavItem key={item.path} item={item} onNavigate={() => setMobileMenuOpen(false)} />
              ))}
              <div className="pt-2 border-t border-border mt-2">
                <p className="px-3 py-1 text-xs font-semibold text-muted-foreground uppercase tracking-wider">More Templates</p>
                {[
                  { path: '/templates/restaurant/RestaurantMenu', label: '🍽️ Restaurant', icon: Store },
                  { path: '/templates/realestate/PropertyListing', label: '🏠 Real Estate', icon: Home },
                  { path: '/templates/healthcare/MedicalPortal', label: '🏥 Healthcare', icon: Brain },
                  { path: '/templates/fitness/GymLanding', label: '💪 Fitness', icon: Zap },
                  { path: '/templates/education/CourseCatalog', label: '🎓 Education', icon: Briefcase },
                  { path: '/templates/travel/TravelAgency', label: '✈️ Travel', icon: LayoutTemplate },
                  { path: '/templates/portfolio/PersonalPortfolio', label: '👨‍💻 Portfolio', icon: User },
                  { path: '/templates/creative/CreativeStudio', label: '🎨 Creative', icon: Sparkles },
                ].map(item => (
                  <Link
                    key={item.path}
                    to={item.path}
                    onClick={() => setMobileMenuOpen(false)}
                    className="flex items-center gap-2 px-3 py-2 text-sm text-muted-foreground hover:text-foreground hover:bg-muted rounded-lg transition-colors"
                  >
                    {item.label}
                  </Link>
                ))}
              </div>
            </nav>
            <div className="border-t border-border p-4 space-y-2">
              {isAuthenticated ? (
                <button
                  type="button"
                  onClick={() => { logout(); setMobileMenuOpen(false); }}
                  className="w-full inline-flex items-center justify-center gap-2 rounded-lg px-3 py-2.5 text-sm text-destructive hover:bg-destructive/10 transition-colors"
                >
                  <LogOut className="h-4 w-4" aria-hidden="true" />
                  <span>Logout</span>
                </button>
              ) : (
                <>
                  <Link
                    to="/login"
                    onClick={() => setMobileMenuOpen(false)}
                    className="w-full inline-flex items-center justify-center gap-2 rounded-lg border border-border px-3 py-2 text-sm font-medium text-foreground hover:bg-muted transition-colors"
                  >
                    <LogIn className="h-4 w-4" aria-hidden="true" />
                    <span>Login</span>
                  </Link>
                  <Link
                    to="/register"
                    onClick={() => setMobileMenuOpen(false)}
                    className="w-full inline-flex items-center justify-center gap-2 rounded-lg bg-primary px-3 py-2.5 text-sm font-medium text-primary-foreground"
