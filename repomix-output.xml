<file path="src/components/forms/TimePicker.jsx">
import React, { useState, useRef, useEffect } from 'react';
import { Clock, AlertCircle } from 'lucide-react';

const TimePicker = ({
  label,
  value,
  onChange,
  error,
  helperText,
  required = false,
  disabled = false,
  format = '12h',
  minuteStep = 5,
  placeholder = 'Select time',
  className = '',
  id,
  ...props
}) => {
  const [open, setOpen] = useState(false);
  const [selectedHour, setSelectedHour] = useState(null);
  const [selectedMinute, setSelectedMinute] = useState(null);
  const [selectedPeriod, setSelectedPeriod] = useState('AM');
  const containerRef = useRef(null);
  const inputId = id || `timepicker-${Math.random().toString(36).substr(2, 9)}`;

  useEffect(() => {
    const handleClickOutside = (e) => {
      if (containerRef.current && !containerRef.current.contains(e.target)) {
        setOpen(false);
      }
    };
    document.addEventListener('mousedown', handleClickOutside);
    return () => document.removeEventListener('mousedown', handleClickOutside);
  }, []);

  useEffect(() => {
    if (value) {
      const [time, period] = value.split(' ');
      const [h, m] = time.split(':').map(Number);
      setSelectedHour(h);
      setSelectedMinute(m);
      if (period) setSelectedPeriod(period);
    }
  }, [value]);

  const hours = format === '12h' ? Array.from({ length: 12 }, (_, i) => i + 1) : Array.from({ length: 24 }, (_, i) => i);
  const minutes = Array.from({ length: 60 / minuteStep }, (_, i) => i * minuteStep);

  const formatTime = (hour, minute, period) => {
    if (format === '12h') {
      return `${String(hour).padStart(2, '0')}:${String(minute).padStart(2, '0')} ${period}`;
    }
    return `${String(hour).padStart(2, '0')}:${String(minute).padStart(2, '0')}`;
  };

  const handleSelect = (hour, minute, period) => {
    const time = formatTime(hour, minute, period);
    onChange?.(time);
    setOpen(false);
  };

  const displayValue = value || placeholder;

  return (
    <div className={`w-full ${className}`} ref={containerRef}>
      {label && (
        <label htmlFor={inputId} className="mb-1.5 block text-sm font-medium text-foreground">
          {label}
          {required && <span className="ml-0.5 text-destructive" aria-hidden="true">*</span>}
        </label>
      )}
      <div className="relative">
        <button
          type="button"
          id={inputId}
          disabled={disabled}
          onClick={() => setOpen(!open)}
          aria-haspopup="dialog"
          aria-expanded={open}
          aria-invalid={!!error}
          className={`w-full rounded-lg border bg-background px-4 py-2.5 text-sm text-left transition-all focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-between gap-2 ${
            error ? 'border-destructive focus:ring-destructive' : 'border-border hover:border-muted-foreground/30'
          }`}
        >
          <span className={value ? '' : 'text-muted-foreground'}>{displayValue}</span>
          <Clock className="h-4 w-4 text-muted-foreground shrink-0" aria-hidden="true" />
        </button>

        {open && (
          <div className="absolute z-50 mt-2 w-64 rounded-xl border border-border bg-card shadow-lg p-4 animate-in fade-in zoom-in-95">
            <div className="flex gap-2">
              <div className="flex-1">
                <p className="text-xs font-medium text-muted-foreground mb-2">Hour</p>
                <div className="max-h-40 overflow-y-auto space-y-1 pr-1">
                  {hours.map((hour) => (
                    <button
                      key={hour}
                      type="button"
                      onClick={() => setSelectedHour(hour)}
                      className={`w-full rounded-lg px-3 py-1.5 text-sm transition-colors ${
                        selectedHour === hour
                          ? 'bg-primary text-primary-foreground'
                          : 'hover:bg-muted'
                      }`}
                    >
                      {String(hour).padStart(2, '0')}
                    </button>
                  ))}
                </div>
              </div>
              <div className="flex-1">
                <p className="text-xs font-medium text-muted-foreground mb-2">Minute</p>
                <div className="max-h-40 overflow-y-auto space-y-1 pr-1">
                  {minutes.map((minute) => (
                    <button
                      key={minute}
                      type="button"
                      onClick={() => setSelectedMinute(minute)}
                      className={`w-full rounded-lg px-3 py-1.5 text-sm transition-colors ${
                        selectedMinute === minute
                          ? 'bg-primary text-primary-foreground'
                          : 'hover:bg-muted'
                      }`}
                    >
                      {String(minute).padStart(2, '0')}
                    </button>
                  ))}
                </div>
              </div>
              {format === '12h' && (
                <div className="flex flex-col gap-1">
                  <p className="text-xs font-medium text-muted-foreground mb-2">Period</p>
                  {['AM', 'PM'].map((period) => (
                    <button
                      key={period}
                      type="button"
                      onClick={() => setSelectedPeriod(period)}
                      className={`rounded-lg px-3 py-1.5 text-sm transition-colors ${
                        selectedPeriod === period
                          ? 'bg-primary text-primary-foreground'
                          : 'hover:bg-muted'
                      }`}
                    >
                      {period}
                    </button>
                  ))}
                </div>
              )}
            </div>
            <button
              type="button"
              disabled={selectedHour === null || selectedMinute === null}
              onClick={() => handleSelect(selectedHour, selectedMinute, selectedPeriod)}
              className="mt-4 w-full rounded-lg bg-primary text-primary-foreground px-4 py-2 text-sm font-medium hover:bg-primary/90 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
            >
              Apply
            </button>
          </div>
        )}
      </div>
      {error ? (
        <p className="mt-1.5 flex items-center gap-1 text-xs text-destructive" role="alert">
          <AlertCircle className="h-3.5 w-3.5" aria-hidden="true" />
          {error}
        </p>
      ) : helperText ? (
        <p className="mt-1.5 text-xs text-muted-foreground">{helperText}</p>
      ) : null}
    </div>
  );
};

export default TimePicker;
</file>

