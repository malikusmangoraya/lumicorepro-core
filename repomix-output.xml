@import './styles/globals.css';
@import './styles/animations.css';
@import './styles/rtl.css';

@tailwind base;
@tailwind components;
@tailwind utilities;

/* ── Base layer ─────────────────────────────────────────────────────── */
@layer base {
  * {
    border-color: hsl(var(--border));
    /* GPU-accelerated box-sizing everywhere */
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    /* Prevent layout shift from scrollbar appearing */
    overflow-y: scroll;
    /* Improve text rendering on all platforms */
    text-rendering: optimizeLegibility;
    -webkit-text-size-adjust: 100%;
  }

  body {
    @apply bg-background text-foreground font-sans antialiased;
    margin: 0;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    /* Prevent content from being painted outside visible area */
    overflow-x: hidden;
  }

  #root {
    @apply min-h-screen w-full;
    /* Isolate compositing layer for the whole app */
    isolation: isolate;
  }

  /* All images lazy-load and prevent layout shift */
  img {
    display: block;
    max-width: 100%;
    height: auto;
    /* Native lazy loading on all images */
    content-visibility: auto;
  }

  /* Focus styles — accessible but unobtrusive */
  :focus-visible {
    outline: 2px solid hsl(var(--primary));
    outline-offset: 2px;
    border-radius: 4px;
  }

  /* Reduce motion for users who prefer it */
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }

  /* ── Scrollbar ─────────────────────────────────────────────── */
  ::-webkit-scrollbar { width: 6px; height: 6px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb {
    background: hsl(var(--muted-foreground) / 0.25);
    border-radius: 9999px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: hsl(var(--primary) / 0.5);
  }

  /* Firefox scrollbar */
  * {
    scrollbar-width: thin;
    scrollbar-color: hsl(var(--muted-foreground) / 0.25) transparent;
  }

  /* ── Selection ─────────────────────────────────────────────── */
  ::selection {
    background: hsl(var(--primary) / 0.2);
    color: hsl(var(--foreground));
  }
}

/* ── Component layer ────────────────────────────────────────────────── */
@layer components {
  /* Buttons */
  .btn-primary {
    @apply inline-flex items-center justify-center gap-2
           bg-primary text-primary-foreground
           px-4 py-2 rounded-lg font-medium
           transition-all duration-200
           hover:bg-primary/90 hover:shadow-glow-sm
           active:scale-[0.98]
           focus-visible:outline-none focus-visible:ring-2
           focus-visible:ring-primary focus-visible:ring-offset-2
           disabled:opacity-50 disabled:pointer-events-none;
    /* GPU layer for button — prevents layout jank on hover */
    will-change: transform;
  }

  .btn-secondary {
    @apply inline-flex items-center justify-center gap-2
           bg-secondary text-secondary-foreground
           px-4 py-2 rounded-lg font-medium
           transition-all duration-200
           hover:bg-secondary/80 active:scale-[0.98];
  }

  /* Cards */
  .card {
    @apply bg-card border border-border rounded-xl shadow-sm p-6
           transition-all duration-200;
    will-change: transform;
  }
  .card-static {
    @apply bg-card border border-border rounded-xl shadow-sm p-6;
  }

  /* Inputs */
  .input {
    @apply w-full bg-background border border-border rounded-lg
           px-4 py-2 text-sm
           transition-colors duration-150
           focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary/50
           hover:border-primary/40
           placeholder:text-muted-foreground;
  }

  /* Layout */
  .container-custom {
    @apply max-w-7xl mx-auto px-4 sm:px-6 lg:px-8;
  }

  /* Glassmorphism */
  .glass {
    background: hsl(var(--card) / 0.6);
    backdrop-filter: blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    @apply border border-white/10 rounded-xl;
  }

  /* Gradient text */
  .gradient-text {
    @apply bg-gradient-to-r from-primary to-cyan-400 bg-clip-text text-transparent;
  }

  /* ── Interaction utilities ──────────────────────────────────── */
  .hover-lift {
    @apply transition-all duration-200;
    will-change: transform;
  }
  .hover-lift:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
  }

  .hover-scale {
    @apply transition-transform duration-200;
    will-change: transform;
  }
  .hover-scale:hover { transform: scale(1.04); }

  .hover-glow:hover {
    box-shadow: 0 0 20px hsl(var(--primary) / 0.35);
  }

  /* Page enter — used on route change */
  .page-enter { @apply animate-page-enter; }

  /* ── Lazy image with blur-up ────────────────────────────────── */
  .img-lazy {
    transition: filter 300ms ease, opacity 300ms ease;
    filter: blur(4px);
    opacity: 0.8;
  }
  .img-lazy.loaded {
    filter: blur(0);
    opacity: 1;
  }

  /* ── Content sections — GPU hinted ─────────────────────────── */
  .section-reveal {
    content-visibility: auto;
    contain-intrinsic-size: 0 400px;
  }

  /* ── Skeleton loader ────────────────────────────────────────── */
  .skeleton {
    @apply rounded-lg bg-muted;
    background: linear-gradient(
      90deg,
      hsl(var(--muted)) 25%,
      hsl(var(--muted-foreground) / 0.05) 50%,
      hsl(var(--muted)) 75%
    );
    background-size: 200% 100%;
    animation: skeleton-shimmer 1.5s ease-in-out infinite;
  }

  /* ── Animated gradient border ───────────────────────────────── */
  .border-glow {
    position: relative;
  }
  .border-glow::before {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    background: linear-gradient(
      135deg,
      hsl(var(--primary)),
      hsl(var(--primary) / 0.2),
      hsl(var(--primary))
    );
    background-size: 200% 200%;
    animation: gradient-border-spin 3s linear infinite;
    z-index: -1;
    opacity: 0.6;
  }
}

/* ── Keyframes not in Tailwind ──────────────────────────────────────── */
@keyframes skeleton-shimmer {
  0%   { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

@keyframes gradient-border-spin {
  0%   { background-position: 0% 50%; }
  50%  { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}
