        <div className="absolute inset-0 flex items-center p-8">
          <div className="flex items-center gap-6">
            <img src={img.portfolio.avatar} alt={profile.name}
              className="h-24 w-24 rounded-3xl object-cover border-2 border-primary/50 shadow-glow-sm shrink-0 hidden sm:block" />
            <div>
              <Badge variant="success" className="mb-2">✅ Available for work</Badge>
              <h2 className="font-display text-3xl font-bold text-white">{profile.name}</h2>
              <p className="text-primary font-medium mt-1">{profile.title}</p>
              <p className="text-white/70 text-sm mt-2 max-w-lg">{profile.bio}</p>
              <div className="flex flex-wrap gap-3 mt-3">
                <span className="flex items-center gap-1.5 text-xs text-white/60"><MapPin className="h-3.5 w-3.5 text-primary" />{profile.location}</span>
                <a href={`mailto:${profile.email}`} className="flex items-center gap-1.5 text-xs text-white/60 hover:text-primary transition-colors"><Mail className="h-3.5 w-3.5" />{profile.email}</a>
                <a href="#" className="flex items-center gap-1.5 text-xs text-white/60 hover:text-primary transition-colors"><Link2 className="h-3.5 w-3.5" />GitHub</a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div className="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
        {/* Skills */}
