<file path="docker-compose.prod.yml">
# ============================================================
# LumicorePro — Production Docker Compose
# ============================================================
# Usage:
#   cp .env.example .env.production
#   docker-compose -f docker-compose.prod.yml up -d --build
#
# Includes: Nginx (SSL termination), Frontend, Backend, PostgreSQL,
#           Redis, Certbot (auto-renew Let's Encrypt)
# ============================================================

version: "3.9"

x-restart: &default-restart
  restart: unless-stopped

x-logging: &default-logging
  logging:
    driver: "json-file"
    options:
      max-size: "10m"
      max-file: "3"

services:

  # ── PostgreSQL ──────────────────────────────────────────────────
  db:
    image: postgres:16-alpine
    container_name: lumicorepro-db
    <<: [*default-restart, *default-logging]
    environment:
      POSTGRES_DB:       ${POSTGRES_DB:-lumicorepro_db}
      POSTGRES_USER:     ${POSTGRES_USER:-lumicore}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?DB password required}
      PGDATA:            /var/lib/postgresql/data/pgdata
    volumes:
      - postgres_data:/var/lib/postgresql/data
      - ./database/schema.sql:/docker-entrypoint-initdb.d/01-schema.sql:ro
    ports:
      - "127.0.0.1:5432:5432"          # Bind to loopback only — not public
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-lumicore} -d ${POSTGRES_DB:-lumicorepro_db}"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 30s
    networks:
      - lumicore-net

  # ── Redis (caching + session + Bull queues) ─────────────────────
  redis:
    image: redis:7-alpine
    container_name: lumicorepro-redis
    <<: [*default-restart, *default-logging]
    command: redis-server --requirepass ${REDIS_PASSWORD:?Redis password required} --maxmemory 256mb --maxmemory-policy allkeys-lru
    ports:
      - "127.0.0.1:6379:6379"
    volumes:
      - redis_data:/data
    healthcheck:
      test: ["CMD", "redis-cli", "-a", "${REDIS_PASSWORD}", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5
    networks:
      - lumicore-net

  # ── Backend API ─────────────────────────────────────────────────
  backend:
    build:
      context: ./backend
      dockerfile: Dockerfile
      target: production
    container_name: lumicorepro-api
    <<: [*default-restart, *default-logging]
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_healthy
    environment:
      NODE_ENV:             production
      PORT:                 5000
      MONGODB_URI:          ${MONGODB_URI}
      DATABASE_URL:         postgresql://${POSTGRES_USER:-lumicore}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB:-lumicorepro_db}
      JWT_SECRET:           ${JWT_SECRET:?JWT secret required}
      JWT_EXPIRES_IN:       ${JWT_EXPIRES_IN:-7d}
      STRIPE_SECRET_KEY:    ${STRIPE_SECRET_KEY}
      STRIPE_WEBHOOK_SECRET:${STRIPE_WEBHOOK_SECRET}
      REDIS_URL:            redis://:${REDIS_PASSWORD}@redis:6379
      SENTRY_DSN:           ${SENTRY_DSN}
      FRONTEND_URL:         ${FRONTEND_URL:-https://lumicorepro.com}
      CORS_ORIGIN:          ${FRONTEND_URL:-https://lumicorepro.com}
      SMTP_HOST:            ${SMTP_HOST}
      SMTP_PORT:            ${SMTP_PORT:-587}
      SMTP_USER:            ${SMTP_USER}
      SMTP_PASS:            ${SMTP_PASS}
      FROM_EMAIL:           ${FROM_EMAIL:-noreply@lumicorepro.com}
    expose:
      - "5000"
    volumes:
      - backend_uploads:/app/uploads
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://localhost:5000/api/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s
    networks:
      - lumicore-net
    deploy:
      resources:
        limits:
          cpus: "1"
          memory: 512M
        reservations:
          cpus: "0.25"
          memory: 128M

  # ── Frontend (Nginx serving built React app) ────────────────────
  frontend:
    build:
      context: .
      dockerfile: Dockerfile.frontend
      args:
        VITE_API_URL:       ${VITE_API_URL:-https://api.lumicorepro.com}
        VITE_STRIPE_KEY:    ${STRIPE_PUBLISHABLE_KEY}
        VITE_APP_ENV:       production
    container_name: lumicorepro-web
    <<: [*default-restart, *default-logging]
    depends_on:
      backend:
        condition: service_healthy
    expose:
      - "80"
    networks:
      - lumicore-net

  # ── Nginx Reverse Proxy + SSL Termination ───────────────────────
  nginx:
    image: nginx:1.27-alpine
    container_name: lumicorepro-nginx
    <<: [*default-restart, *default-logging]
    depends_on:
      - frontend
      - backend
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./nginx/nginx.conf:/etc/nginx/nginx.conf:ro
      - ./nginx/conf.d:/etc/nginx/conf.d:ro
      - ./ssl/certs:/etc/letsencrypt:ro
      - certbot_www:/var/www/certbot:ro
    networks:
      - lumicore-net

  # ── Certbot (Let's Encrypt auto-renewal) ───────────────────────
  certbot:
    image: certbot/certbot:latest
    container_name: lumicorepro-certbot
    volumes:
      - ./ssl/certs:/etc/letsencrypt
      - certbot_www:/var/www/certbot
    entrypoint: >
      /bin/sh -c "trap exit TERM;
      while :; do
        certbot renew --webroot -w /var/www/certbot --quiet;
        sleep 12h & wait $${!};
      done"
    networks:
      - lumicore-net

  # ── Adminer (DB GUI — disable in strict production) ─────────────
  adminer:
    image: adminer:4-standalone
    container_name: lumicorepro-adminer
    restart: "no"
    profiles: ["debug"]          # Only starts with: --profile debug
    ports:
      - "127.0.0.1:8080:8080"
    environment:
      ADMINER_DEFAULT_SERVER: db
    networks:
      - lumicore-net

volumes:
  postgres_data:    { name: lumicorepro-postgres }
  redis_data:       { name: lumicorepro-redis }
  backend_uploads:  { name: lumicorepro-uploads }
  certbot_www:      { name: lumicorepro-certbot-www }

networks:
  lumicore-net:
    driver: bridge
    name: lumicorepro-network
</file>

<file path="docker-compose.yml">
version: '3.8'

services:
  # MongoDB Database
  mongodb:
    image: mongo:7
    container_name: lumicorepro-mongo
    restart: unless-stopped
    environment:
      MONGO_INITDB_ROOT_USERNAME: admin
      MONGO_INITDB_ROOT_PASSWORD: password
      MONGO_INITDB_DATABASE: lumicorepro
    ports:
      - "27017:27017"
    volumes:
      - mongodb_data:/data/db
      - ./database/schemas:/docker-entrypoint-initdb.d
    networks:
      - lumicorepro-network

  # Redis Cache
  redis:
    image: redis:7-alpine
    container_name: lumicorepro-redis
    restart: unless-stopped
    ports:
      - "6379:6379"
    volumes:
      - redis_data:/data
    networks:
      - lumicorepro-network

  # Backend API Server
  backend:
    build:
      context: ./backend
      dockerfile: Dockerfile
    container_name: lumicorepro-backend
    restart: unless-stopped
    environment:
      - NODE_ENV=production
      - PORT=5000
      - MONGODB_URI=mongodb://admin:password@mongodb:27017/lumicorepro?authSource=admin
      - REDIS_URL=redis://redis:6379
      - JWT_SECRET=${JWT_SECRET}
      - STRIPE_SECRET_KEY=${STRIPE_SECRET_KEY}
    ports:
      - "5000:5000"
    depends_on:
      - mongodb
      - redis
    volumes:
      - ./backend:/app
      - /app/node_modules
    networks:
      - lumicorepro-network

  # Frontend Development Server
  frontend:
    build:
      context: .
      dockerfile: Dockerfile.frontend
    container_name: lumicorepro-frontend
    restart: unless-stopped
    ports:
      - "5173:5173"
    environment:
      - VITE_API_URL=http://backend:5000
    depends_on:
      - backend
    volumes:
      - .:/app
      - /app/node_modules
    networks:
      - lumicorepro-network

  # Nginx Reverse Proxy
  nginx:
    image: nginx:alpine
    container_name: lumicorepro-nginx
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./nginx/nginx.conf:/etc/nginx/nginx.conf
      - ./nginx/ssl:/etc/nginx/ssl
    depends_on:
      - frontend
      - backend
    networks:
      - lumicorepro-network

  # Elasticsearch (for search functionality)
  elasticsearch:
    image: docker.elastic.co/elasticsearch/elasticsearch:8.12.0
    container_name: lumicorepro-elasticsearch
    restart: unless-stopped
    environment:
      - discovery.type=single-node
      - xpack.security.enabled=false
      - "ES_JAVA_OPTS=-Xms512m -Xmx512m"
    ports:
      - "9200:9200"
    volumes:
      - elasticsearch_data:/usr/share/elasticsearch/data
    networks:
      - lumicorepro-network

  # Kibana (for analytics & monitoring)
  kibana:
    image: docker.elastic.co/kibana/kibana:8.12.0
    container_name: lumicorepro-kibana
    restart: unless-stopped
    ports:
      - "5601:5601"
    environment:
      - ELASTICSEARCH_HOSTS=http://elasticsearch:9200
    depends_on:
      - elasticsearch
    networks:
      - lumicorepro-network

networks:
  lumicorepro-network:
    driver: bridge

volumes:
  mongodb_data:
  redis_data:
  elasticsearch_data:
</file>

<file path="Dockerfile.frontend">
# ---- Base Node Stage ----
FROM node:20-alpine AS base
WORKDIR /app
COPY package*.json ./
RUN npm ci --no-audit --no-fund
COPY . .

# ---- Development Stage (Default for docker-compose dev) ----
FROM base AS development
EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]

# ---- Production Build Stage ----
FROM base AS build
RUN npm run build

# ---- Production Serve Stage ----
FROM nginx:alpine AS production
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
</file>

