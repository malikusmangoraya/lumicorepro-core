<file path="src/components/forms/DatePicker.jsx">
import React, { useState, useRef, useEffect } from 'react';
import { Calendar, ChevronLeft, ChevronRight, AlertCircle } from 'lucide-react';

const DatePicker = ({
  label,
  value,
  onChange,
  error,
  helperText,
  required = false,
  disabled = false,
  minDate,
  maxDate,
  placeholder = 'Select date',
  className = '',
  id,
  ...props
}) => {
  const [open, setOpen] = useState(false);
  const [viewDate, setViewDate] = useState(value ? new Date(value) : new Date());
  const containerRef = useRef(null);
  const inputId = id || `datepicker-${Math.random().toString(36).substr(2, 9)}`;

  useEffect(() => {
    const handleClickOutside = (e) => {
      if (containerRef.current && !containerRef.current.contains(e.target)) {
        setOpen(false);
      }
    };
    document.addEventListener('mousedown', handleClickOutside);
    return () => document.removeEventListener('mousedown', handleClickOutside);
  }, []);

  const formatDate = (date) => {
    if (!date) return '';
    return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
  };

  const getDaysInMonth = (year, month) => {
    return new Date(year, month + 1, 0).getDate();
  };

  const getFirstDayOfMonth = (year, month) => {
    return new Date(year, month, 1).getDay();
  };

  const isDisabled = (date) => {
    if (minDate && date < new Date(minDate).setHours(0, 0, 0, 0)) return true;
    if (maxDate && date > new Date(maxDate).setHours(23, 59, 59, 999)) return true;
    return false;
  };

  const isSelected = (date) => {
    if (!value) return false;
    const selected = new Date(value);
    return date.toDateString() === selected.toDateString();
  };

  const isToday = (date) => {
    return date.toDateString() === new Date().toDateString();
  };

  const handleSelect = (date) => {
    onChange?.(date.toISOString());
    setOpen(false);
  };

  const changeMonth = (delta) => {
    setViewDate(new Date(viewDate.getFullYear(), viewDate.getMonth() + delta, 1));
  };

  const year = viewDate.getFullYear();
  const month = viewDate.getMonth();
  const daysInMonth = getDaysInMonth(year, month);
  const firstDay = getFirstDayOfMonth(year, month);
  const days = [];

  for (let i = 0; i < firstDay; i++) days.push(null);
  for (let i = 1; i <= daysInMonth; i++) days.push(new Date(year, month, i));

  const monthNames = [
    'January', 'February', 'March', 'April', 'May', 'June',
    'July', 'August', 'September', 'October', 'November', 'December',
  ];
  const dayNames = ['Su', 'Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa'];

  return (
    <div className={`w-full ${className}`} ref={containerRef}>
      {label && (
        <label htmlFor={inputId} className="mb-1.5 block text-sm font-medium text-foreground">
          {label}
          {required && <span className="ml-0.5 text-destructive" aria-hidden="true">*</span>}
        </label>
      )}
      <div className="relative">
        <button
          type="button"
          id={inputId}
          disabled={disabled}
          onClick={() => setOpen(!open)}
          aria-haspopup="dialog"
          aria-expanded={open}
          aria-invalid={!!error}
          className={`w-full rounded-lg border bg-background px-4 py-2.5 text-sm text-left transition-all focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-between gap-2 ${
            error ? 'border-destructive focus:ring-destructive' : 'border-border hover:border-muted-foreground/30'
          }`}
        >
          <span className={value ? '' : 'text-muted-foreground'}>
            {value ? formatDate(new Date(value)) : placeholder}
          </span>
          <Calendar className="h-4 w-4 text-muted-foreground shrink-0" aria-hidden="true" />
        </button>

        {open && (
          <div className="absolute z-50 mt-2 w-72 rounded-xl border border-border bg-card shadow-lg p-4 animate-in fade-in zoom-in-95">
            <div className="flex items-center justify-between mb-4">
              <button
                type="button"
                onClick={() => changeMonth(-1)}
                className="rounded-lg p-1.5 hover:bg-muted transition-colors"
                aria-label="Previous month"
              >
                <ChevronLeft className="h-4 w-4" />
              </button>
              <span className="text-sm font-medium">
                {monthNames[month]} {year}
              </span>
              <button
                type="button"
                onClick={() => changeMonth(1)}
                className="rounded-lg p-1.5 hover:bg-muted transition-colors"
                aria-label="Next month"
              >
                <ChevronRight className="h-4 w-4" />
              </button>
            </div>

            <div className="grid grid-cols-7 gap-1 mb-2">
              {dayNames.map((day) => (
                <span key={day} className="text-center text-xs font-medium text-muted-foreground">
                  {day}
                </span>
              ))}
            </div>

            <div className="grid grid-cols-7 gap-1">
              {days.map((date, index) => {
                if (!date) return <span key={`empty-${index}`} />;
                const disabled = isDisabled(date);
                const selected = isSelected(date);
                const today = isToday(date);
                return (
                  <button
                    key={date.toISOString()}
                    type="button"
                    disabled={disabled}
                    onClick={() => handleSelect(date)}
                    className={`h-8 w-8 rounded-lg text-sm transition-colors flex items-center justify-center ${
                      selected
                        ? 'bg-primary text-primary-foreground font-medium'
                        : disabled
                        ? 'text-muted-foreground/30 cursor-not-allowed'
                        : today
                        ? 'text-primary font-medium hover:bg-primary/10'
                        : 'hover:bg-muted'
                    }`}
                  >
                    {date.getDate()}
                  </button>
                );
              })}
            </div>
          </div>
        )}
      </div>
      {error ? (
        <p className="mt-1.5 flex items-center gap-1 text-xs text-destructive" role="alert">
          <AlertCircle className="h-3.5 w-3.5" aria-hidden="true" />
          {error}
        </p>
      ) : helperText ? (
        <p className="mt-1.5 text-xs text-muted-foreground">{helperText}</p>
      ) : null}
    </div>
  );
};

export default DatePicker;
</file>

<file path="src/components/forms/FileUpload.jsx">
import React, { useState, useRef } from 'react';
import { Upload, X, File, AlertCircle } from 'lucide-react';

const FileUpload = ({
  label,
  value,
  onChange,
  error,
  helperText,
  required = false,
  disabled = false,
  multiple = false,
  accept,
  maxSize,
  maxFiles,
  dragDrop = true,
  className = '',
  id,
  ...props
}) => {
  const [dragOver, setDragOver] = useState(false);
  const [files, setFiles] = useState(value || []);
  const inputRef = useRef(null);
  const inputId = id || `fileupload-${Math.random().toString(36).substr(2, 9)}`;

  const handleFiles = (fileList) => {
    const newFiles = Array.from(fileList);
    let validFiles = newFiles;

    if (maxSize) {
      validFiles = validFiles.filter((file) => file.size <= maxSize);
    }
    if (maxFiles) {
      validFiles = validFiles.slice(0, maxFiles - files.length);
    }

    const updated = multiple ? [...files, ...validFiles] : validFiles;
    setFiles(updated);
    onChange?.(updated);
  };

  const removeFile = (index) => {
    const updated = files.filter((_, i) => i !== index);
    setFiles(updated);
    onChange?.(updated);
  };

  const formatSize = (bytes) => {
    if (bytes < 1024) return `${bytes} B`;
    if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
    return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
  };

  return (
    <div className={`w-full ${className}`}>
      {label && (
        <label htmlFor={inputId} className="mb-1.5 block text-sm font-medium text-foreground">
          {label}
          {required && <span className="ml-0.5 text-destructive" aria-hidden="true">*</span>}
        </label>
      )}

      <input
        ref={inputRef}
        id={inputId}
        type="file"
        multiple={multiple}
        accept={accept}
        disabled={disabled}
        onChange={(e) => handleFiles(e.target.files)}
        className="sr-only"
        {...props}
      />

      {dragDrop ? (
        <button
          type="button"
          disabled={disabled}
          onClick={() => inputRef.current?.click()}
          onDragOver={(e) => {
            e.preventDefault();
            setDragOver(true);
          }}
          onDragLeave={() => setDragOver(false)}
          onDrop={(e) => {
            e.preventDefault();
            setDragOver(false);
            handleFiles(e.dataTransfer.files);
          }}
          className={`w-full rounded-xl border-2 border-dashed p-8 text-center transition-all ${
            dragOver
              ? 'border-primary bg-primary/5'
              : 'border-border hover:border-muted-foreground/40'
          } ${disabled ? 'opacity-50 cursor-not-allowed' : 'cursor-pointer'}`}
        >
          <Upload className="mx-auto h-8 w-8 text-muted-foreground mb-2" aria-hidden="true" />
          <p className="text-sm font-medium text-foreground">
            {dragOver ? 'Drop files here' : 'Drag & drop files or click to browse'}
          </p>
          <p className="mt-1 text-xs text-muted-foreground">
            {accept ? `Accepted: ${accept}` : 'Any file type'}
            {maxSize && ` · Max: ${formatSize(maxSize)}`}
          </p>
        </button>
      ) : (
        <button
          type="button"
          disabled={disabled}
          onClick={() => inputRef.current?.click()}
          className="w-full rounded-lg border border-border bg-background px-4 py-2.5 text-sm font-medium hover:bg-muted transition-colors flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed"
        >
          <Upload className="h-4 w-4" aria-hidden="true" />
          Browse files
        </button>
      )}

      {files.length > 0 && (
        <ul className="mt-3 space-y-2">
          {files.map((file, index) => (
            <li
              key={`${file.name}-${index}`}
              className="flex items-center gap-3 rounded-lg border border-border bg-card p-3"
            >
              <File className="h-5 w-5 text-muted-foreground shrink-0" aria-hidden="true" />
              <div className="flex-1 min-w-0">
                <p className="text-sm font-medium truncate">{file.name}</p>
                <p className="text-xs text-muted-foreground">{formatSize(file.size)}</p>
              </div>
              <button
                type="button"
                onClick={() => removeFile(index)}
                className="rounded-lg p-1.5 hover:bg-muted transition-colors"
                aria-label={`Remove ${file.name}`}
              >
                <X className="h-4 w-4" />
              </button>
            </li>
          ))}
        </ul>
      )}

      {error ? (
        <p className="mt-1.5 flex items-center gap-1 text-xs text-destructive" role="alert">
          <AlertCircle className="h-3.5 w-3.5" aria-hidden="true" />
          {error}
        </p>
      ) : helperText ? (
        <p className="mt-1.5 text-xs text-muted-foreground">{helperText}</p>
      ) : null}
    </div>
  );
};

export default FileUpload;
</file>

