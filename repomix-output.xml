        <div className="flex items-center justify-between mb-4">
          <h3 className="font-display text-lg font-bold">Our Work</h3>
          <div className="flex flex-wrap gap-2">
            {categories.map(cat => (
              <button key={cat} onClick={() => setActiveCategory(cat)}
                className={cn('px-3 py-1 rounded-full text-xs font-medium transition-all',
                  activeCategory === cat ? 'bg-violet-500/20 text-violet-400 border border-violet-500/40' : 'bg-card border border-border text-muted-foreground hover:border-violet-500/30'
