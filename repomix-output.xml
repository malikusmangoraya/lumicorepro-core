        {stats.map((s, i) => (
          <Card key={i} animate="fade-up" animationDelay={i * 60} padding="sm" className="text-center hover-lift">
            <p className="font-display text-2xl font-bold bg-gradient-to-r from-pink-400 to-violet-400 bg-clip-text text-transparent">{s.value}</p>
            <p className="text-xs text-muted-foreground mt-1">{s.label}</p>
          </Card>
        ))}
      </div>

      {/* Services */}
      <div className="mb-8">
        <h3 className="font-display text-lg font-bold mb-4">What We Do</h3>
        <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
          {services.map((svc, i) => {
            const Icon = serviceIcons[svc.icon] || Palette;
            return (
              <Card key={i} animate="fade-up" animationDelay={i * 70} className="hover-lift cursor-pointer group">
                <div className="mb-3 h-12 w-12 rounded-xl bg-gradient-to-br from-pink-500/15 to-violet-500/15 flex items-center justify-center group-hover:scale-110 transition-transform">
                  <Icon className="h-6 w-6 text-violet-400" />
                </div>
                <h3 className="font-semibold text-sm">{svc.title}</h3>
                <p className="text-xs text-muted-foreground mt-1">{svc.desc}</p>
              </Card>
            );
