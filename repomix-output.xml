<file path="src/components/navigation/MobileMenu.jsx">
import React, { useState, useEffect } from 'react';
import { Menu, X } from 'lucide-react';

const MobileMenu = ({
  items = [],
  activeItem,
  onItemClick,
  onClose,
  trigger,
  position = 'left',
  width = 'w-72',
  className = '',
  ...props
}) => {
  const [open, setOpen] = useState(false);

  useEffect(() => {
    const handleEscape = (e) => {
      if (e.key === 'Escape') setOpen(false);
    };
    if (open) {
      document.addEventListener('keydown', handleEscape);
      document.body.style.overflow = 'hidden';
    }
    return () => {
      document.removeEventListener('keydown', handleEscape);
      document.body.style.overflow = '';
    };
  }, [open]);

  const handleClose = () => {
    setOpen(false);
    onClose?.();
  };

  const handleItemClick = (item) => {
    onItemClick?.(item);
    handleClose();
  };

  return (
    <>
      {trigger ? (
        React.cloneElement(trigger, {
          onClick: () => setOpen(!open),
          'aria-expanded': open,
          'aria-label': open ? 'Close menu' : 'Open menu',
        })
      ) : (
        <button
          type="button"
          onClick={() => setOpen(!open)}
          className="rounded-lg p-2 hover:bg-muted transition-colors"
          aria-label={open ? 'Close menu' : 'Open menu'}
          aria-expanded={open}
        >
          {open ? <X className="h-5 w-5" /> : <Menu className="h-5 w-5" />}
        </button>
      )}

      {open && (
        <div className="fixed inset-0 z-50 lg:hidden" {...props}>
          <div
            className="absolute inset-0 bg-black/50 backdrop-blur-sm"
            onClick={handleClose}
            aria-hidden="true"
          />
          <aside
            className={`absolute top-0 h-full ${width} bg-card shadow-xl transition-transform ${
              position === 'left' ? 'left-0' : 'right-0'
            } ${className}`}
            role="dialog"
            aria-modal="true"
            aria-label="Mobile menu"
          >
            <div className="flex items-center justify-between p-4 border-b border-border">
              <span className="font-semibold">Menu</span>
              <button
                type="button"
                onClick={handleClose}
                className="rounded-lg p-1.5 hover:bg-muted transition-colors"
                aria-label="Close menu"
              >
                <X className="h-5 w-5" />
              </button>
            </div>
            <nav className="p-3 space-y-1 overflow-y-auto max-h-[calc(100vh-4rem)]" aria-label="Mobile navigation">
              {items.map((item, index) => (
                <button
                  key={item.label || index}
                  type="button"
                  onClick={() => handleItemClick(item)}
                  className={`flex w-full items-center gap-2 rounded-lg px-3 py-2.5 text-sm font-medium transition-colors ${
                    activeItem === item.label || activeItem === item.href
                      ? 'bg-primary/10 text-primary'
                      : 'text-muted-foreground hover:text-foreground hover:bg-muted'
                  }`}
                  aria-current={activeItem === item.label ? 'page' : undefined}
                >
                  {item.icon && <item.icon className="h-4 w-4 shrink-0" aria-hidden="true" />}
                  <span className="flex-1 text-left">{item.label}</span>
                  {item.badge && (
                    <span className="rounded-full bg-primary/10 px-2 py-0.5 text-xs font-medium text-primary">
                      {item.badge}
                    </span>
                  )}
                </button>
              ))}
            </nav>
          </aside>
        </div>
      )}
    </>
  );
};

export default MobileMenu;
</file>

