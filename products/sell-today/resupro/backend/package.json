{
  "name": "resupro-backend",
  "version": "1.0.0",
  "description": "Full-stack REST API backend for production services",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "docs": "node generate-docs.js",
    "migrate": "node migrate.js",
    "migrate:down": "node migrate.js down",
    "migrate:status": "node -e \"require('./migrate.js').executed().then(e=>console.log(e.map(x=>x.name).join('\\n'))||console.log('none'))\"",
    "audit": "npm audit --omit=dev",
    "backup": "node scripts/backup.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "express-validator": "^7.0.1",
    "morgan": "^1.10.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.1",
    "awilix": "^8.0.1",
    "bullmq": "^5.12.0",
    "ioredis": "^5.4.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.14",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.13.1",
    "rate-limit-redis": "^4.2.0",
    "react-turnstile": "^1.0.0",
    "sequelize": "^6.37.5",
    "stripe": "^16.12.0",
    "winston": "^3.15.0",
    "zod": "^3.23.8",
    "redis": "^5.4.1",
    "sqlite3": "^5.1.7",
    "umzug": "^3.4.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.3",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "swagger-ui-express": "^5.0.0",
    "swagger-jsdoc": "^6.2.8",
    "cross-env": "^7.0.3"
  }
}
