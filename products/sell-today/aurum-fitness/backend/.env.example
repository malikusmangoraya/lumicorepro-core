# Environment template — copy to .env and fill in the blanks.
#
#   cp .env.example .env
#
# Never commit a real .env. Only keys prefixed with VITE_ reach the browser;
# everything else stays on the server. Secrets are left blank on purpose — a
# value that looks like a working credential is how credentials leak.
#
# Generate a secret:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"


# -------------------------------------------------------------------------
# Backend — server only, never exposed to the browser
# -------------------------------------------------------------------------


# -------------------------------------------------------------------------
# Core server
# Where the API listens and what it trusts.
# -------------------------------------------------------------------------

# development | production | test
NODE_ENV=development

# API port
PORT=5000

# Mount point for every route
API_PREFIX=/api

# Absolute backend URL, e.g. https://api.example.com
BASE_URL=

# Public backend origin
BACKEND_URL=http://localhost:5000

# Public frontend origin
FRONTEND_URL=http://localhost:5173

# Product name shown in emails and logs
APP_BRAND=

# Sending domain, e.g. example.com
APP_DOMAIN=

# Set to any value for verbose development output
DEV=

# Set to any value to mark a production process
PROD=

# error | warn | info | debug
LOG_LEVEL=info

# Where multer writes uploaded files
UPLOAD_DIR=./uploads

# Upload size limit in megabytes
MAX_FILE_SIZE=5

# Express JSON body limit
JSON_BODY_LIMIT=2mb

# Comma-separated allow-list
CORS_ORIGIN=http://localhost:5173

# Comma-separated allow-list; takes precedence over CORS_ORIGIN
ALLOWED_ORIGINS=http://localhost:5173

# Optional comma-separated keys required in the x-api-key header
VALID_API_KEYS=

# Shared secret for internal service-to-service webhooks
INTERNAL_WEBHOOK_SECRET=

# Comma-separated webhook URLs to fan out to
WEBHOOK_ENDPOINTS=

# Body limit for inbound webhooks
WEBHOOK_BODY_LIMIT=1mb

# Fallback currency before a locale is known
DEFAULT_CURRENCY=USD

# Comma-separated list of gateways to enable, or all. A gateway left out here is never mounted, and its keys are ignored
PAYMENT_GATEWAYS_ENABLED=stripe,paypal,lemonsqueezy


# -------------------------------------------------------------------------
# Database
# PostgreSQL is the production database. Leave DATABASE_URL empty to fall back to a local SQLite file for demos.
# -------------------------------------------------------------------------

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:REPLACE_WITH_A_STRONG_PASSWORD@localhost:5432/app_db

DB_HOST=localhost

DB_PORT=5432

DB_NAME=app_db

DB_USER=postgres

DB_PASSWORD=

# Set to true for managed PostgreSQL that requires TLS
DB_SSL=

# Sequelize connection pool size
DB_POOL_MAX=10

# Sequelize minimum pool size
DB_POOL_MIN=0

# Idle timeout before a connection is released
DB_POOL_IDLE_MS=10000

# How long a request waits for a free connection
DB_POOL_ACQUIRE_MS=10000

# Let Sequelize alter the schema on boot. Development only — use migrations in production
DB_SYNC_ALTER=false


# -------------------------------------------------------------------------
# Cache and queues
# Redis backs the cache, the rate limiter and the job queue. The app degrades to in-memory cache when Redis is absent.
# -------------------------------------------------------------------------

REDIS_URL=redis://localhost:6379

# Set true to force the in-memory cache even when Redis is reachable
REDIS_DISABLED=false


# -------------------------------------------------------------------------
# Authentication tokens
# Generate each secret with `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`. The server refuses to start if JWT_SECRET is missing, short or a known placeholder.
# -------------------------------------------------------------------------

# REQUIRED. Minimum 32 characters
JWT_SECRET=

# Signing key for refresh tokens. Defaults to JWT_SECRET if blank
JWT_REFRESH_SECRET=

# Access token lifetime
JWT_EXPIRE=15m

# Access token lifetime (alternative key)
JWT_EXPIRES_IN=15m

# Refresh token lifetime
JWT_REFRESH_EXPIRE=30d

# Password hashing cost factor
BCRYPT_ROUNDS=12


# -------------------------------------------------------------------------
# OAuth social login
# Optional. Leave blank to disable Google or GitHub sign-in. Redirect URIs are <BACKEND_URL>/api/auth/google/callback and /api/auth/github/callback.
# -------------------------------------------------------------------------

GOOGLE_CLIENT_ID=

GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=

GITHUB_CLIENT_SECRET=

# Where to land after social sign-in
OAUTH_SUCCESS_REDIRECT=

# Where to land after a failed sign-in
OAUTH_FAILURE_REDIRECT=


# -------------------------------------------------------------------------
# Transactional email
# SMTP credentials for verification, password reset and receipt email. Without them those emails log to the console.
# -------------------------------------------------------------------------

# e.g. smtp.postmarkapp.com
SMTP_HOST=

SMTP_PORT=587

SMTP_USER=

SMTP_PASS=

# true for implicit TLS on port 465
SMTP_SECURE=false

# Sender address; defaults to APP_DOMAIN
EMAIL_FROM_ADDRESS=

# Sender display name; defaults to APP_BRAND
EMAIL_FROM_NAME=


# -------------------------------------------------------------------------
# Frontend origin
# Used for CORS, payment redirects and links inside emails.
# -------------------------------------------------------------------------


# -------------------------------------------------------------------------
# AI provider
# Optional. Used by the AI routes and the usage guard. No AI key means the AI endpoints answer with a clear 'not configured'.
# -------------------------------------------------------------------------

# gemini | openai | anthropic | mistral | deepseek | openrouter | none
ACTIVE_AI_PROVIDER=gemini

# Python AI agent service, when one is running
AI_AGENT_URL=http://localhost:8000

GEMINI_API_KEY=

OPENAI_API_KEY=

ANTHROPIC_API_KEY=

MISTRAL_API_KEY=

DEEPSEEK_API_KEY=

OPENROUTER_API_KEY=

# Simultaneous AI requests per instance
AI_MAX_CONCURRENT=2

AI_MAX_TOKENS_CHAT=1024

AI_MAX_TOKENS_GENERATION=4096

AI_MAX_TOKENS_VISION=1024

# Used to estimate cost, not a hard cap
AI_AVG_TOKENS_CHAT=2500

# Used to estimate cost, not a hard cap
AI_AVG_TOKENS_GENERATION=18000

# Used to estimate cost, not a hard cap
AI_AVG_TOKENS_VISION=1200

# USD per 1000 tokens, for the budget guard
AI_TOKEN_COST_PER_1K=0.02

# Hard token cap; 0 means unlimited
AI_TOKEN_BUDGET=0

# Requests per day; 0 means unlimited
AI_DAILY_CHAT_LIMIT=0

# Requests per day; 0 means unlimited
AI_DAILY_GEN_LIMIT=0

# Requests per day; 0 means unlimited
AI_DAILY_VISION_LIMIT=0

# Spend cap in USD per week; 0 means unlimited
AI_WEEKLY_BUDGET=0

# Client-side circuit breaker threshold
AI_CB_MAX_REQUESTS=10

# How long the circuit breaker stays open
AI_CB_BLOCK_SECS=60

# JSON override of the plan usage limits
USAGE_LIMITS=


# -------------------------------------------------------------------------
# Security services
# Cloudflare Turnstile CAPTCHA and Sentry error reporting. Both optional.
# -------------------------------------------------------------------------

TURNSTILE_ENABLED=false

# Public site key, exposed to the browser
TURNSTILE_SITE_KEY=

# Server-side verification key
TURNSTILE_SECRET_KEY=

# Blank disables error reporting
SENTRY_DSN=

# Fraction of transactions traced
SENTRY_TRACES_SAMPLE_RATE=0.2


# -------------------------------------------------------------------------
# Licensing
# Optional self-hosted licence gate. Blank disables the check entirely.
# -------------------------------------------------------------------------

# Product key this deployment validates
LICENSE_PRODUCT=

# Shared secret used to sign licence keys
LICENSE_SECRET=

LICENSE_TRIAL_DAYS=14


# -------------------------------------------------------------------------
# Demo seed
# Creates fixed-credential demo users for the live demo. ALWAYS skipped when NODE_ENV=production, and additionally requires both ENABLE_DEMO_SEED=true and a DEMO_USER_PASSWORD.
# -------------------------------------------------------------------------

# Both this and DEMO_USER_PASSWORD must be set to seed demo users
ENABLE_DEMO_SEED=false

# Shows demo banners in the UI
DEMO_MODE=false

DEMO_USER_EMAIL=demo@example.com

# Leave blank to keep the seed disabled
DEMO_USER_PASSWORD=

DEMO_USER_NAME=Demo User

DEMO_ADMIN_EMAIL=admin@example.com

DEMO_ADMIN_NAME=Admin User


# -------------------------------------------------------------------------
# Rate limits and body size
# Applied globally, with stricter per-route limits on auth and AI.
# -------------------------------------------------------------------------

# Rate limit window, 15 minutes
RATE_LIMIT_WINDOW_MS=900000

# Requests per window per IP
RATE_LIMIT_MAX=100

# Requests per window per IP
RATE_LIMIT_MAX_REQUESTS=100


# -------------------------------------------------------------------------
# Audit log
# Every admin mutation is written to the audit log. Set AUDIT_LOG=false to disable.
# -------------------------------------------------------------------------

AUDIT_LOG=true

# Ignored when AUDIT_LOG_STDOUT is on
AUDIT_LOG_FILE=./audit.log

# Write the audit log to stdout, for containers
AUDIT_LOG_STDOUT=true


# -------------------------------------------------------------------------
# Waitlist
# Optional pre-launch gate for contact and register forms.
# -------------------------------------------------------------------------

# off | collect | gate
WAITLIST_MODE=off

# 0 approves every signup
WAITLIST_AUTO_APPROVE_DAILY=0


# -------------------------------------------------------------------------
# Payment gateways
#
# Every gateway is optional. A gateway that is not listed in
# PAYMENT_GATEWAYS_ENABLED is never mounted, so its keys stay unused.
# -------------------------------------------------------------------------


# Lemon Squeezy — merchant of record, so tax and VAT are handled for you. Overlay checkout needs only the store id; an API key additionally enables server-side checkout creation. Webhook: /api/lemonsqueezy/webhook
LEMONSQUEEZY_STORE_ID=

LEMONSQUEEZY_STORE_URL=

# Enables server-side checkout creation
LEMONSQUEEZY_API_KEY=

# Verifies /api/lemonsqueezy/webhook
LEMONSQUEEZY_WEBHOOK_SECRET=

# Single-variant products
LEMONSQUEEZY_VARIANT_ID=

# Pricing tier 1
LEMONSQUEEZY_VARIANT_STARTER=

# Pricing tier 2
LEMONSQUEEZY_VARIANT_PRO=

# Pricing tier 3
LEMONSQUEEZY_VARIANT_ENTERPRISE=



# Stripe — card payments and subscriptions. Webhook: /api/payment/webhook
# Safe to expose to the browser
STRIPE_PUBLISHABLE_KEY=

# Server only
STRIPE_SECRET_KEY=

# Verifies /api/payment/webhook
STRIPE_WEBHOOK_SECRET=

STRIPE_PRODUCT_STARTER=

STRIPE_PRICE_STARTER=

STRIPE_PRODUCT_PRO=

STRIPE_PRICE_PRO=

STRIPE_PRODUCT_AGENCY=

STRIPE_PRICE_AGENCY=

STRIPE_PRODUCT_CREDITS_25=

STRIPE_PRICE_CREDITS_25=

STRIPE_PRODUCT_CREDITS_100=

STRIPE_PRICE_CREDITS_100=



# PayPal — Webhook: /api/payment/paypal/webhook
PAYPAL_CLIENT_ID=

# Server only
PAYPAL_CLIENT_SECRET=

# sandbox | live
PAYPAL_MODE=

# Verifies /api/payment/paypal/webhook
PAYPAL_WEBHOOK_ID=



# Paddle — merchant of record. Webhook: /api/payment/paddle/webhook
PADDLE_API_KEY=

PADDLE_WEBHOOK_SECRET=

# sandbox | live
PADDLE_ENV=



# Razorpay — India. Webhook: /api/payment/razorpay/webhook
RAZORPAY_KEY_ID=

# Server only
RAZORPAY_KEY_SECRET=

RAZORPAY_WEBHOOK_SECRET=



# Square — Webhook: /api/payment/square/webhook
# Server only
SQUARE_ACCESS_TOKEN=

SQUARE_LOCATION_ID=

# sandbox | production
SQUARE_ENVIRONMENT=



# Mollie — Europe. Webhook: /api/payment/mollie/webhook
MOLLIE_API_KEY=

MOLLIE_ORGANIZATION_ID=



# FlutterWave — Africa. Webhook: /api/payment/flutterwave/webhook
# Safe to expose to the browser
FLUTTERWAVE_PUBLIC_KEY=

# Server only
FLUTTERWAVE_SECRET_KEY=

# Server only
FLUTTERWAVE_ENCRYPTION_KEY=

FLUTTERWAVE_WEBHOOK_SECRET=



# Mercado Pago — Latin America. Webhook: /api/payment/mercadopago/webhook
# Safe to expose to the browser
MERCADOPAGO_PUBLIC_KEY=

# Server only
MERCADOPAGO_ACCESS_TOKEN=

MERCADOPAGO_WEBHOOK_PASSWORD=



# LiqPay — Webhook: /api/payment/liqpay/webhook
# Safe to expose to the browser
LIQPAY_PUBLIC_KEY=

# Server only
LIQPAY_PRIVATE_KEY=



# Paytm — India. Webhook: /api/payment/paytm/webhook
PAYTM_MERCHANT_ID=

# Server only
PAYTM_MERCHANT_KEY=

# WEBSTAGING for sandbox, WEB for live
PAYTM_WEBSITE=

# Retail
PAYTM_INDUSTRY_TYPE=

# WEB
PAYTM_CHANNEL_ID=

# sandbox | live
PAYTM_MODE=



# bKash — Bangladesh. Webhook: /api/payment/bkash/webhook
BKASH_APP_KEY=

# Server only
BKASH_APP_SECRET=

BKASH_USERNAME=

# Server only
BKASH_PASSWORD=

BKASH_MERCHANT_ID=



# -------------------------------------------------------------------------
# Additional variables read by this build
#
# These are read directly in code and have no safe default,
# so they ship blank. Fill them only if the feature you want
# needs them; each is optional and gated at its call site.
# -------------------------------------------------------------------------

MARKETPLACE_SELLER_NAME=


# ---------------------------------------------------------------------------
# Before going live
#
# 1. Set NODE_ENV=production. The demo seed is hard-disabled in production.
# 2. Set a strong JWT_SECRET and JWT_REFRESH_SECRET (32+ characters each).
# 3. Set FRONTEND_URL to your real frontend origin, or payment redirects and
#    CORS will point at localhost.
# 4. Choose your payment gateways in PAYMENT_GATEWAYS_ENABLED and fill only
#    those providers' keys. Everything else can stay blank.
# 5. Set SMTP_* so verification, password reset and receipt email actually send.
# 6. Run the migrations, not sequelize.sync():
#      npm run migrate
# 7. CORS_ORIGIN and ALLOWED_ORIGINS must list your real origin, not '*'.
# 8. Fill TURNSTILE_* and keep TURNSTILE_ENABLED=true to stop bot signups.
