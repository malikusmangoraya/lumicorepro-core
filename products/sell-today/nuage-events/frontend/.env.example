# Environment template — copy to .env and fill in the blanks.
#
#   cp .env.example .env
#
# Never commit a real .env. Only keys prefixed with VITE_ reach the browser;
# everything else stays on the server. Secrets are left blank on purpose — a
# value that looks like a working credential is how credentials leak.
#
# Generate a secret:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"


# -------------------------------------------------------------------------
# Frontend — public by design
#
# Vite inlines every VITE_ key into the JavaScript bundle, so treat
# anything here as published. Server secrets are never listed on this
# side: they belong in backend/.env and must not be copied here.
# -------------------------------------------------------------------------


# VITE_API_URL — backend base URL the SPA calls
# VITE_API_TIMEOUT — request timeout in milliseconds

# Request timeout in milliseconds
VITE_API_TIMEOUT=15000

# Backend base URL
VITE_API_URL=http://localhost:5000/api

# Formspree form id for contact forms
VITE_FORMSPREE_ID=

# Webhook that receives captured leads
VITE_LEADS_WEBHOOK=


# -------------------------------------------------------------------------
# Analytics and third-party embeds — all optional.
# Leave blank and the corresponding script is not injected.
# -------------------------------------------------------------------------

# Google Analytics 4 measurement id, e.g. G-XXXXXXX
VITE_GA4_ID=

# Plausible site domain
VITE_PLAUSIBLE_DOMAIN=

# Plausible script host for self-hosting
VITE_PLAUSIBLE_HOST=

# PostHog project api key
VITE_POSTHOG_KEY=

# PostHog ingestion host
VITE_POSTHOG_HOST=

# Mixpanel project token
VITE_MIXPANEL_TOKEN=

# Fathom site id
VITE_FATHOM_SITE_ID=


# -------------------------------------------------------------------------
# Server-side secrets — configured in backend/.env, NOT here
# -------------------------------------------------------------------------
#
#   JWT_SECRET            signing key for sessions
#   JWT_REFRESH_SECRET    signing key for refresh tokens
#   DATABASE_URL          PostgreSQL connection string
#   STRIPE_SECRET_KEY     server-only Stripe key
#   LEMONSQUEEZY_API_KEY  server-only Lemon Squeezy key
#   SMTP_PASS             mailbox password
#   GOOGLE_CLIENT_SECRET  OAuth client secret
#   TURNSTILE_SECRET_KEY  server-side CAPTCHA verification

# Copying any of these into this file publishes them to every
# visitor. They belong in backend/.env only.


# -------------------------------------------------------------------------
# Cookie consent
#
# The consent banner is enabled by default in production builds.
# Set this to false only if you have your own consent mechanism.
# -------------------------------------------------------------------------

VITE_COOKIE_CONSENT_ENABLED=true
