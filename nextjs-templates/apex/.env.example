# ── Database ────────────────────────────────────────────────────────────────
# Postgres. Neon, Supabase, RDS, Railway or a local container all work; TLS is
# required by most managed providers.
#   DATABASE_URL="postgresql://user:password@host:5432/apex?sslmode=require"
# For single-machine development without a server, switch the provider in
# prisma/schema.prisma to "sqlite" and set DATABASE_URL="file:./dev.db".
DATABASE_URL="postgresql://user:password@localhost:5432/apex"

# ── Auth ────────────────────────────────────────────────────────────────────
# REQUIRED, minimum 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN="30d"

# ── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_BRAND_NAME="Apex Motor Collective"

# ── Payments (optional) ─────────────────────────────────────────────────────
# Without these, checkout still records the order and the UI says card payment
# is unavailable. With them, "Pay by card" opens Stripe Checkout and
# POST /api/webhooks/stripe marks the order paid — but only after the signature
# is verified against the raw body. A missing webhook secret makes the endpoint
# answer 503 rather than accept unsigned events.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Legacy membership checkout (optional) ───────────────────────────────────
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=

# ── Email (optional) ────────────────────────────────────────────────────────
# Order confirmations and lead notifications are already wired; without these
# values they log and skip instead of failing the request. Swap the provider in
# src/lib/email.ts if you are not using Resend.
RESEND_API_KEY=
EMAIL_FROM="Apex Motor Collective <hello@apex.com>"
CONTACT_INBOX="hello@apex.com"

# ── Vehicle history (optional, paid data) ───────────────────────────────────
# VIN decoding and history reports are paid. src/lib/vin.ts is the integration
# point; the vehicle page shows the panel only when both values are present.
VIN_API_KEY=
NEXT_PUBLIC_VIN_REPORT_BASE=

# ── Live chat (optional, third-party widget) ────────────────────────────────
# Paste the provider's embed URL (Crisp, Intercom, Tawk…). Empty renders
# nothing rather than a button that goes nowhere.
NEXT_PUBLIC_CHAT_SCRIPT_URL=

# ── Analytics + search console (optional) ───────────────────────────────────
# GA4 only loads after the visitor accepts the cookie banner.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GSC_VERIFICATION=

# ── Conversion extras ───────────────────────────────────────────────────────
# Optional promo strip. Empty means no banner — never invent an offer.
NEXT_PUBLIC_PROMO=
# Digits only, with country code, e.g. 15550192834. Empty hides the button.
NEXT_PUBLIC_WHATSAPP=
