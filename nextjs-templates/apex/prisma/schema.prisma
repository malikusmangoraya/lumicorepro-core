// Apex Motor Collective — data model
//
// Postgres is the default because this template deploys to serverless, where a
// local SQLite file is read-only and not shared between instances. Neon,
// Supabase, RDS, Railway and a local `postgres` container all work.
//
// To run on SQLite instead (single-machine dev), change `provider` to "sqlite"
// and set DATABASE_URL="file:./dev.db".
//
// Status columns are String rather than native enums and structured payloads
// are JSON text, so the same schema runs unchanged on both engines. Values are
// validated by the Zod schemas in src/lib/validation.ts and read through the
// typed helpers in src/lib/utils.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String
  role          String   @default("customer") // customer | admin
  phone         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  inquiries     Inquiry[]
  cart          Cart?
  wishlist      Wishlist[]
  orders        Order[]
  addresses     Address[]
  subscriptions Subscription[]
  notifications Notification[]
  reviews       Review[]
  auditLogs     AuditLog[]

  @@index([role])
}

model Vehicle {
  id                   String   @id @default(cuid())
  slug                 String   @unique
  make                 String
  model                String
  year                 Int
  title                String
  description          String
  price                Float
  currency             String   @default("USD")
  mileage              Int
  mileageUnit          String   @default("mi") // mi | km
  bodyStyle            String
  fuelType             String
  transmission         String
  locationCountry      String
  locationRegion       String
  status               String   @default("draft") // draft | active | reserved | sold | withdrawn
  media                String   @default("[]") // JSON array of { url, alt }
  inspectionReferences String   @default("[]") // JSON array of strings
  provenanceVerified   Boolean  @default(false)
  conditionNotes       String?
  conditionReportUrl   String?
  vin                  String?
  isFeatured           Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  inquiries            Inquiry[]
  reviews              Review[]

  @@index([make])
  @@index([status])
  @@index([price])
  @@index([year])
}

model Inquiry {
  id             String   @id @default(cuid())
  vehicleId      String?
  vehicle        Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name           String
  email          String
  phone          String?
  message        String
  locale         String   @default("en")
  consentGiven   Boolean  @default(false)
  consentAt      DateTime?
  status         String   @default("new") // new | contacted | viewing_scheduled | closed | spam
  idempotencyKey String   @unique
  adminNotes     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([vehicleId])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  icon        String?
  products    Product[]
}

model Product {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  description String
  price       Float
  comparePrice Float?
  sku         String?
  stock       Int        @default(0)
  categoryId  String?
  category    Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images      String     @default("[]") // JSON array of urls
  thumbnail   String?
  rating      Float      @default(0)
  reviewCount Int        @default(0)
  isFeatured  Boolean    @default(false)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  cartItems   CartItem[]
  wishlist    Wishlist[]
  orderItems  OrderItem[]
  reviews     Review[]

  @@index([categoryId])
  @@index([isActive])
}

model Cart {
  id          String     @id @default(cuid())
  userId      String     @unique
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  items       CartItem[]
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int     @default(1)

  @@unique([cartId, productId])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Address {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String?
  line1      String
  line2      String?
  city       String
  region     String?
  postalCode String?
  country    String
  phone      String?
  isDefault  Boolean @default(false)

  @@index([userId])
}

model Order {
  id              String   @id @default(cuid())
  orderNumber     String   @unique
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerEmail   String
  shippingAddress String   @default("{}") // JSON
  billingAddress  String   @default("{}") // JSON
  subtotal        Float
  tax             Float    @default(0)
  shipping        Float    @default(0)
  discount        Float    @default(0)
  total           Float
  currency        String   @default("USD")
  status          String   @default("pending") // pending | paid | processing | shipped | delivered | cancelled | refunded
  paymentMethod   String?
  isPaid          Boolean  @default(false)
  isDelivered     Boolean  @default(false)
  trackingNumber  String?
  carrier         String?
  couponCode      String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items           OrderItem[]
  payments        Payment[]

  @@index([status])
  @@index([userId])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  title     String
  unitPrice Float
  quantity  Int
  lineTotal Float
}

model Payment {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider    String
  providerRef String?
  amount      Float
  currency    String   @default("USD")
  status      String   @default("pending") // pending | succeeded | failed | refunded
  createdAt   DateTime @default(now())

  @@index([orderId])
}

model Coupon {
  id          String    @id @default(cuid())
  code        String    @unique
  type        String    @default("percent") // percent | fixed
  value       Float
  minSubtotal Float?
  maxDiscount Float?
  usageLimit  Int?
  usedCount   Int       @default(0)
  startsAt    DateTime?
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
}

model Plan {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  amount      Float
  currency    String         @default("USD")
  interval    String         @default("month") // month | year
  features    String         @default("[]") // JSON array of strings
  isHighlight Boolean        @default(false)
  sortOrder   Int            @default(0)
  subscriptions Subscription[]
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId    String
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Restrict)
  status    String   @default("active") // active | cancelled | past_due
  startedAt DateTime @default(now())
  endsAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      String   @default("info") // info | success | warning | error
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

/// A review of a vehicle or a shop product. Guest reviews are allowed, so the
/// author is stored on the row as well as being linked to an account when one
/// exists. Nothing is public until an admin approves it.
model Review {
  id               String   @id @default(cuid())
  vehicleId        String?
  vehicle          Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  productId        String?
  product          Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  authorName       String
  authorEmail      String
  rating           Int
  title            String?
  comment          String
  status           String   @default("pending") // pending | approved | rejected
  verifiedPurchase Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([status])
  @@index([vehicleId, status])
  @@index([productId, status])
}

/// Uploaded images live in the database because a serverless deployment has no
/// writable disk. Bytes are served back by /api/media/[id] with a long cache.
model MediaAsset {
  id        String   @id @default(cuid())
  filename  String
  mimeType  String
  size      Int
  width     Int?
  height    Int?
  data      Bytes
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// One row per delivered webhook, so a Stripe retry is not applied twice.
model WebhookEvent {
  id        String   @id @default(cuid())
  eventId   String   @unique
  eventType String
  gateway   String   @default("stripe")
  payload   String   @default("{}")
  status    String   @default("received") // received | processed | failed
  createdAt DateTime @default(now())

  @@index([gateway, status])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("footer")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([isActive])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String?
  entityId  String?
  ip        String?
  userAgent String?
  meta      String   @default("{}") // JSON
  createdAt DateTime @default(now())

  @@index([action])
}
