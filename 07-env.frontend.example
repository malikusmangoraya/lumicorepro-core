# =====================================================================
# FRONTEND .env.example  (frontend/.env.example)
# ZAROORI QAYDA: Frontend mein SIRF VITE_ wali PUBLIC values.
# Yahan koi secret/private key/password kabhi nahi. Vite inhe browser
# bundle mein daal deta hai, yani sab log dekh sakte hain.
#
# NAHI likhna (ye backend/.env mein jaate hain):
#   JWT_SECRET, STRIPE_WEBHOOK_SECRET, PAYPAL_CLIENT_SECRET,
#   LEMONSQUEEZY_API_KEY, LEMONSQUEEZY_WEBHOOK_SECRET,
#   BKASH_APP_SECRET, RAZORPAY_KEY_SECRET
# =====================================================================

# ---------- App ----------
VITE_APP_NAME=ProductName
VITE_API_URL=http://localhost:5000/api       # backend ka API base URL
VITE_APP_URL=http://localhost:5173
VITE_BASE_PATH=/                              # GitHub Pages par e.g. /product-name/

# ---------- i18n ----------
VITE_DEFAULT_LOCALE=en
VITE_ENABLED_LOCALES=ar,de,en,es,fr,hi,id,ja,ko,pt,ru,tr,ur,zh

# ---------- Public keys (safe) ----------
VITE_TURNSTILE_SITE_KEY=                      # Cloudflare Turnstile PUBLIC site key
VITE_STRIPE_PUBLISHABLE_KEY=                  # pk_... (publishable, secret nahi)
VITE_PAYPAL_CLIENT_ID=                        # PayPal client id (public)
VITE_GOOGLE_CLIENT_ID=                        # agar frontend-side Google button ho
VITE_LEMONSQUEEZY_STORE_URL=                  # checkout page ka public URL

# ---------- Monitoring ----------
VITE_SENTRY_DSN=                              # Sentry DSN public hota hai
VITE_SENTRY_ENVIRONMENT=development

# ---------- Feature flags ----------
VITE_ENABLE_2FA=true
VITE_ENABLE_AI=false
VITE_ENABLE_PWA=true
VITE_DEMO_MODE=false                          # true = demo login credentials dikhao

# ---------- Analytics (consent ke baad hi load karo) ----------
VITE_ANALYTICS_ID=
