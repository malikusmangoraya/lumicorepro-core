# Frontend Environment Variables
VITE_API_URL=http://localhost:5000
VITE_AI_URL=http://localhost:8000
VITE_API_TIMEOUT=10000
VITE_ENV=development
VITE_LOG_LEVEL=debug
VITE_ENABLE_MOCK_API=true
VITE_ENABLE_LOGGING=true
VITE_ENABLE_DARK_MODE=true
VITE_APP_VERSION=1.0.0
VITE_APP_NAME=LumiCorePro

# SEO & OpenGraph defaults
VITE_SITE_URL=https://lumicorepro.com
VITE_DEFAULT_OG_IMAGE=
VITE_TWITTER_HANDLE=@lumicorepro

# Privacy-first analytics (Plausible or Google Analytics 4)
VITE_ENABLE_ANALYTICS=false
VITE_ANALYTICS_PROVIDER=plausible
VITE_ANALYTICS_DOMAIN=
VITE_ANALYTICS_SCRIPT_URL=
VITE_GOOGLE_TAG_ID=

# Contact / lead form handlers (provider order: Formspree → webhook → mock)
VITE_FORMSPREE_ENDPOINT=
VITE_CONTACT_WEBHOOK_URL=
VITE_CONTACT_EMAIL=

# Captcha — Cloudflare Turnstile public key (free; matches backend TURNSTILE_SITE_KEY)
VITE_TURNSTILE_SITE_KEY=

# Analytics — Plausible events (see Analytics.jsx)
VITE_PLAUSIBLE_DOMAIN=

# Waitlist/Beta mode — banner + gating hints on the frontend (optional)
VITE_WAITLIST_MODE=false

# Backend Environment Variables
NODE_ENV=development
PORT=5000

# Database — PostgreSQL via Sequelize (backend/config/database.js).
# REQUIRED in production; the app throws on boot if unset when NODE_ENV=production.
# Dev fallback when unset: postgres://postgres:postgres@localhost:5432/lumicorepro
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lumicorepro
# Verify the server certificate in production. Set false ONLY for managed
# providers presenting a CA the app cannot chain to.
DB_SSL_REJECT_UNAUTHORIZED=true
# Log statements slower than this (ms). 0 disables.
SLOW_QUERY_THRESHOLD_MS=200
# Print every SQL statement (development only).
LOG_QUERIES=false

REDIS_URL=redis://localhost:6379

# Both secrets are validated at boot and must be >= 32 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-secure-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-this-to-a-different-secure-random-string-32-plus
# Short-lived access tokens only. Production validation rejects values above 1h.
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d
# Browser origins allowed to call the backend API. Required in production.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Locale / currency defaults (ISO 4217 + BCP 47)
DEFAULT_CURRENCY=USD
DEFAULT_LOCALE=en
TZ=UTC

# Stripe
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
# Stripe Price/Product ids (optional — created once plans are seeded)
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=
STRIPE_PRICE_CREDITS_25=
STRIPE_PRICE_CREDITS_100=

# Live previews (served by the AI agent through Express)
PREVIEW_BASE_URL=http://localhost:8000

# Email / Nodemailer
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_username
SMTP_PASS=your_password

# AI Providers
# Use the exact your_*_api_key_here markers below. The AI agent treats any
# value starting with your_ as an unconfigured example, never a live key.
GEMINI_API_KEY=your_gemini_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
GROK_API_KEY=your_grok_api_key_here

# Google Maps Scraper (vendors/google-maps-scraper-kit)
SCRAPER_BASE_URL=http://localhost:8080
SCRAPER_API_KEY=

# Codextron Dev Loop (vendors/codextron-dev)
CODEX_DEV_LOOP_ENABLED=true
CODEX_DEV_LOOP_MODE=standard

# OpenAI (Optional)
OPENAI_API_KEY=your_openai_api_key_here

# Cloudinary (Optional - for image storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Twilio (Optional - for SMS/WhatsApp)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890
