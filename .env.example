# Frontend Environment Variables
VITE_API_URL=http://localhost:5000
VITE_API_TIMEOUT=10000
VITE_ENV=development
VITE_LOG_LEVEL=debug
VITE_ENABLE_MOCK_API=true
VITE_ENABLE_LOGGING=true
VITE_ENABLE_DARK_MODE=true
VITE_APP_VERSION=1.0.0
VITE_APP_NAME=LumiCorePro

# SEO & OpenGraph defaults
VITE_SITE_URL=https://lumicorepro.com
VITE_DEFAULT_OG_IMAGE=
VITE_TWITTER_HANDLE=@lumicorepro

# Privacy-first analytics (Plausible or Google Analytics 4)
VITE_ENABLE_ANALYTICS=false
VITE_ANALYTICS_PROVIDER=plausible
VITE_ANALYTICS_DOMAIN=
VITE_ANALYTICS_SCRIPT_URL=
VITE_GOOGLE_TAG_ID=

# Contact / lead form handlers (provider order: Formspree → webhook → mock)
VITE_FORMSPREE_ENDPOINT=
VITE_CONTACT_WEBHOOK_URL=
VITE_CONTACT_EMAIL=

# Captcha — Cloudflare Turnstile public key (free; matches backend TURNSTILE_SITE_KEY)
VITE_TURNSTILE_SITE_KEY=

# Analytics — Plausible events (see Analytics.jsx)
VITE_PLAUSIBLE_DOMAIN=

# Waitlist/Beta mode — banner + gating hints on the frontend (optional)
VITE_WAITLIST_MODE=false

# Backend Environment Variables
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/lumicorepro
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-this-to-a-secure-random-string
JWT_EXPIRE=7d
FRONTEND_URL=http://localhost:5173

# Stripe
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
# Stripe Price/Product ids (optional — created once plans are seeded)
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=
STRIPE_PRICE_CREDITS_25=
STRIPE_PRICE_CREDITS_100=

# Live previews (served by the AI agent through Express)
PREVIEW_BASE_URL=http://localhost:8000

# Email / Nodemailer
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_username
SMTP_PASS=your_password

# AI Providers
GEMINI_API_KEY=your_gemini_key
DEEPSEEK_API_KEY=your_deepseek_key
OPENROUTER_API_KEY=your_openrouter_key
GROK_API_KEY=your_grok_key

# OpenAI (Optional)
OPENAI_API_KEY=your_openai_key

# Cloudinary (Optional - for image storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Twilio (Optional - for SMS/WhatsApp)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890
