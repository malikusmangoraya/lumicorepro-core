# =============================================================================
# LumicorePro — PRODUCTION environment template
# =============================================================================
#   cp .env.production.example .env.production
#   # fill in every REQUIRED value, then:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d
#
# Rules
#   REQUIRED   Compose refuses to start without it (${VAR:?message}).
#   RECOMMENDED Has a working default, but the default is wrong for production.
#
# This file is the only place these values live. .env.production is gitignored;
# never commit real credentials and never bake them into an image.
# =============================================================================

# ── Public identity ──────────────────────────────────────────────────────────
# REQUIRED — the host name in the TLS certificate and the nginx server_name.
SERVER_NAME=example.com

# REQUIRED — full public origin of the site, including scheme, no trailing slash.
# The SPA bundle is built with VITE_API_URL set to this value, and the API is
# served from the same origin through nginx, so there is exactly one origin here.
PUBLIC_ORIGIN=https://example.com

# RECOMMENDED — extra browser origins allowed to call the API (comma separated).
# Leave empty: the same-origin default already covers the site itself.
ALLOWED_ORIGINS=

# ── Database ─────────────────────────────────────────────────────────────────
# REQUIRED — must match the values the db container is initialised with. Changing
# POSTGRES_PASSWORD after the volume exists does NOT change the database
# password; rotate it with ALTER USER instead (docs/RUNBOOK.md § Rotate secrets).
POSTGRES_DB=lumicorepro_db
POSTGRES_USER=lumicore
POSTGRES_PASSWORD=

# ── Redis ────────────────────────────────────────────────────────────────────
# REQUIRED — Redis runs with --requirepass; there is no passwordless mode.
REDIS_PASSWORD=

# ── Application secrets ──────────────────────────────────────────────────────
# REQUIRED, each at least 32 characters and different from each other.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#   openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# ── Images ───────────────────────────────────────────────────────────────────
# REQUIRED — lowercase GitHub owner that publishes the GHCR images
# (see .github/workflows/deploy.yml). Example: acme-inc
GHCR_OWNER=

# RECOMMENDED — pin the deployed release instead of floating on `latest`.
# The release workflow pushes the commit SHA as a tag, so use that for a
# reproducible deploy and for one-command rollback (docs/RUNBOOK.md § Rollback).
IMAGE_TAG=latest

# ── Payments (optional) ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Email (optional) ─────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@example.com

# ── Observability / AI providers (optional) ──────────────────────────────────
SENTRY_DSN=

# The AI agent needs at least one provider key to generate anything. Without one
# the service still starts and serves /health, but every generation request fails
# gracefully — see docs/RUNBOOK.md § "The AI agent is offline".
ACTIVE_AI_PROVIDER=grok
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
GROK_API_KEY=
NVIDIA_API_KEY=

# Enables the agent's GitHub publishing features (repo create, Pages deploy).
GITHUB_TOKEN=

# ── AI agent options ─────────────────────────────────────────────────────────
# Leave AGENT_API_KEY empty unless the Express passthrough has been taught to
# forward X-API-Key. The current backend calls the agent without a key, so
# setting this here breaks every AI request. See docs/DEPLOYMENT.md
# "AI agent authentication".
AGENT_API_KEY=
AI_AGENT_ALLOWED_HOSTS=ai-agent,127.0.0.1,localhost
AI_AGENT_RATE_LIMIT_REQUESTS=30
AI_AGENT_RATE_LIMIT_WINDOW=60
# true installs chromadb + sentence-transformers (~2 GB) for the RAG engine.
AI_AGENT_INSTALL_HEAVY_ML=false
