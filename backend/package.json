{
  "name": "lumicorepro-backend",
  "version": "1.0.0",
  "description": "LumiCorePro Backend API Server",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "worker": "node workers/worker.js",
    "dev:worker": "nodemon workers/worker.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage --runInBand",
    "test:unit": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js tests/unit --coverage=false --runInBand",
    "test:integration": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js tests/integration --coverage=false --runInBand",
    "test:feature": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js tests/feature --coverage=false --runInBand",
    "test:ci": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage --runInBand --ci",
    "lint": "eslint .",
    "db:indexes": "node scripts/apply-indexes.js",
    "seed": "node scripts/seed.js"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.17.0",
    "@jridgewell/gen-mapping": "^0.3.13",
    "@paypal/checkout-server-sdk": "^1.0.3",
    "@sentry/node": "^11.6.0",
    "awilix": "^13.0.5",
    "bcryptjs": "^3.0.2",
    "bullmq": "^6.3.4",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "envalid": "^8.2.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.0",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "rate-limit-redis": "^4.3.1",
    "razorpay": "^2.9.4",
    "resolve.exports": "^2.0.3",
    "sequelize": "^6.37.5",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.1",
    "square": "^32.0.0",
    "stripe": "^17.5.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.0.5",
    "winston": "^3.17.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "eslint": "^9.18.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  }
}
