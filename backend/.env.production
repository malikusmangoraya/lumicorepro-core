# LumiCorePro Backend - Production Configuration
NODE_ENV=production
PORT=5000
FRONTEND_URL=https://lumicorepro.com
PRODUCTION_URL=https://api.lumicorepro.com

# Database (PostgreSQL — Neon, Supabase, or AWS RDS)
DATABASE_URL=postgresql://user:password@host:5432/lumicorepro?sslmode=require

# Authentication & JWT (use strong random secrets in production)
JWT_SECRET=prod_super_secure_jwt_secret_key_change_in_cloud_vault
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=prod_refresh_secret_key_vault
JWT_REFRESH_EXPIRE=30d

# Redis (Production — Upstash, ElastiCache, or Railway)
REDIS_URL=rediss://default:password@redis-host:6379

# Email Service (SendGrid / AWS SES)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.production_api_key_here
EMAIL_FROM=no-reply@lumicorepro.com

# Stripe — Live keys (Visa / Mastercard / Amex / Apple Pay / Google Pay)
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_your_live_stripe_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_live_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_live_webhook_secret

# PayPal — Live keys
# Get from: https://developer.paypal.com/dashboard/applications/live
PAYPAL_CLIENT_ID=your_live_paypal_client_id
PAYPAL_CLIENT_SECRET=your_live_paypal_client_secret
PAYPAL_MODE=live

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Security & CORS
ALLOWED_ORIGINS=https://lumicorepro.com,https://admin.lumicorepro.com,https://app.lumicorepro.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300

# Sentry Error Monitoring
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log
