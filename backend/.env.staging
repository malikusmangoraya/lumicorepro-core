# LumiCorePro Backend - Staging Configuration
NODE_ENV=staging
PORT=5000
FRONTEND_URL=https://staging.lumicorepro.com
PRODUCTION_URL=https://staging-api.lumicorepro.com

# Database (PostgreSQL — same cluster as prod, separate DB)
DATABASE_URL=postgresql://user:password@host:5432/lumicorepro_staging?sslmode=require

# JWT
JWT_SECRET=staging_secret_jwt_key_change_me
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=staging_refresh_secret_change_me
JWT_REFRESH_EXPIRE=30d

# Redis
REDIS_URL=redis://redis:6379

# Email Service (Mailtrap for staging)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=mailtrap_staging_user
SMTP_PASS=mailtrap_staging_pass
EMAIL_FROM=staging-noreply@lumicorepro.com

# Stripe — Test keys
STRIPE_SECRET_KEY=sk_test_your_stripe_test_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_test_key
STRIPE_WEBHOOK_SECRET=whsec_your_staging_webhook_secret

# PayPal — Sandbox
PAYPAL_CLIENT_ID=your_sandbox_paypal_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_paypal_client_secret
PAYPAL_MODE=sandbox

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# CORS
ALLOWED_ORIGINS=https://staging.lumicorepro.com,http://localhost:5173,http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500

# Logging
LOG_LEVEL=debug
LOG_FILE=logs/app.log
