# ═══════════════════════════════════════════════════════════════
# LumicorePro — Backend Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env with real secrets.
# ═══════════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── PostgreSQL / Sequelize ───────────────────────────────────────
# Full connection string (recommended)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lumicorepro

# Or individual parts (used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lumicorepro
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# ── Redis (caching & sessions & queues) ────────────────────────────
REDIS_URL=redis://localhost:6379
# Set true to disable Redis entirely and force the in-memory fallback
REDIS_DISABLED=false

# ── BullMQ background worker ───────────────────────────────────────
# Run the worker separately:  npm run worker
WORKER_CONCURRENCY=5

# ── Slow query logging ─────────────────────────────────────────────
SLOW_QUERY_THRESHOLD_MS=200
# Extra: log EVERY query (dev only)
LOG_QUERIES=false

# ── JWT ─────────────────────────────────────────────────────────
# Token policy: short-lived access tokens + long-lived rotating refresh tokens.
#   JWT_EXPIRE         → access token TTL. Default 15m. Production boot
#                        validation (config/env.js) REJECTS anything above 1h.
#   JWT_REFRESH_EXPIRE → rotating refresh token TTL (7d), revoked on rotation.
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=your-refresh-token-secret-change-in-production
JWT_REFRESH_EXPIRE=7d

# ── Email / SMTP ─────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@lumicorepro.com

# ── Stripe Payments (Visa / Mastercard / Amex / Apple Pay / Google Pay) ──
# Get test keys from: https://dashboard.stripe.com/test/apikeys
# Test card: 4242 4242 4242 4242, any future date, any CVC
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ── PayPal (Sandbox) ────────────────────────────────────────────────
# Get sandbox keys from: https://developer.paypal.com/dashboard/applications/sandbox
# Test flow: use sandbox buyer account at sandbox.paypal.com
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox
# PAYPAL_WEBHOOK_ID is REQUIRED for /api/payments/paypal/webhook. The handler
# verifies every delivery against PayPal's
# POST /v1/notifications/verify-webhook-signature using the paypal-transmission-*
# headers. Without it the route fails closed (400) in production; outside
# production it logs a warning and skips verification (development only).
# Find it in the PayPal dashboard → your app → Webhooks → Webhook ID.
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

# ── Razorpay ─────────────────────────────────────────────────────
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ── Payment Gateways — LAUNCH FEATURE FLAG ─────────────────────────
# At launch only Stripe + PayPal are active. The other 11 gateways stay
# implemented in code but DISABLED (won't appear in checkout, won't charge).
#   PAYMENT_GATEWAYS_ENABLED=stripe,paypal  -> Stripe + PayPal (launch default)
#   PAYMENT_GATEWAYS_ENABLED=all            -> ALL gateways with valid keys
#   (unset)                                 -> all gateways with valid keys
# To enable another gateway later: add its slug, e.g. stripe,paypal,paddle.
# ️Comment: "disabled for launch — enable when gateway-specific demand confirmed"
PAYMENT_GATEWAYS_ENABLED=stripe,paypal

# ── AI Agent (Python FastAPI) ────────────────────────────────────
AI_AGENT_URL=http://localhost:8000
AGENT_API_KEY=your_internal_agent_api_key

# ── AI Provider Keys (for direct backend AI calls) ───────────────
GEMINI_API_KEY=your_gemini_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
MISTRAL_API_KEY=your_mistral_api_key
ACTIVE_AI_PROVIDER=gemini

# ── AI COST PROTECTION (launch defaults — enforce server-side) ───
# Daily per-user/IP generation quota (set low to protect free AI key credit)
AI_DAILY_GEN_LIMIT=3
AI_DAILY_CHAT_LIMIT=20
AI_DAILY_VISION_LIMIT=10
# Per-request hard token caps (client cannot override)
AI_MAX_TOKENS_GENERATION=12000
AI_MAX_TOKENS_CHAT=4000
AI_MAX_TOKENS_VISION=2000
# Circuit breaker: block for 5 min if >10 AI requests in 1 minute
AI_CB_MAX_REQUESTS=10
AI_CB_BLOCK_SECS=300
# Queue concurrency + spend guard (free-tier RPM safe)
AI_MAX_CONCURRENT=2
AI_TOKEN_BUDGET=40000
AI_TOKEN_COST_PER_1K=0.02
# Estimate helpers (used by /api/ai/spend-estimator)
AI_AVG_TOKENS_GENERATION=18000
AI_AVG_TOKENS_CHAT=2500
AI_AVG_TOKENS_VISION=1200
# Optional weekly hard budget — 429 on exceed
AI_WEEKLY_BUDGET=

# ── DEMO MODE (free-tier deploy) ─────────────────────────────────
# true → /api/ai/generate returns instant simulated results using local
# rules, WITHOUT calling the AI agent — zero AI quota consumed on demo.
DEMO_MODE=false

# ── DEV DEMO ACCOUNTS (disabled by default) ──────────────────────
# Demo login exists ONLY when BOTH of these hold:
#   1. SEED_DEMO_USERS=true
#   2. NODE_ENV is not "production"
# …and DEMO_USER_PASSWORD is set explicitly. There is no built-in fallback
# password, so with this flag off the demo accounts are never created and the
# demo login path behaves as if it does not exist. Never enable in production.
SEED_DEMO_USERS=false
# Password for the seeded demo/admin accounts. Leave empty unless you are
# deliberately running the demo login locally; never commit a real password.
DEMO_USER_PASSWORD=

# ── CAPTCHA (Cloudflare Turnstile — 100% free, unlimited) ────────
# Get keys from: https://dash.cloudflare.com/sign-up → Turnstile
# VITE_TURNSTILE_SITE_KEY (public) goes in the FRONTEND .env
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_ENABLED=true

# ── WAITLIST / BETA GATE (controlled launch) ──────────────────────
# true → new signups go on the waitlist unless the daily auto-approve
#        cap is still available. Waitlist users can log in but CANNOT
#        generate (403 WAITLIST_PENDING) until an admin approves them.
WAITLIST_MODE=false
# Auto-approve the first N signups per day (0 = no auto-approve → all
# signups wait for manual admin approval)
WAITLIST_AUTO_APPROVE_DAILY=20

# ── Cloudinary (image hosting) ───────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── File Uploads ─────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ── Monitoring / Logging ─────────────────────────────────────────
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id
LOG_LEVEL=info
LOG_FILE=logs/app.log

# ── Rate Limiting ─────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300

# ── Session ──────────────────────────────────────────────────────
SESSION_SECRET=your-session-secret-key-change-in-production
SESSION_MAX_AGE=86400000

# ── Licensing (self-hosted, free; no SaaS) ──────────────────────
# Generate a strong secret:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LICENSE_SECRET=your-license-hmac-secret-min-32-chars-random-hex
LICENSE_PRODUCT=lumicorepro-core
LICENSE_TRIAL_DAYS=14

# ── Marketplace / sell-ready export ─────────────────────────────
# Used to stamp generated projects + sellable ZIPs. Free tiers only.
MARKETPLACE_SELLER_NAME=LumicorePro
MARKETPLACE_PLATFORM_URL=https://lumicorepro.vercel.app

# ── Internationalization (optional; validated on startup) ───────
# DEFAULT_CURRENCY: ISO 4217 3-letter code (orders → checkout, if absent)
DEFAULT_CURRENCY=USD
# DEFAULT_LOCALE: BCP 47 tag used as runtime fallback locale
DEFAULT_LOCALE=en
# TZ: IANA timezone for generated invoices/logs
TZ=UTC

# ─────────────────────────────────────────────────────────────────────────────
# Monetization: Lemon Squeezy (selling this product)
# ─────────────────────────────────────────────────────────────────────────────
# Signing secret from Lemon Squeezy → Settings → Webhooks. Used to verify the
# X-Signature HMAC on every incoming webhook. Without it the webhook endpoint
# returns 503 and never mutates data.
LEMONSQUEEZY_SIGNING_SECRET=
LEMONSQUEEZY_STORE_ID=

# ─────────────────────────────────────────────────────────────────────────────
# AI cost governance (per-run ledger lives in ai_spend_ledger)
# ─────────────────────────────────────────────────────────────────────────────
# Hard per-user daily spend cap in USD. When a run would cross it, the API
# answers 402 DAILY_BUDGET_EXCEEDED before any provider call is made.
AI_DAILY_BUDGET_USD=5
# Weekly ceiling (informational dashboards; 0 disables the warning)
AI_WEEKLY_BUDGET_USD=0

# ─────────────────────────────────────────────────────────────────────────────
# Scale + observability
# ─────────────────────────────────────────────────────────────────────────────
# Comma-separated Postgres read replicas. SELECTs are load-balanced across
# them; writes always hit the primary from DATABASE_URL. Leave empty to keep
# the single-node behaviour.
DB_REPLICA_URLS=
# SLO targets used by GET /api/metrics/slo
SLO_AVAILABILITY_TARGET=0.999
SLO_P95_LATENCY_SECONDS=0.5
SLO_GENERATION_SUCCESS_TARGET=0.95
SLO_FAST_BURN=14.4
SLO_SLOW_BURN=6

# Marketplace template update delivery (files live in this directory)
TEMPLATE_UPDATES_DIR=./uploads/template-updates
