# Vercel upload filter for the SPA deployment.
# Every directory entry is anchored with a leading slash: an unanchored
# `templates/` also matched `src/templates/`, and the remote build then failed
# with "Could not resolve ../templates/dashboard/Profile" while the local build
# passed. Keep the leading slashes.
/node_modules/
/dist/
/.build/
/.git/
/.env*
/logs/
*.log
/coverage/
/.vercel/
/.history/
/.tmp_recover/
/.kiro/
/.qodo/
/.codex/
/.superpowers/
/.xgrok/
/.nexus/
/.cursor/
/.backup/
/archive/
/delivery/
/generated-projects/
/e2e/
/k8s/
/nginx/
/scripts/
/database/
/schemas/
/project-rules/
/docs/
/registry/
/templates/
/ai-agent/
/backend/
/backend-library/
!.env.example
!.gitignore
!.vercel.json
