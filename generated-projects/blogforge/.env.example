PORT=5000
# Production (Neon/Supabase/RDS). When set, DB_* below are ignored and SSL is enabled.
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lumicore_app
DB_USER=postgres
POSTGRES_PASSWORD=
DB_PASSWORD=
# REQUIRED, minimum 32 chars. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#   # or: openssl rand -hex 32
# The backend refuses to start if this is missing, short, or a known placeholder.
JWT_SECRET=
NODE_ENV=production
AI_PROVIDER=openai
OPENAI_API_KEY=sk-...  (or leave empty and store via keyVault at runtime)
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
ENCRYPTION_KEY=64-char hex — openssl rand -hex 32 (encrypts stored API keys)
PGVECTOR_URL=postgresql://user:pass@localhost:5432/db (optional; in-memory RAG without it)
BRAND_NAME=YourBrand

# Comma-separated list of browser origins allowed to call the backend. Empty = the
# two defaults below (local dev + blogforge-lumicorepro.vercel.app).
CORS_ORIGINS=
# Demo credit top-up is disabled in production by default. Set to 1 only when the
# buyer has no payment provider yet and explicitly wants the free top-up enabled.
ENABLE_DEMO_TOPUP=
# When set, `npm test` in the backend connects to this URL instead of DATABASE_URL.
TEST_DATABASE_URL=
