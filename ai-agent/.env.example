# LumicorePro AI Agent — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values
# NEVER commit .env with real API keys
# ============================================================

# ── Active AI Provider ─────────────────────────────────────────
# Options: nvidia | cerebras | groq | nebius | hyperbolic | zai | dashscope
#        | together | deepinfra | fireworks | sambanova | novita | huggingface
#        | featherless | chutes | minimax | cohere | gemini | deepseek | claude
#        | anthropic | openai | chatgpt | openrouter | grok | mistral | kimi
#        | moonshot | opencode | freellmapi
# Every option above is an internet-hosted API; no local GPU runtime is supported.
# `opencode` is the one local adapter — the open-source OpenCode agent CLI (MIT).
ACTIVE_AI_PROVIDER=gemini

# ── AI Provider API Keys ───────────────────────────────────────
# Set the key(s) you have. Others can be left blank — agent uses fallback chain.

# Google Gemini (free tier available) — https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Groq Cloud (OpenAI-compatible, gsk_ keys) — https://console.groq.com/keys
GROK_API_KEY=your_grok_api_key_here
GROK_MODEL=openai/gpt-oss-120b
# Groq vision model (llama-vision family) — fallback when OpenRouter/Gemini VISION is unavailable
GROQ_VISION_MODEL=meta-llama/llama-3.2-11b-vision-preview

# Anthropic Claude — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Mistral AI (cheap + multilingual) — https://console.mistral.ai/api-keys
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-large-latest

# DeepSeek (code-focused) — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat

# NVIDIA NIM free tier — https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=deepseek-ai/deepseek-v4.1-flash

# Kimi / Moonshot AI (open-weight K2 family, strong coder) — https://platform.kimi.ai
# Model ids: kimi-k2.7-code (default, coding) | kimi-k2.7-code-highspeed | kimi-k2.6 | kimi-k3
# Retired — do not use: kimi-latest, and the original kimi-k2* series.
# KIMI_BASE_URL may point at any other OpenAI-compatible endpoint serving the
# open K2 family weights (the compliant path when the hosted API's China-side
# processing is not acceptable). It must be a network address the agent can
# reach — the agent never runs a model on this machine.
KIMI_API_KEY=your_kimi_api_key_here
KIMI_MODEL=kimi-k2.7-code
KIMI_BASE_URL=https://api.moonshot.ai/v1

# ── Open-weight cloud inference (internet only) ────────────────────────────
# Open models (Llama, Qwen, DeepSeek, GLM, Mistral, gpt-oss) served over a
# cloud HTTP API. No local GPU runtime is supported — every provider below is
# reached over the public internet. Set whichever keys you have; the agent
# rotates through the ones that are configured.
#
#   cerebras      https://api.cerebras.ai/v1              fastest time-to-first-token
#   deepinfra     https://api.deepinfra.com/v1/openai     cheapest per token
#   together      https://api.together.xyz/v1             200+ open models
#   fireworks     https://api.fireworks.ai/inference/v1   high throughput
#   sambanova     https://api.sambanova.ai/v1             dataflow hardware
#   novita        https://api.novita.ai/v3/openai         low cost
#   huggingface   https://router.huggingface.co/v1        HF Inference Providers router
#   nebius        https://api.tokenfactory.nebius.com/v1  fast + cheap
#   hyperbolic    https://api.hyperbolic.xyz/v1           open-access GPU cloud
#   featherless   https://api.featherless.ai/v1           largest catalogue, no cold start
#   chutes        https://llm.chutes.ai/v1                decentralised, very low cost
#   zai           https://api.z.ai/api/paas/v4            GLM (MIT for the 4.5 family)
#   dashscope     https://dashscope-intl.aliyuncs.com/compatible-mode/v1  Qwen3 (Apache-2.0)
#   minimax       https://api.minimax.io/v1               M-series, long context
#   cohere        https://api.cohere.ai/compatibility/v1  Command A/R — CC-BY-NC, NON-COMMERCIAL
#
# Each vendor accepts <VENDOR>_MODEL and <VENDOR>_BASE_URL overrides.
# CEREBRAS_API_KEY=your_cerebras_api_key_here
# DEEPINFRA_API_KEY=your_deepinfra_api_key_here
# TOGETHER_API_KEY=your_together_api_key_here
# FIREWORKS_API_KEY=your_fireworks_api_key_here
# SAMBANOVA_API_KEY=your_sambanova_api_key_here
# NOVITA_API_KEY=your_novita_api_key_here
# HUGGINGFACE_TOKEN=your_huggingface_token_here
# NEBIUS_API_KEY=your_nebius_api_key_here
# HYPERBOLIC_API_KEY=your_hyperbolic_api_key_here
# FEATHERLESS_API_KEY=your_featherless_api_key_here
# CHUTES_API_KEY=your_chutes_api_key_here
# ZAI_API_KEY=your_zai_api_key_here
# GLM Coding Plan subscribers only: ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
# DASHSCOPE_API_KEY=your_dashscope_api_key_here
# China-site DashScope keys only: DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MINIMAX_API_KEY=your_minimax_api_key_here
# COHERE_API_KEY=your_cohere_api_key_here

# OpenRouter (aggregator — access many models) — https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=deepseek/deepseek-chat

# ── OmniRoute AI Gateway (free, 350+ providers) ───────────────────
# One endpoint whose 'auto' model routes to the FASTEST available backend first
# and auto-fallbacks across 350+ providers (150+ free tiers). Keyless local
# install supported: npm i -g omniroute  →  run: omniroute  (boots on :20128).
# If the gateway is not running the agent auto-rotates to the native providers below.
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=auto
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1

# ── 9Router AI Gateway (free router + token saver) ─────────────────────
# Local gateway: npm i -g 9router  →  npm run router  (or: 9router, boots :20128).
# Dashboard http://localhost:20128 → Providers → connect a FREE provider
# (Kiro AI ~50 credits/mo, OpenCode Free no-auth) → API Keys → copy key below.
# Model id format: <provider-prefix>/<model>. RTK saves 20-40% on tool output.
NINEROUTER_API_KEY=
NINEROUTER_MODEL=kr/claude-sonnet-4.5
NINEROUTER_BASE_URL=http://127.0.0.1:20128/v1

# ── FreeLLMAPI (optional local OpenAI-compatible router) ──────────────
# Self-host: https://github.com/tashfeenahmed/freellmapi
# Example local API base URL from the project's README; configure to match your install.
# No router key is needed if auth is disabled. Upstream providers may need their own keys.
# Usage: ACTIVE_AI_PROVIDER=freellmapi
FREELLMAPI_API_KEY=
FREELLMAPI_MODEL=auto
FREELLMAPI_BASE_URL=http://127.0.0.1:3001/v1

# ── OpenCode CLI (open-source coding agent, MIT) ───────────────────────
# Free, open-source Claude Code alternative — https://opencode.ai
# Repo: https://github.com/sst/opencode  ·  Select: ACTIVE_AI_PROVIDER=opencode
# The adapter shells out to headless mode:  opencode run "<prompt>"
# No key is needed here — the CLI keeps its own credentials (opencode auth login).
# OPENCODE_MODEL/AGENT/DIR/ATTACH are optional; leave blank to use the CLI default.
OPENCODE_BIN=opencode
OPENCODE_MODEL=
OPENCODE_AGENT=
OPENCODE_DIR=
OPENCODE_ATTACH=
OPENCODE_TIMEOUT=180

# ── Server Security ────────────────────────────────────────────
# Optional: set this to require X-Api-Key header on all API calls
AGENT_API_KEY=

# Rate limiting (requests per window per IP)
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW=60

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ── Path Configuration ─────────────────────────────────────────
PROJECT_ROOT=..
GENERATED_PROJECTS_DIR=../generated-projects
REGISTRY_DIR=../registry
TEMPLATES_DIR=../src/templates
COMPONENTS_DIR=../src/components
BACKEND_LIBRARY_DIR=../backend-library
DATABASE_SCHEMAS_DIR=../database/schemas
AGENT_DB_PATH=database/agent.db

# ── Agent Behaviour ────────────────────────────────────────────
ALLOW_AI_FALLBACK=true

# ── Bespoke Design Intelligence (Phase 5.5) ────────────────────
# Reasoning engine for from-scratch UI generation. Options: grok | claude | openai | gemini
REASONING_PROVIDER=grok

# ── Vision Engine (Phase 0) ────────────────────────────────────
# Provider + model used to parse uploaded screenshots into a layout/theme brief.
# OpenRouter "google/gemini-flash-latest" or Gemini native image models work best.
# Falls back automatically: VISION_PROVIDER → openrouter → grok (llama-vision).
VISION_PROVIDER=openrouter
VISION_MODEL=google/gemini-flash-latest
VISION_MODEL_IMAGE=gemini-2.5-flash

# ── Smart Context Injection / Patch Limits ─────────────────────
# How many project files the AST structure map scans, and how many files a
# single AI patch pass may touch. Lower = cheaper/faster; higher = better bespoke.
AI_MAX_CONTEXT_FILES=40
AI_MAX_PATCH_FILES=25
AI_STRUCTURE_CONTEXT_CHARS=12000

# ── VFS / Diff Patching (50+ file patches via ONE unified diff) ──
# Model returns a git-style unified diff; local Python applies it safely across
# many files in a single call (no per-file full-text swaps, no token blowup).
AI_DIFF_PATCHING=true

# ── Self-Correction Loop (isolated compiler → AI fix) ──────────
# On build/lint failure, the real terminal error output is fed back to the
# reasoning model as a unified-diff fix and the build is re-run until exit 0.
SELF_CORRECT_ENABLED=true
SELF_CORRECT_MAX_ROUNDS=3

# "??" Offline Public-Development Benchmark (real bug-fixing tasks) ??"
# Corpus root holding tasks.jsonl, snapshots/*.tgz, graphs/*.json,
# embeddings/, wheels/*.whl and HARNESS_README. Fully offline - nothing is
# downloaded at runtime. Verify with: python -m agent.benchmarks doctor
# BENCH_DATA_DIR=../benchmarks-data
BENCH_WORKSPACES_DIR=../generated-projects/.bench/workspaces
BENCH_REPORT_DIR=../generated-projects/bench-out
# Concurrent tasks (grading spawns pytest subprocesses; 4 is safe on most boxes)
BENCH_JOBS=1
# Per-task pytest timeout in seconds
BENCH_PYTEST_TIMEOUT_SECS=300
# Context budget handed to the solver per task
BENCH_MAX_CONTEXT_CHARS=24000
# Keep per-task checkouts on disk for debugging
BENCH_KEEP_WORKSPACES=false

# GitHub (Optional - repo creation, GitHub Pages deploy, marketplace publish)
# Classic PAT: https://github.com/settings/tokens/new  ->  scope "repo"
# Fine-grained PAT: Repository "Contents" (Read+Write) + "Workflows", Account "Email" (Read)
# Leave EMPTY for guide mode. Do NOT wrap the value in quotes (baked-in quotes
# surface as a false 401 "Bad credentials").
GITHUB_TOKEN=

# Vercel (Optional - real one-click deploys to vercel.app)
# 1. https://vercel.com/account/settings/tokens -> "Add" a token
# 2. Optional: VERCEL_ORG_ID / VERCEL_PROJECT_ID from the project's .vercel/
#    settings when deploying under a specific scope. Leave EMPTY for guide mode.
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Google PageSpeed Insights (Optional - removes anonymous rate limits for the
# free /api/web/audit + post-deploy live audit): https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=

# Optional agent power-ups (pip: headroom-ai, crawl4ai). The agent runs fine
# without them; set the flags to enable the compress/crawl paths.
# Headroom: compress injected context before LLM calls (20-60% fewer tokens,
# runs locally — nothing is uploaded anywhere).
HEADROOM_ENABLED=0
# Reference Intelligence crawler: Crawl4AI (Apache-2.0) turns live reference
# pages into clean LLM-ready markdown for Part 1b benchmarking. Set 0 to force
# the stdlib urllib fallback. Results are disk-cached for 7 days.
REFERENCE_CRAWLER=1