# LumicorePro AI Agent — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values
# NEVER commit .env with real API keys
# ============================================================

# ── Active AI Provider ─────────────────────────────────────────
# Options: nvidia | ninerouter | omniroute | gemini | deepseek | claude | anthropic
#        | openai | chatgpt | openrouter | grok | mistral | kimi | moonshot | openmuse
ACTIVE_AI_PROVIDER=gemini

# ── AI Provider API Keys ───────────────────────────────────────
# Set the key(s) you have. Others can be left blank — agent uses fallback chain.

# Google Gemini (free tier available) — https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Groq Cloud (OpenAI-compatible, gsk_ keys) — https://console.groq.com/keys
GROK_API_KEY=your_grok_api_key_here
GROK_MODEL=openai/gpt-oss-120b
# Groq vision model (llama-vision family) — fallback when OpenRouter/Gemini VISION is unavailable
GROQ_VISION_MODEL=meta-llama/llama-3.2-11b-vision-preview

# Anthropic Claude — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Mistral AI (cheap + multilingual) — https://console.mistral.ai/api-keys
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-large-latest

# DeepSeek (code-focused) — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat

# NVIDIA NIM free tier — https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=deepseek-ai/deepseek-v4.1-flash

# Kimi / Moonshot AI (open-weight K2 family, strong coder) — https://platform.kimi.ai
# Model ids: kimi-k2.7-code (default, coding) | kimi-k2.7-code-highspeed | kimi-k2.6 | kimi-k3
# Retired — do not use: kimi-latest, and the original kimi-k2* series.
# KIMI_BASE_URL may point at a self-hosted vLLM/SGLang build of the open K2
# weights (the compliant path when the hosted API's China-side processing is not).
KIMI_API_KEY=your_kimi_api_key_here
KIMI_MODEL=kimi-k2.7-code
KIMI_BASE_URL=https://api.moonshot.ai/v1

# OpenMuse — MIT-licensed, self-hosted personal agent (https://github.com/OpenMuseAgent/OpenMuse).
# It brings its own model, so this block points at any OpenAI-compatible endpoint:
# the OpenMuse gateway, Ollama :11434, vLLM/SGLang :8000, llama.cpp :8080, LM Studio :1234.
# No API key needed for local runtimes — fully offline / air-gapped capable.
# OPENMUSE_API_KEY=                       # only if your gateway requires auth
OPENMUSE_MODEL=qwen3-coder
OPENMUSE_BASE_URL=http://127.0.0.1:8080/v1

# OpenRouter (aggregator — access many models) — https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=deepseek/deepseek-chat

# ── OmniRoute AI Gateway (free, 350+ providers) ───────────────────
# One endpoint whose 'auto' model routes to the FASTEST available backend first
# and auto-fallbacks across 350+ providers (150+ free tiers). Keyless local
# install supported: npm i -g omniroute  →  run: omniroute  (boots on :20128).
# If the gateway is not running the agent auto-rotates to the native providers below.
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=auto
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1

# ── 9Router AI Gateway (free router + token saver) ─────────────────────
# Local gateway: npm i -g 9router  →  npm run router  (or: 9router, boots :20128).
# Dashboard http://localhost:20128 → Providers → connect a FREE provider
# (Kiro AI ~50 credits/mo, OpenCode Free no-auth) → API Keys → copy key below.
# Model id format: <provider-prefix>/<model>. RTK saves 20-40% on tool output.
NINEROUTER_API_KEY=
NINEROUTER_MODEL=kr/claude-sonnet-4.5
NINEROUTER_BASE_URL=http://127.0.0.1:20128/v1

# ── Server Security ────────────────────────────────────────────
# Optional: set this to require X-Api-Key header on all API calls
AGENT_API_KEY=

# Rate limiting (requests per window per IP)
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW=60

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ── Path Configuration ─────────────────────────────────────────
PROJECT_ROOT=..
GENERATED_PROJECTS_DIR=../generated-projects
REGISTRY_DIR=../registry
TEMPLATES_DIR=../src/templates
COMPONENTS_DIR=../src/components
BACKEND_LIBRARY_DIR=../backend-library
DATABASE_SCHEMAS_DIR=../database/schemas
AGENT_DB_PATH=database/agent.db

# ── Agent Behaviour ────────────────────────────────────────────
ALLOW_AI_FALLBACK=true

# ── Bespoke Design Intelligence (Phase 5.5) ────────────────────
# Reasoning engine for from-scratch UI generation. Options: grok | claude | openai | gemini
REASONING_PROVIDER=grok

# ── Vision Engine (Phase 0) ────────────────────────────────────
# Provider + model used to parse uploaded screenshots into a layout/theme brief.
# OpenRouter "google/gemini-flash-latest" or Gemini native image models work best.
# Falls back automatically: VISION_PROVIDER → openrouter → grok (llama-vision).
VISION_PROVIDER=openrouter
VISION_MODEL=google/gemini-flash-latest
VISION_MODEL_IMAGE=gemini-2.5-flash

# ── Smart Context Injection / Patch Limits ─────────────────────
# How many project files the AST structure map scans, and how many files a
# single AI patch pass may touch. Lower = cheaper/faster; higher = better bespoke.
AI_MAX_CONTEXT_FILES=40
AI_MAX_PATCH_FILES=25
AI_STRUCTURE_CONTEXT_CHARS=12000

# ── VFS / Diff Patching (50+ file patches via ONE unified diff) ──
# Model returns a git-style unified diff; local Python applies it safely across
# many files in a single call (no per-file full-text swaps, no token blowup).
AI_DIFF_PATCHING=true

# ── Self-Correction Loop (isolated compiler → AI fix) ──────────
# On build/lint failure, the real terminal error output is fed back to the
# reasoning model as a unified-diff fix and the build is re-run until exit 0.
SELF_CORRECT_ENABLED=true
SELF_CORRECT_MAX_ROUNDS=3

# "??" Offline Public-Development Benchmark (real bug-fixing tasks) ??"
# Corpus root holding tasks.jsonl, snapshots/*.tgz, graphs/*.json,
# embeddings/, wheels/*.whl and HARNESS_README. Fully offline - nothing is
# downloaded at runtime. Verify with: python -m agent.benchmarks doctor
# BENCH_DATA_DIR=../benchmarks-data
BENCH_WORKSPACES_DIR=../generated-projects/.bench/workspaces
BENCH_REPORT_DIR=../generated-projects/bench-out
# Concurrent tasks (grading spawns pytest subprocesses; 4 is safe on most boxes)
BENCH_JOBS=1
# Per-task pytest timeout in seconds
BENCH_PYTEST_TIMEOUT_SECS=300
# Context budget handed to the solver per task
BENCH_MAX_CONTEXT_CHARS=24000
# Keep per-task checkouts on disk for debugging
BENCH_KEEP_WORKSPACES=false
