{
  "name": "lumicorepro-core",
  "private": true,
  "version": "7.13.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:backend": "cd backend && npm run dev",
    "dev:full": "concurrently \"npm run dev\" \"npm run dev:backend\"",
    "dev:ai": "npm run agent:server",
    "build": "vite build",
    "build:backend": "cd backend && npm ci --production",
    "start": "cd backend && npm start",
    "lint": "eslint .",
    "format": "prettier --write src/",
    "size": "node scripts/check-bundle-budget.mjs",
    "check:budget": "node scripts/check-bundle-budget.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:backend": "cd backend && npm test",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "setup": "node scripts/setup.js",
    "test:api": "node scripts/test-api.js",
    "agent": "venv\\Scripts\\python.exe ai-agent/main.py",
    "agent:server": "venv\\Scripts\\python.exe ai-agent/server.py",
    "agent:test": "venv\\Scripts\\python.exe -m unittest discover -s ai-agent/tests",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:backend\" \"npm run dev:ai\"",
    "router": "npx -y 9router --skip-update -H 127.0.0.1 -p 20128",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@react-three/fiber": "^9.7.0",
    "@tanstack/react-query": "^5.62.10",
    "@webcontainer/api": "^1.6.4",
    "axios": "^1.19.0",
    "framer-motion": "^11.18.2",
    "i18next": "^25.0.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^16.0.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^2.15.1",
    "socket.io-client": "^4.8.1",
    "three": "^0.174.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.50.1",
    "@testing-library/dom": "^10.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^5.0.2",
    "autoprefixer": "^10.5.4",
    "concurrently": "^9.1.2",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-playwright": "^2.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "msw": "^2.7.0",
    "postcss": "^8.5.26",
    "prettier": "^3.5.3",
    "tailwindcss": "^3.4.19",
    "vite": "^8.2.0",
    "vitepress": "^1.6.3",
    "vitest": "^5.0.2"
  }
}
