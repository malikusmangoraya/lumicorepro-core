{
  "name": "lumicorepro-core",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:backend": "cd backend && npm run dev",
    "dev:full": "concurrently \"npm run dev\" \"npm run dev:backend\"",
    "build": "vite build",
    "build:backend": "cd backend && npm ci --production",
    "start": "cd backend && npm start",
    "lint": "eslint .",
    "format": "prettier --write src/",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:backend": "cd backend && npm test",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "setup": "node scripts/setup.js",
    "test:api": "node scripts/test-api.js",
    "agent": "venv\\Scripts\\python.exe ai-agent/main.py",
    "agent:server": "venv\\Scripts\\python.exe ai-agent/server.py",
    "agent:test": "venv\\Scripts\\python.exe -m unittest discover -s ai-agent/tests",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:backend\" \"npm run agent:server\""
  },
  "dependencies": {
    "@lottiefiles/react-lottie-player": "^3.6.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@stripe/stripe-js": "^5.4.0",
    "@tanstack/react-query": "^5.62.10",
    "@webcontainer/api": "^1.6.4",
    "axios": "^1.19.0",
    "concurrently": "^9.1.2",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "formik": "^2.4.6",
    "framer-motion": "^11.18.2",
    "gsap": "^3.15.0",
    "i18next": "^25.0.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "immer": "^10.1.1",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-countup": "^6.5.3",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.54.2",
    "react-i18next": "^16.0.0",
    "react-icons": "^5.5.0",
    "react-id-swiper": "^4.0.0",
    "react-intersection-observer": "^9.15.1",
    "react-loading-skeleton": "^3.5.0",
    "react-responsive": "^10.0.0",
    "react-router-dom": "^7.18.2",
    "react-select": "^5.10.0",
    "react-spring": "^9.7.5",
    "react-toastify": "^11.0.5",
    "recharts": "^2.15.1",
    "socket.io-client": "^4.8.1",
    "three": "^0.174.0",
    "use-sync-external-store": "^1.4.0",
    "yup": "^1.6.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.50.1",
    "@testing-library/dom": "^10.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-playwright": "^2.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "msw": "^2.7.0",
    "postcss": "^8.5.26",
    "prettier": "^3.5.3",
    "tailwindcss": "^3.4.19",
    "vite": "^8.2.0",
    "vitest": "^3.1.1"
  }
}
